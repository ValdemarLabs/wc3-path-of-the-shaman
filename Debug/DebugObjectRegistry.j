/**
    DebugObjectRegistry

    Author: Valdemar
    Version: 1.1

    Description:
    Generated object-name lookup tables for DebugCommands. Raw codes are
    sourced from the latest checked-in Path of the Shaman object exports.

    Credits:

    How to install:
    Import before DebugCommands. Regenerate when item/unit/ability object
    exports change.

    API:
    - set raw = DebugObjectRegistry_FindItem(query)
    - set raw = DebugObjectRegistry_FindUnit(query)
    - set raw = DebugObjectRegistry_FindAbility(query)
    - use Get*MatchIndex/Get*Code/Get*Name for lookup result display

**/
library DebugObjectRegistry initializer Init
    globals
        private integer DOR_ItemCount = 0
        private integer DOR_UnitCount = 0
        private integer DOR_AbilityCount = 0

        private integer array DOR_ItemCode
        private integer array DOR_UnitCode
        private integer array DOR_AbilityCode

        private string array DOR_ItemName
        private string array DOR_UnitName
        private string array DOR_AbilityName
        private string array DOR_ItemSearchName
        private string array DOR_UnitSearchName
        private string array DOR_AbilitySearchName
    endglobals

    private function DOR_Contains takes string source, string pattern returns boolean
        local integer sourceLength
        local integer patternLength
        local integer i = 0

        if source == null or pattern == null then
            return false
        endif

        set sourceLength = StringLength(source)
        set patternLength = StringLength(pattern)
        if patternLength <= 0 or sourceLength < patternLength then
            return false
        endif

        loop
            exitwhen i + patternLength > sourceLength
            if SubString(source, i, i + patternLength) == pattern then
                return true
            endif
            set i = i + 1
        endloop

        return false
    endfunction

    private function DOR_RegisterItem takes integer rawCode, string displayName returns nothing
        set DOR_ItemCount = DOR_ItemCount + 1
        set DOR_ItemCode[DOR_ItemCount] = rawCode
        set DOR_ItemName[DOR_ItemCount] = displayName
        set DOR_ItemSearchName[DOR_ItemCount] = StringCase(displayName, false)
    endfunction

    private function DOR_RegisterUnit takes integer rawCode, string displayName returns nothing
        set DOR_UnitCount = DOR_UnitCount + 1
        set DOR_UnitCode[DOR_UnitCount] = rawCode
        set DOR_UnitName[DOR_UnitCount] = displayName
        set DOR_UnitSearchName[DOR_UnitCount] = StringCase(displayName, false)
    endfunction

    private function DOR_RegisterAbility takes integer rawCode, string displayName returns nothing
        set DOR_AbilityCount = DOR_AbilityCount + 1
        set DOR_AbilityCode[DOR_AbilityCount] = rawCode
        set DOR_AbilityName[DOR_AbilityCount] = displayName
        set DOR_AbilitySearchName[DOR_AbilityCount] = StringCase(displayName, false)
    endfunction

    public function GetItemCount takes nothing returns integer
        return DOR_ItemCount
    endfunction

    public function GetUnitCount takes nothing returns integer
        return DOR_UnitCount
    endfunction

    public function GetAbilityCount takes nothing returns integer
        return DOR_AbilityCount
    endfunction

    public function GetItemCode takes integer index returns integer
        if index < 1 or index > DOR_ItemCount then
            return 0
        endif
        return DOR_ItemCode[index]
    endfunction

    public function GetItemName takes integer index returns string
        if index < 1 or index > DOR_ItemCount then
            return ""
        endif
        return DOR_ItemName[index]
    endfunction

    public function GetItemIndexByCode takes integer rawCode returns integer
        local integer i = 1

        if rawCode == 0 then
            return 0
        endif

        loop
            exitwhen i > DOR_ItemCount
            if DOR_ItemCode[i] == rawCode then
                return i
            endif
            set i = i + 1
        endloop

        return 0
    endfunction

    public function GetItemDisplayNameByCode takes integer rawCode returns string
        return GetItemName(GetItemIndexByCode(rawCode))
    endfunction

    public function GetItemMatchIndex takes string query, integer matchNumber returns integer
        local string searchText = StringCase(query, false)
        local integer i = 1
        local integer matched = 0

        if searchText == null or searchText == "" or matchNumber <= 0 then
            return 0
        endif

        loop
            exitwhen i > DOR_ItemCount
            if DOR_ItemSearchName[i] == searchText then
                set matched = matched + 1
                if matched == matchNumber then
                    return i
                endif
            endif
            set i = i + 1
        endloop

        set i = 1
        loop
            exitwhen i > DOR_ItemCount
            if DOR_ItemSearchName[i] != searchText and DOR_Contains(DOR_ItemSearchName[i], searchText) then
                set matched = matched + 1
                if matched == matchNumber then
                    return i
                endif
            endif
            set i = i + 1
        endloop

        return 0
    endfunction

    public function GetItemMatchCount takes string query returns integer
        local integer count = 0
        loop
            exitwhen GetItemMatchIndex(query, count + 1) == 0
            set count = count + 1
        endloop
        return count
    endfunction

    public function FindItem takes string query returns integer
        return GetItemCode(GetItemMatchIndex(query, 1))
    endfunction

    public function GetUnitCode takes integer index returns integer
        if index < 1 or index > DOR_UnitCount then
            return 0
        endif
        return DOR_UnitCode[index]
    endfunction

    public function GetUnitName takes integer index returns string
        if index < 1 or index > DOR_UnitCount then
            return ""
        endif
        return DOR_UnitName[index]
    endfunction

    public function GetUnitIndexByCode takes integer rawCode returns integer
        local integer i = 1

        if rawCode == 0 then
            return 0
        endif

        loop
            exitwhen i > DOR_UnitCount
            if DOR_UnitCode[i] == rawCode then
                return i
            endif
            set i = i + 1
        endloop

        return 0
    endfunction

    public function GetUnitDisplayNameByCode takes integer rawCode returns string
        return GetUnitName(GetUnitIndexByCode(rawCode))
    endfunction

    public function GetUnitMatchIndex takes string query, integer matchNumber returns integer
        local string searchText = StringCase(query, false)
        local integer i = 1
        local integer matched = 0

        if searchText == null or searchText == "" or matchNumber <= 0 then
            return 0
        endif

        loop
            exitwhen i > DOR_UnitCount
            if DOR_UnitSearchName[i] == searchText then
                set matched = matched + 1
                if matched == matchNumber then
                    return i
                endif
            endif
            set i = i + 1
        endloop

        set i = 1
        loop
            exitwhen i > DOR_UnitCount
            if DOR_UnitSearchName[i] != searchText and DOR_Contains(DOR_UnitSearchName[i], searchText) then
                set matched = matched + 1
                if matched == matchNumber then
                    return i
                endif
            endif
            set i = i + 1
        endloop

        return 0
    endfunction

    public function GetUnitMatchCount takes string query returns integer
        local integer count = 0
        loop
            exitwhen GetUnitMatchIndex(query, count + 1) == 0
            set count = count + 1
        endloop
        return count
    endfunction

    public function FindUnit takes string query returns integer
        return GetUnitCode(GetUnitMatchIndex(query, 1))
    endfunction

    public function GetAbilityCode takes integer index returns integer
        if index < 1 or index > DOR_AbilityCount then
            return 0
        endif
        return DOR_AbilityCode[index]
    endfunction

    public function GetAbilityName takes integer index returns string
        if index < 1 or index > DOR_AbilityCount then
            return ""
        endif
        return DOR_AbilityName[index]
    endfunction

    public function GetAbilityIndexByCode takes integer rawCode returns integer
        local integer i = 1

        if rawCode == 0 then
            return 0
        endif

        loop
            exitwhen i > DOR_AbilityCount
            if DOR_AbilityCode[i] == rawCode then
                return i
            endif
            set i = i + 1
        endloop

        return 0
    endfunction

    public function GetAbilityDisplayNameByCode takes integer rawCode returns string
        return GetAbilityName(GetAbilityIndexByCode(rawCode))
    endfunction

    public function GetAbilityMatchIndex takes string query, integer matchNumber returns integer
        local string searchText = StringCase(query, false)
        local integer i = 1
        local integer matched = 0

        if searchText == null or searchText == "" or matchNumber <= 0 then
            return 0
        endif

        loop
            exitwhen i > DOR_AbilityCount
            if DOR_AbilitySearchName[i] == searchText then
                set matched = matched + 1
                if matched == matchNumber then
                    return i
                endif
            endif
            set i = i + 1
        endloop

        set i = 1
        loop
            exitwhen i > DOR_AbilityCount
            if DOR_AbilitySearchName[i] != searchText and DOR_Contains(DOR_AbilitySearchName[i], searchText) then
                set matched = matched + 1
                if matched == matchNumber then
                    return i
                endif
            endif
            set i = i + 1
        endloop

        return 0
    endfunction

    public function GetAbilityMatchCount takes string query returns integer
        local integer count = 0
        loop
            exitwhen GetAbilityMatchIndex(query, count + 1) == 0
            set count = count + 1
        endloop
        return count
    endfunction

    public function FindAbility takes string query returns integer
        return GetAbilityCode(GetAbilityMatchIndex(query, 1))
    endfunction

