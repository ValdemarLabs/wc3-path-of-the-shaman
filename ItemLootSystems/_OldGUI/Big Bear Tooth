Big Bear Tooth
    Events
        Unit - A unit Dies
    Conditions
        Or - Any (Conditions) are true
            Conditions
                (Unit-type of (Dying unit)) Equal to Mother Bear
                (Unit-type of (Dying unit)) Equal to Ferocious Bear
                (Unit-type of (Dying unit)) Equal to Bear
    Actions
        If (All Conditions are True) then do (Then Actions) else do (Else Actions)
            If - Conditions
                (Unit-type of (Dying unit)) Equal to Mother Bear
            Then - Actions
                Set VariableSet DyingUnitPos = (Position of (Dying unit))
                Item - Create Big Bear Tooth at DyingUnitPos
                Custom script:   call RemoveLocation(udg_DyingUnitPos)
            Else - Actions
        If (All Conditions are True) then do (Then Actions) else do (Else Actions)
            If - Conditions
                (Unit-type of (Dying unit)) Equal to Ferocious Bear
            Then - Actions
                Set VariableSet Random = (Random integer number between 1 and 2)
                If (All Conditions are True) then do (Then Actions) else do (Else Actions)
                    If - Conditions
                        Random Equal to 1
                    Then - Actions
                        Set VariableSet DyingUnitPos = (Position of (Dying unit))
                        Item - Create Big Bear Tooth at DyingUnitPos
                        Custom script:   call RemoveLocation(udg_DyingUnitPos)
                    Else - Actions
                Set VariableSet Random = 0
            Else - Actions
        If (All Conditions are True) then do (Then Actions) else do (Else Actions)
            If - Conditions
                (Unit-type of (Dying unit)) Equal to Bear
            Then - Actions
                Set VariableSet Random = (Random integer number between 1 and 5)
                If (All Conditions are True) then do (Then Actions) else do (Else Actions)
                    If - Conditions
                        Random Equal to 1
                    Then - Actions
                        Set VariableSet DyingUnitPos = (Position of (Dying unit))
                        Item - Create Big Bear Tooth at DyingUnitPos
                        Custom script:   call RemoveLocation(udg_DyingUnitPos)
                    Else - Actions
                Set VariableSet Random = 0
            Else - Actions
