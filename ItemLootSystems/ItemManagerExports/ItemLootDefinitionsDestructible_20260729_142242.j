        call RegisterDestructibleDropEx('LTcr', 'vamp', 10000, false, 100, 1, 1)  // Unknown Item (vamp)
        call RegisterDestructibleDropEx('LTcr', 'wneg', 10000, false, 100, 1, 1)  // Unknown Item (wneg)
        call RegisterDestructibleDropEx('LTcr', 'rej6', 10000, false, 100, 1, 1)  // Greater Scroll of Replenishment (old)
        call RegisterDestructibleDropEx('LTcr', 'I608', 10000, false, 100, 1, 1)  // Tome of God
        call RegisterDestructibleDropEx('LTcr', 'I60A', 10000, false, 100, 1, 1)  // Tome of Eternal Agility
        call RegisterDestructibleDropEx('LTcr', 'I60B', 10000, false, 100, 1, 1)  // Tome of Eternal Intelligence
        call RegisterDestructibleDropEx('LTcr', 'I611', 10000, false, 100, 1, 1)  // Camp Fire
        call RegisterDestructibleDropEx('LTcr', 'I624', 10000, false, 100, 1, 1)  // Jin'Zun Healing Ward
        call RegisterDestructibleDropEx('LTcr', 'I6C3', 10000, false, 100, 1, 1)  // Water Shield
        call RegisterDestructibleDropEx('LTcr', 'I00N', 10000, false, 100, 1, 1)  // Gutcleanser Elixir
        call RegisterDestructibleDropEx('LTcr', 'I6A3', 10000, false, 100, 1, 1)  // I6A3
        call RegisterDestructibleDropEx('LTcr', 'I6AO', 10000, false, 100, 1, 1)  // I6AO
