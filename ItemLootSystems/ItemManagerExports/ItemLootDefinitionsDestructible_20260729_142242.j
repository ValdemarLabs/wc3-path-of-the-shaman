    endfunction

    private function Init takes nothing returns nothing
        // Destructible drop registration delayed to allow ItemLootDestructibles to initialize
        call TimerStart(CreateTimer(), 0.03, false, function RegisterAllDestructibleDrops)
    endfunction

endlibrary
