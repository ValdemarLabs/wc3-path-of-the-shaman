Shield Block 75 Use Loop
    Events
        Time - Every 1.00 seconds of game time
    Conditions
    Actions
        For each (Integer Shieldblock_loop75_integer) from 1 to Shieldblock_index75, do (Actions)
            Loop - Actions
                Set VariableSet Shieldblock_counter75[Shieldblock_loop75_integer] = (Shieldblock_counter75[Shieldblock_loop75_integer] + 1)
                If (All Conditions are True) then do (Then Actions) else do (Else Actions)
                    If - Conditions
                        Shieldblock_counter75[Shieldblock_loop75_integer] Greater than or equal to 5
                    Then - Actions
                        Set VariableSet Temp_Integer = (Custom value of Shieldblock_unit75[Shieldblock_loop75_integer])
                        Set VariableSet Stats_Block[Temp_Integer] = (Stats_Block[Temp_Integer] - 75)
                        Set VariableSet Shieldblock_unit75[Shieldblock_loop75_integer] = Shieldblock_unit75[Shieldblock_index75]
                        Set VariableSet Shieldblock_counter75[Shieldblock_loop75_integer] = Shieldblock_counter75[Shieldblock_index75]
                        Set VariableSet Shieldblock_index75 = (Shieldblock_index75 - 1)
                        Set VariableSet Shieldblock_loop75_integer = (Shieldblock_loop75_integer - 1)
                        If (All Conditions are True) then do (Then Actions) else do (Else Actions)
                            If - Conditions
                                Shieldblock_index75 Equal to 0
                            Then - Actions
                                Trigger - Turn off (This trigger)
                            Else - Actions
                    Else - Actions
