Shield Block 100 Use Loop
    Events
        Time - Every 1.00 seconds of game time
    Conditions
    Actions
        For each (Integer Shieldblock_loop100_integer) from 1 to Shieldblock_index100, do (Actions)
            Loop - Actions
                Set VariableSet Shieldblock_counter100[Shieldblock_loop100_integer] = (Shieldblock_counter100[Shieldblock_loop100_integer] + 1)
                If (All Conditions are True) then do (Then Actions) else do (Else Actions)
                    If - Conditions
                        Shieldblock_counter100[Shieldblock_loop100_integer] Greater than or equal to 5
                    Then - Actions
                        Set VariableSet Temp_Integer = (Custom value of Shieldblock_unit100[Shieldblock_loop100_integer])
                        Set VariableSet Stats_Block[Temp_Integer] = (Stats_Block[Temp_Integer] - 100)
                        Set VariableSet Shieldblock_unit100[Shieldblock_loop100_integer] = Shieldblock_unit100[Shieldblock_index100]
                        Set VariableSet Shieldblock_counter100[Shieldblock_loop100_integer] = Shieldblock_counter100[Shieldblock_index100]
                        Set VariableSet Shieldblock_index100 = (Shieldblock_index100 - 1)
                        Set VariableSet Shieldblock_loop100_integer = (Shieldblock_loop100_integer - 1)
                        If (All Conditions are True) then do (Then Actions) else do (Else Actions)
                            If - Conditions
                                Shieldblock_index100 Equal to 0
                            Then - Actions
                                Trigger - Turn off (This trigger)
                            Else - Actions
                    Else - Actions
