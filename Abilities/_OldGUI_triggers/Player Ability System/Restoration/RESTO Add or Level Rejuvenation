RESTO Add or Level Rejuvenation
    Events
        Unit - A unit Acquires an item
    Conditions
        (Item-type of (Item being manipulated)) Equal to Rejuvenation
    Actions
        -------- This is like the slow one, but it would increase the level of shockwave when you already have it --------
        If (All Conditions are True) then do (Then Actions) else do (Else Actions)
            If - Conditions
                (Level of RESTORATION_Rejuvenation  for (Triggering unit)) Equal to 0
            Then - Actions
                If (All Conditions are True) then do (Then Actions) else do (Else Actions)
                    If - Conditions
                        Or - Any (Conditions) are true
                            Conditions
                                And - All (Conditions) are true
                                    Conditions
                                        AbilityPointsNazgrek Greater than or equal to 1
                                        (Triggering unit) Equal to Nazgrek
                                And - All (Conditions) are true
                                    Conditions
                                        AbilityPointsZulkis Greater than or equal to 1
                                        (Triggering unit) Equal to Zulkis
                    Then - Actions
                        Game - Display to (All players) the text: (New ability learned:  + (Name of (Item being manipulated)))
                        Unit - Add RESTORATION_RejuvenationDummy  to (Triggering unit)
                        -------- Make ability permanent --------
                        Custom script:   call UnitMakeAbilityPermanent(GetTriggerUnit(), true, 'A69W')
                        Custom script:   call UnitMakeAbilityPermanent(GetTriggerUnit(), true, 'A69X')
                        Sound - Play NewAbility <gen>
                        If (All Conditions are True) then do (Then Actions) else do (Else Actions)
                            If - Conditions
                                (Triggering unit) Equal to Nazgrek
                            Then - Actions
                                Set VariableSet AbilityPointsNazgrek = (AbilityPointsNazgrek - 1)
                                Trigger - Run MultiboardUpdateAbilityPoints <gen> (checking conditions)
                            Else - Actions
                        If (All Conditions are True) then do (Then Actions) else do (Else Actions)
                            If - Conditions
                                (Triggering unit) Equal to Zulkis
                            Then - Actions
                                Set VariableSet AbilityPointsZulkis = (AbilityPointsZulkis - 1)
                                Trigger - Run MultiboardUpdateAbilityPoints <gen> (checking conditions)
                            Else - Actions
                    Else - Actions
                        Game - Display to (All players) the text: ((Proper name of (Triggering unit)) +  does not have enough ability points!)
                        Sound - Play Error <gen>
            Else - Actions
                -------- Not using Increase level of ability --------
                -------- Because it seems to be able to go beyond the limit --------
                If (All Conditions are True) then do (Then Actions) else do (Else Actions)
                    If - Conditions
                        Or - Any (Conditions) are true
                            Conditions
                                And - All (Conditions) are true
                                    Conditions
                                        AbilityPointsNazgrek Greater than or equal to 1
                                        (Triggering unit) Equal to Nazgrek
                                And - All (Conditions) are true
                                    Conditions
                                        AbilityPointsZulkis Greater than or equal to 1
                                        (Triggering unit) Equal to Zulkis
                    Then - Actions
                        If (All Conditions are True) then do (Then Actions) else do (Else Actions)
                            If - Conditions
                                (Level of RESTORATION_Rejuvenation  for (Triggering unit)) Less than 5
                            Then - Actions
                                Unit - Set level of RESTORATION_Rejuvenation  for (Triggering unit) to ((Level of RESTORATION_Rejuvenation  for (Triggering unit)) + 1)
                                Game - Display to (All players) the text: (Learned:  + ((Name of (Item being manipulated)) + ( Level  + (String((Level of RESTORATION_Rejuvenation  for (Triggering unit)))))))
                                If (All Conditions are True) then do (Then Actions) else do (Else Actions)
                                    If - Conditions
                                        (Triggering unit) Equal to Nazgrek
                                    Then - Actions
                                        Set VariableSet AbilityPointsNazgrek = (AbilityPointsNazgrek - 1)
                                        Trigger - Run MultiboardUpdateAbilityPoints <gen> (checking conditions)
                                    Else - Actions
                                If (All Conditions are True) then do (Then Actions) else do (Else Actions)
                                    If - Conditions
                                        (Triggering unit) Equal to Zulkis
                                    Then - Actions
                                        Set VariableSet AbilityPointsZulkis = (AbilityPointsZulkis - 1)
                                        Trigger - Run MultiboardUpdateAbilityPoints <gen> (checking conditions)
                                    Else - Actions
                            Else - Actions
                                -------- If unit already has ability maxed out, no ability points are reduced --------
                                Game - Display to (All players) the text: ((Name of (Item being manipulated)) +  |cFFFFCC00 Max level reached|r)
                                Sound - Play Error <gen>
                    Else - Actions
                        Game - Display to (All players) the text: ((Proper name of (Triggering unit)) +  does not have enough ability points!)
                        Sound - Play Error <gen>
