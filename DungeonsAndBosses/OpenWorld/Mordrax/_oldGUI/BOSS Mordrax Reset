        Custom script:   call DisableTrigger(gg_trg_BOSS_Mordrax_Fire_Orbs)
        Custom script:   call EnableTrigger(gg_trg_BOSS_Mordrax_Start_Attacked)
        Custom script:   call EnableTrigger(gg_trg_BOSS_Mordrax_Start_Attacking)
