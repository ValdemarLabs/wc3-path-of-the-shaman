/**
    AI_Aveline

    Author: Valdemar
    Version:

    Description:
    Unique Riverbane Warrior profile for Aveline. This profile reuses the
    shared Warrior ability setup while keeping Aveline's identity, owner,
    caps, barks, random spawning, and legacy `udg_Aveline` mapping separate
    from Horde Warrior instances.

    Credits:
    - PotS AI JASS migration

    How to install:
    Requires `AI.j`, `AI_Warrior.j`, and `ResourceRage.j`. The generated map
    globals must include `udg_Aveline`.

    API:
    call AIAveline_Register(unit whichUnit)
    call AIAveline_SpawnAt(x, y, facing)

**/
library AIAveline initializer Init requires AI, AIWarrior, ResourceRage, VoicelinesAveline

globals
    constant integer AI_AVELINE_UNIT_RIVERBANE = 'O009'
    constant integer AI_AVELINE_UNIQUE_ID = 'AVLN'
    integer AI_Aveline_ProfileId = 0
endglobals

private function RegisterBarks takes nothing returns nothing
    call AI_RegisterBarkLine(AI_Aveline_ProfileId, AI_BARK_GREET, VL_AVELINE_AVELINE_GREET1_TEXT, VL_AVELINE_AVELINE_GREET1_KEY)
    call AI_RegisterBarkLine(AI_Aveline_ProfileId, AI_BARK_GREET, VL_AVELINE_AVELINE_GREET2_TEXT, VL_AVELINE_AVELINE_GREET2_KEY)
    call AI_RegisterBarkLine(AI_Aveline_ProfileId, AI_BARK_GREET, VL_AVELINE_AVELINE_GREET3_TEXT, VL_AVELINE_AVELINE_GREET3_KEY)
    call AI_RegisterBarkLine(AI_Aveline_ProfileId, AI_BARK_GREET, VL_AVELINE_AVELINE_GREET4_TEXT, VL_AVELINE_AVELINE_GREET4_KEY)
    call AI_RegisterBarkLine(AI_Aveline_ProfileId, AI_BARK_FAREWELL, VL_AVELINE_AVELINE_FAREWELL1_TEXT, VL_AVELINE_AVELINE_FAREWELL1_KEY)
    call AI_RegisterBarkLine(AI_Aveline_ProfileId, AI_BARK_FAREWELL, VL_AVELINE_AVELINE_FAREWELL2_TEXT, VL_AVELINE_AVELINE_FAREWELL2_KEY)
    call AI_RegisterBarkLine(AI_Aveline_ProfileId, AI_BARK_FAREWELL, VL_AVELINE_AVELINE_FAREWELL3_TEXT, VL_AVELINE_AVELINE_FAREWELL3_KEY)
    call AI_RegisterBarkLine(AI_Aveline_ProfileId, AI_BARK_PASSIVE, VL_AVELINE_AVELINE_PASSIVE1_TEXT, VL_AVELINE_AVELINE_PASSIVE1_KEY)
    call AI_RegisterBarkLine(AI_Aveline_ProfileId, AI_BARK_PASSIVE, VL_AVELINE_AVELINE_PASSIVE2_TEXT, VL_AVELINE_AVELINE_PASSIVE2_KEY)
    call AI_RegisterBarkLine(AI_Aveline_ProfileId, AI_BARK_PASSIVE, VL_AVELINE_AVELINE_PASSIVE3_TEXT, VL_AVELINE_AVELINE_PASSIVE3_KEY)
    call AI_RegisterBarkLine(AI_Aveline_ProfileId, AI_BARK_NORMAL, VL_AVELINE_AVELINE_NORMAL1_TEXT, VL_AVELINE_AVELINE_NORMAL1_KEY)
    call AI_RegisterBarkLine(AI_Aveline_ProfileId, AI_BARK_NORMAL, VL_AVELINE_AVELINE_NORMAL2_TEXT, VL_AVELINE_AVELINE_NORMAL2_KEY)
    call AI_RegisterBarkLine(AI_Aveline_ProfileId, AI_BARK_NORMAL, VL_AVELINE_AVELINE_NORMAL3_TEXT, VL_AVELINE_AVELINE_NORMAL3_KEY)
    call AI_RegisterBarkLine(AI_Aveline_ProfileId, AI_BARK_AGGRESSIVE, VL_AVELINE_AVELINE_AGGRESSIVE1_TEXT, VL_AVELINE_AVELINE_AGGRESSIVE1_KEY)
    call AI_RegisterBarkLine(AI_Aveline_ProfileId, AI_BARK_AGGRESSIVE, VL_AVELINE_AVELINE_AGGRESSIVE2_TEXT, VL_AVELINE_AVELINE_AGGRESSIVE2_KEY)
    call AI_RegisterBarkLine(AI_Aveline_ProfileId, AI_BARK_AGGRESSIVE, VL_AVELINE_AVELINE_AGGRESSIVE3_TEXT, VL_AVELINE_AVELINE_AGGRESSIVE3_KEY)
    call AI_RegisterBarkLine(AI_Aveline_ProfileId, AI_BARK_HOLD, VL_AVELINE_AVELINE_HOLDPOSITIONS1_TEXT, VL_AVELINE_AVELINE_HOLDPOSITIONS1_KEY)
    call AI_RegisterBarkLine(AI_Aveline_ProfileId, AI_BARK_HOLD, VL_AVELINE_AVELINE_HOLDPOSITIONS2_TEXT, VL_AVELINE_AVELINE_HOLDPOSITIONS2_KEY)
    call AI_RegisterBarkLine(AI_Aveline_ProfileId, AI_BARK_HOLD, VL_AVELINE_AVELINE_HOLDPOSITIONS3_TEXT, VL_AVELINE_AVELINE_HOLDPOSITIONS3_KEY)
    call AI_RegisterBarkLine(AI_Aveline_ProfileId, AI_BARK_DROP_ITEMS, VL_AVELINE_AVELINE_DROPITEMS1_TEXT, VL_AVELINE_AVELINE_DROPITEMS1_KEY)
