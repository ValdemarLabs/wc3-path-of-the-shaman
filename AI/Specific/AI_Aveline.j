    call AI_RegisterBarkLine(AI_Aveline_ProfileId, AI_BARK_MOVING, VL_AVELINE_AVELINE_MOVING1_TEXT, VL_AVELINE_AVELINE_MOVING1_KEY)
    call AI_RegisterBarkLine(AI_Aveline_ProfileId, AI_BARK_MOVING, VL_AVELINE_AVELINE_MOVING2_TEXT, VL_AVELINE_AVELINE_MOVING2_KEY)
    call AI_RegisterBarkLine(AI_Aveline_ProfileId, AI_BARK_MOVING, VL_AVELINE_AVELINE_MOVING3_TEXT, VL_AVELINE_AVELINE_MOVING3_KEY)
    call AI_RegisterBarkLine(AI_Aveline_ProfileId, AI_BARK_MOVING, VL_AVELINE_AVELINE_MOVING4_TEXT, VL_AVELINE_AVELINE_MOVING4_KEY)
    call AI_RegisterBarkLine(AI_Aveline_ProfileId, AI_BARK_CASTING, VL_AVELINE_AVELINE_CASTING1_TEXT, VL_AVELINE_AVELINE_CASTING1_KEY)
    call AI_RegisterBarkLine(AI_Aveline_ProfileId, AI_BARK_CASTING, VL_AVELINE_AVELINE_CASTING2_TEXT, VL_AVELINE_AVELINE_CASTING2_KEY)
    call AI_RegisterBarkLine(AI_Aveline_ProfileId, AI_BARK_CASTING, VL_AVELINE_AVELINE_CASTING3_TEXT, VL_AVELINE_AVELINE_CASTING3_KEY)
    call AI_RegisterBarkLine(AI_Aveline_ProfileId, AI_BARK_ATTACKING, VL_AVELINE_AVELINE_ATTACK1_TEXT, VL_AVELINE_AVELINE_ATTACK1_KEY)
    call AI_RegisterBarkLine(AI_Aveline_ProfileId, AI_BARK_ATTACKING, VL_AVELINE_AVELINE_ATTACK2_TEXT, VL_AVELINE_AVELINE_ATTACK2_KEY)
    call AI_RegisterBarkLine(AI_Aveline_ProfileId, AI_BARK_ATTACKING, VL_AVELINE_AVELINE_ATTACK3_TEXT, VL_AVELINE_AVELINE_ATTACK3_KEY)
    call AI_RegisterBarkLine(AI_Aveline_ProfileId, AI_BARK_KILLING, VL_AVELINE_AVELINE_UNITDIES1_TEXT, VL_AVELINE_AVELINE_UNITDIES1_KEY)
    call AI_RegisterBarkLine(AI_Aveline_ProfileId, AI_BARK_KILLING, VL_AVELINE_AVELINE_UNITDIES2_TEXT, VL_AVELINE_AVELINE_UNITDIES2_KEY)
    call AI_RegisterBarkLine(AI_Aveline_ProfileId, AI_BARK_KILLING, VL_AVELINE_AVELINE_UNITDIES3_TEXT, VL_AVELINE_AVELINE_UNITDIES3_KEY)
    call AI_RegisterBarkLine(AI_Aveline_ProfileId, AI_BARK_KICKED, VL_AVELINE_AVELINE_KICKED1_TEXT, VL_AVELINE_AVELINE_KICKED1_KEY)
    call AI_RegisterBarkLine(AI_Aveline_ProfileId, AI_BARK_KICKED, VL_AVELINE_AVELINE_KICKED2_TEXT, VL_AVELINE_AVELINE_KICKED2_KEY)
    call AI_RegisterBarkLine(AI_Aveline_ProfileId, AI_BARK_KICKED, VL_AVELINE_AVELINE_KICKED3_TEXT, VL_AVELINE_AVELINE_KICKED3_KEY)
    call AI_RegisterBarkLine(AI_Aveline_ProfileId, AI_BARK_COMPANION_DIES, VL_AVELINE_AVELINE_COMPANIONDIES1_TEXT, VL_AVELINE_AVELINE_COMPANIONDIES1_KEY)
    call AI_RegisterBarkLine(AI_Aveline_ProfileId, AI_BARK_COMPANION_DIES, VL_AVELINE_AVELINE_COMPANIONDIES2_TEXT, VL_AVELINE_AVELINE_COMPANIONDIES2_KEY)
    call AI_RegisterBarkLine(AI_Aveline_ProfileId, AI_BARK_COMPANION_DIES, VL_AVELINE_AVELINE_COMPANIONDIES3_TEXT, VL_AVELINE_AVELINE_COMPANIONDIES3_KEY)
    call AI_RegisterBarkLine(AI_Aveline_ProfileId, AI_BARK_ITEM_GIVEN, VL_AVELINE_AVELINE_GIVEITEM1_TEXT, VL_AVELINE_AVELINE_GIVEITEM1_KEY)
    call AI_RegisterBarkLine(AI_Aveline_ProfileId, AI_BARK_ITEM_GIVEN, VL_AVELINE_AVELINE_GIVEITEM2_TEXT, VL_AVELINE_AVELINE_GIVEITEM2_KEY)
    call AI_RegisterBarkLine(AI_Aveline_ProfileId, AI_BARK_ITEM_GIVEN, VL_AVELINE_AVELINE_GIVEITEM3_TEXT, VL_AVELINE_AVELINE_GIVEITEM3_KEY)
endfunction

private function RegisterChat takes string soundKey, string text returns nothing
    call AI_RegisterBarkLine(AI_Aveline_ProfileId, AI_BARK_IDLE, text, soundKey)
    call AI_RegisterBarkLine(AI_Aveline_ProfileId, AI_BARK_MOVING, text, soundKey)
endfunction

private function RegisterReply takes string primarySoundKey, string text returns nothing
    call AI_RegisterBarkReply(primarySoundKey, AI_Aveline_ProfileId, text, primarySoundKey + VL_AVELINE_REPLY_SUFFIX)
endfunction

