Horde NPC Ability Item Usage Shredder
    Events
    Conditions
    Actions
        -------- =================================== --------
        Set VariableSet NPC_VarPoint = (Position of NPC_Neutral_Engineer)
        Set VariableSet NPC_VarUnitGroup = (Units within 600.00 of NPC_VarPoint matching ((((Matching unit) is alive) Equal to True) and (((Matching unit) belongs to an enemy of (Owner of NPC_Neutral_Engineer).) Equal to True)).)
        -------- =================================== --------
        Set VariableSet Closest_Unit = No unit
        Set VariableSet Closest_ClosestDistance = 600.00
        Set VariableSet Closest_Group = (Units in (Playable map area) matching (((Matching unit) belongs to an enemy of (Owner of NPC_Neutral_Engineer).) Equal to True))
        Unit Group - Pick every unit in Closest_Group and do (Actions)
            Loop - Actions
                Set VariableSet Closest_Point = (Position of (Picked unit))
                Set VariableSet Closest_CurrentDistance = (Distance between NPC_VarPoint and Closest_Point)
                If (All Conditions are True) then do (Then Actions) else do (Else Actions)
                    If - Conditions
                        Closest_CurrentDistance Less than Closest_ClosestDistance
                    Then - Actions
                        Set VariableSet Closest_Unit = (Picked unit)
                        Set VariableSet Closest_ClosestDistance = Closest_CurrentDistance
                    Else - Actions
                Custom script:   call RemoveLocation(udg_Closest_Point)
        -------- =================================== --------
        If (All Conditions are True) then do (Then Actions) else do (Else Actions)
            If - Conditions
                Or - Any (Conditions) are true
                    Conditions
                        (Item-class of (Item carried by NPC_Neutral_Engineer in slot 1)) Equal to Charged
                        (Item-class of (Item carried by NPC_Neutral_Engineer in slot 2)) Equal to Charged
                        (Item-class of (Item carried by NPC_Neutral_Engineer in slot 3)) Equal to Charged
                        (Item-class of (Item carried by NPC_Neutral_Engineer in slot 4)) Equal to Charged
                        (Item-class of (Item carried by NPC_Neutral_Engineer in slot 5)) Equal to Charged
                        (Item-class of (Item carried by NPC_Neutral_Engineer in slot 6)) Equal to Charged
                Or - Any (Conditions) are true
                    Conditions
                        (Percentage life of NPC_Neutral_Engineer) Less than or equal to 50.00
                        (Percentage mana of NPC_Neutral_Engineer) Less than or equal to 50.00
            Then - Actions
                -------- =================================== --------
                -------- If Hero Has any consumables, USE them (NOW: Try to use any ITEM, could be modfied to consern only Charges and Purchable) --------
                Hero - Order NPC_Neutral_Engineer to use (Item carried by NPC_Neutral_Engineer of type (Random level -1.Any Class item-type))
                -------- =================================== --------
            Else - Actions
        If (All Conditions are True) then do (Then Actions) else do (Else Actions)
            If - Conditions
                (Number of units in NPC_VarUnitGroup) Greater than 0
            Then - Actions
                Unit - Set level of HeroEngineerShredder_Shred  for NPC_Neutral_Engineer to (Level of HeroEngineer_Shredder  for NPC_Neutral_Engineer)
                Unit - Set level of HeroEngineerShredder_Slam  for NPC_Neutral_Engineer to (Level of HeroEngineer_Shredder  for NPC_Neutral_Engineer)
                Unit - Set level of HeroEngineerShredder_ClusterRockets  for NPC_Neutral_Engineer to (Level of HeroEngineer_Shredder  for NPC_Neutral_Engineer)
                If (All Conditions are True) then do (Then Actions) else do (Else Actions)
                    If - Conditions
                        (Remaining time for NPC_Neutral_Engineer_Casting) Equal to 0.00
                        (Random integer number between 1 and 2) Equal to 1
                    Then - Actions
                        -------- =================================== --------
                        -------- Shred --------
                        Unit - Order NPC_Neutral_Engineer to Human Mountain King - Storm Bolt Closest_Unit
                        Countdown Timer - Start NPC_Neutral_Engineer_Casting as a One-shot timer that will expire in 2.00 seconds
                        -------- =================================== --------
                    Else - Actions
                If (All Conditions are True) then do (Then Actions) else do (Else Actions)
                    If - Conditions
                        (Remaining time for NPC_Neutral_Engineer_Casting) Equal to 0.00
                    Then - Actions
                        -------- =================================== --------
                        -------- Charge --------
                        Unit - Order NPC_Horde_AI_Warrior to Undead Destroyer - Absorb Mana (Random unit from NPC_VarUnitGroup)
                        Countdown Timer - Start NPC_Neutral_Engineer_Casting as a One-shot timer that will expire in 2.00 seconds
                        -------- =================================== --------
                    Else - Actions
                If (All Conditions are True) then do (Then Actions) else do (Else Actions)
                    If - Conditions
                        (Remaining time for NPC_Neutral_Engineer_Casting) Equal to 0.00
                    Then - Actions
                        -------- =================================== --------
                        -------- Slam --------
                        -------- -- waterelemental 852097 --------
                        Custom script:   call IssueImmediateOrderById(udg_NPC_Neutral_Engineer, 852097)
                        Countdown Timer - Start NPC_Neutral_Engineer_Casting as a One-shot timer that will expire in 2.00 seconds
                        -------- =================================== --------
                    Else - Actions
                If (All Conditions are True) then do (Then Actions) else do (Else Actions)
                    If - Conditions
                        (Remaining time for NPC_Neutral_Engineer_Casting) Equal to 0.00
                        (Random integer number between 1 and 3) Equal to 1
                    Then - Actions
                        -------- =================================== --------
                        -------- Cluster Rockets --------
                        Unit - Order NPC_Neutral_Engineer to Neutral Tinker - Cluster Rockets NPC_VarPoint2
                        Countdown Timer - Start NPC_Neutral_Engineer_Casting as a One-shot timer that will expire in 2.00 seconds
                        -------- =================================== --------
                    Else - Actions
            Else - Actions
        -------- =================================== --------
        Custom script:   call RemoveLocation(udg_NPC_VarPoint)
        Custom script:   call DestroyGroup(udg_NPC_VarUnitGroup)
        Custom script:   call RemoveLocation(udg_Closest_Point)
