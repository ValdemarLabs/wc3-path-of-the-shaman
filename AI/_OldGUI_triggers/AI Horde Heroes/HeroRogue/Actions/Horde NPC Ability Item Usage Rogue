Horde NPC Ability Item Usage Rogue
    Events
    Conditions
    Actions
        -------- =================================== --------
        Set VariableSet NPC_VarPoint = (Position of NPC_Horde_AI_Rogue)
        Set VariableSet NPC_VarUnitGroup = (Units within 600.00 of NPC_VarPoint matching ((((Matching unit) is alive) Equal to True) and (((Matching unit) belongs to an enemy of (Owner of NPC_Horde_AI_Rogue).) Equal to True)).)
        -------- =================================== --------
        Set VariableSet Closest_Unit = No unit
        Set VariableSet Closest_ClosestDistance = 600.00
        Set VariableSet Closest_Group = (Units in (Playable map area) matching (((Matching unit) belongs to an enemy of (Owner of NPC_Horde_AI_Rogue).) Equal to True))
        Unit Group - Pick every unit in Closest_Group and do (Actions)
            Loop - Actions
                Set VariableSet Closest_Point = (Position of (Picked unit))
                Set VariableSet Closest_CurrentDistance = (Distance between NPC_VarPoint and Closest_Point)
                If (All Conditions are True) then do (Then Actions) else do (Else Actions)
                    If - Conditions
                        Closest_CurrentDistance Less than Closest_ClosestDistance
                    Then - Actions
                        Set VariableSet Closest_Unit = (Picked unit)
                        Set VariableSet Closest_ClosestDistance = Closest_CurrentDistance
                    Else - Actions
                Custom script:   call RemoveLocation(udg_Closest_Point)
        -------- =================================== --------
        If (All Conditions are True) then do (Then Actions) else do (Else Actions)
            If - Conditions
                Or - Any (Conditions) are true
                    Conditions
                        (Item-class of (Item carried by NPC_Horde_AI_Rogue in slot 1)) Equal to Charged
                        (Item-class of (Item carried by NPC_Horde_AI_Rogue in slot 2)) Equal to Charged
                        (Item-class of (Item carried by NPC_Horde_AI_Rogue in slot 3)) Equal to Charged
                        (Item-class of (Item carried by NPC_Horde_AI_Rogue in slot 4)) Equal to Charged
                        (Item-class of (Item carried by NPC_Horde_AI_Rogue in slot 5)) Equal to Charged
                        (Item-class of (Item carried by NPC_Horde_AI_Rogue in slot 6)) Equal to Charged
                Or - Any (Conditions) are true
                    Conditions
                        (Percentage life of NPC_Horde_AI_Rogue) Less than or equal to 50.00
                        (Percentage mana of NPC_Horde_AI_Rogue) Less than or equal to 50.00
            Then - Actions
                -------- =================================== --------
                -------- If Hero Has any consumables, USE them (NOW: Try to use any ITEM, could be modfied to consern only Charges and Purchable) --------
                Hero - Order NPC_Horde_AI_Rogue to use (Item carried by NPC_Horde_AI_Rogue of type (Random level -1.Any Class item-type))
                -------- =================================== --------
            Else - Actions
        If (All Conditions are True) then do (Then Actions) else do (Else Actions)
            If - Conditions
                (Number of units in NPC_VarUnitGroup) Greater than 0
            Then - Actions
                If (All Conditions are True) then do (Then Actions) else do (Else Actions)
                    If - Conditions
                        (Remaining time for NPC_Horde_AI_Rogue_Casting) Equal to 0.00
                        (Random integer number between 1 and 4) Equal to 1
                    Then - Actions
                        -------- =================================== --------
                        -------- Evasion --------
                        Unit - Order NPC_Horde_AI_Rogue to Night Elf Druid Of The Claw - Roar.
                        Countdown Timer - Start NPC_Horde_AI_Rogue_Casting as a One-shot timer that will expire in 2.00 seconds
                        -------- =================================== --------
                    Else - Actions
                If (All Conditions are True) then do (Then Actions) else do (Else Actions)
                    If - Conditions
                        (Remaining time for NPC_Horde_AI_Rogue_Casting) Equal to 0.00
                        (Random integer number between 1 and 3) Equal to 1
                    Then - Actions
                        -------- =================================== --------
                        -------- Garrote --------
                        Unit - Order NPC_Horde_AI_Rogue to Neutral - Parasite Closest_Unit
                        Countdown Timer - Start NPC_Horde_AI_Rogue_Casting as a One-shot timer that will expire in 2.00 seconds
                        -------- =================================== --------
                    Else - Actions
                If (All Conditions are True) then do (Then Actions) else do (Else Actions)
                    If - Conditions
                        (Remaining time for NPC_Horde_AI_Rogue_Casting) Equal to 0.00
                        (Random integer number between 1 and 3) Equal to 1
                        (Number of units in NPC_VarUnitGroup) Greater than or equal to 2
                    Then - Actions
                        -------- =================================== --------
                        -------- Shadowstep --------
                        -------- ------ Pick random unit from NPC_VarGroup AND check if the picked unit is ranged unit, only target ranged unit --------
                        Set VariableSet NPC_VarUnitGroup2 = (Units within 800.00 of NPC_VarPoint matching ((((Matching unit) is alive) Equal to True) and (((Unit-type of (Matching unit)) is A ranged attacker) Equal to True)).)
                        Set VariableSet NPC_TargetUnit = (Random unit from NPC_VarUnitGroup2)
                        If (All Conditions are True) then do (Then Actions) else do (Else Actions)
                            If - Conditions
                                NPC_TargetUnit Not equal to No unit
                            Then - Actions
                                Unit - Remove HeroRogue_SinisterStrike  from NPC_Horde_AI_Rogue
                                Unit - Add HeroRogue_Shadowstep  to NPC_Horde_AI_Rogue
                                Unit - Order NPC_Horde_AI_Rogue to Human Mountain King - Storm Bolt (Random unit from NPC_VarUnitGroup)
                                Countdown Timer - Start NPC_Horde_AI_Rogue_Casting as a One-shot timer that will expire in 4.00 seconds
                                Countdown Timer - Start NPC_Horde_AI_Rogue_RemoveAbi as a One-shot timer that will expire in 3.00 seconds
                                Set VariableSet NPC_Horde_AI_Rogue_Abil = HeroRogue_Shadowstep 
                                Set VariableSet NPC_Horde_AI_Rogue_Abil2 = HeroRogue_SinisterStrike 
                            Else - Actions
                        -------- =================================== --------
                    Else - Actions
                If (All Conditions are True) then do (Then Actions) else do (Else Actions)
                    If - Conditions
                        (Remaining time for NPC_Horde_AI_Rogue_Casting) Equal to 0.00
                        (Random integer number between 1 and 2) Equal to 1
                    Then - Actions
