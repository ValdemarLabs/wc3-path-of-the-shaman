    call RegisterBark(AI_Rogue_ProfileId, AI_BARK_HOLD, VL_ROGUE_HEROROGUE_HOLDPOSITIONS2_KEY, VL_ROGUE_HEROROGUE_HOLDPOSITIONS2_TEXT)
