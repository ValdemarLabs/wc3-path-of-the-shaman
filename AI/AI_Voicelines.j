/**
    AI_Voicelines

    Author: Valdemar
    Version:

    Description:
    ODS-backed AI bark and companion chat text data. This library registers
    the long idle/moving conversation tables and updates standard bark/reply
    text for the first-wave AI profiles.

    Credits:
    - AI/Voicelines/AI_Voicelines.ods

    How to install:
    Import after `AI_CompanionReplies.j`.

    API:
    Automatic initializer only.

**/
library AIVoicelines initializer Init requires AI, AIWarrior, AIRogue, AIWarlock, AIRestoshaman, AIPaladin, AIEngineer, AICompanionReplies

private function RegisterBark takes integer profileId, integer barkType, string soundKey, string text returns nothing
    call AI_RegisterBarkLine(profileId, barkType, text, soundKey)
endfunction

private function RegisterEngineerBark takes integer barkType, string soundKey, string text returns nothing
    call RegisterBark(AI_Engineer_ProfileId, barkType, soundKey, text)
    call RegisterBark(AI_Engineer_ShredderProfileId, barkType, soundKey, text)
endfunction

private function RegisterChat takes integer profileId, string soundKey, string text returns nothing
    // Long companion conversations can be selected from either idle or moving chatter.
    call RegisterBark(profileId, AI_BARK_IDLE, soundKey, text)
    call RegisterBark(profileId, AI_BARK_MOVING, soundKey, text)
endfunction

private function RegisterEngineerChat takes string soundKey, string text returns nothing
    call RegisterChat(AI_Engineer_ProfileId, soundKey, text)
    call RegisterChat(AI_Engineer_ShredderProfileId, soundKey, text)
endfunction

private function RegisterReply takes string primarySoundKey, integer responderProfileId, string responderName, string text returns nothing
    call AI_RegisterBarkReply(primarySoundKey, responderProfileId, text, primarySoundKey + responderName)
endfunction

private function RegisterHeroRogueStandard takes nothing returns nothing
    call RegisterBark(AI_Rogue_ProfileId, AI_BARK_GREET, "HeroRogue_Greet1", "What do ya need?")
    call RegisterBark(AI_Rogue_ProfileId, AI_BARK_GREET, "HeroRogue_Greet2", "I'm all ears.")
    call RegisterBark(AI_Rogue_ProfileId, AI_BARK_GREET, "HeroRogue_Greet3", "Heh, found any good trouble yet?")
    call RegisterBark(AI_Rogue_ProfileId, AI_BARK_GREET, "HeroRogue_Greet4", "Let's get this over with.")
    call RegisterBark(AI_Rogue_ProfileId, AI_BARK_FAREWELL, "HeroRogue_Farewell1", "Catch ya later, chief.")
    call RegisterBark(AI_Rogue_ProfileId, AI_BARK_FAREWELL, "HeroRogue_Farewell2", "Stay outta trouble... or don't.")
    call RegisterBark(AI_Rogue_ProfileId, AI_BARK_FAREWELL, "HeroRogue_Farewell3", "Off to skulk elsewhere.")
    call RegisterBark(AI_Rogue_ProfileId, AI_BARK_FAREWELL, "HeroRogue_Farewell4", "Keep your eyes sharp.")
    call RegisterBark(AI_Rogue_ProfileId, AI_BARK_PASSIVE, "HeroRogue_Passive1", "Following your lead, boss.")
    call RegisterBark(AI_Rogue_ProfileId, AI_BARK_PASSIVE, "HeroRogue_Passive2", "I'll keep close, no worries.")
    call RegisterBark(AI_Rogue_ProfileId, AI_BARK_NORMAL, "HeroRogue_Normal1", "Ready for anything.")
    call RegisterBark(AI_Rogue_ProfileId, AI_BARK_NORMAL, "HeroRogue_Normal2", "Let's get to work.")
    call RegisterBark(AI_Rogue_ProfileId, AI_BARK_AGGRESSIVE, "HeroRogue_Aggressive1", "Time to cause some chaos!")
    call RegisterBark(AI_Rogue_ProfileId, AI_BARK_AGGRESSIVE, "HeroRogue_Aggressive2", "Heh, blood and gold-my favorites.")
    call RegisterBark(AI_Rogue_ProfileId, AI_BARK_AGGRESSIVE, "HeroRogue_Aggressive3", "No mercy, eh? Fine by me!")
    call RegisterBark(AI_Rogue_ProfileId, AI_BARK_HOLD, "HeroRogue_HoldPositions1", "Fine, I'll sit tight.")
    call RegisterBark(AI_Rogue_ProfileId, AI_BARK_HOLD, "HeroRogue_HoldPositions2", "You sure this is a good spot?")
    call RegisterBark(AI_Rogue_ProfileId, AI_BARK_DROP_ITEMS, "HeroRogue_DropItems1", "Not like I needed those anyway.")
    call RegisterBark(AI_Rogue_ProfileId, AI_BARK_DROP_ITEMS, "HeroRogue_DropItems2", "Guess it's your turn to carry.")
    call RegisterBark(AI_Rogue_ProfileId, AI_BARK_DROP_ITEMS, "HeroRogue_DropItems3", "Here, don't lose them.")
    call RegisterBark(AI_Rogue_ProfileId, AI_BARK_IDLE, "HeroRogue_Idle1", "If you don't move, I might find something shiny.")
    call RegisterBark(AI_Rogue_ProfileId, AI_BARK_IDLE, "HeroRogue_Idle2", "You planning or sleeping?")
    call RegisterBark(AI_Rogue_ProfileId, AI_BARK_MOVING, "HeroRogue_Moving1", "Hope you know where we're goin'.")
    call RegisterBark(AI_Rogue_ProfileId, AI_BARK_MOVING, "HeroRogue_Moving2", "I swear, if we hit another dead end...")
    call RegisterBark(AI_Rogue_ProfileId, AI_BARK_MOVING, "HeroRogue_Moving3", "Nice weather here... not.")
    call RegisterBark(AI_Rogue_ProfileId, AI_BARK_CASTING, "HeroRogue_Casting1", "Let's see how they handle this trick.")
    call RegisterBark(AI_Rogue_ProfileId, AI_BARK_CASTING, "HeroRogue_Casting2", "I'll make this quick-real quick.")
    call RegisterBark(AI_Rogue_ProfileId, AI_BARK_CASTING, "HeroRogue_Casting3", "They won't feel a thing.")
    call RegisterBark(AI_Rogue_ProfileId, AI_BARK_ATTACKING, "HeroRogue_Attacking1", "You picked the wrong fight!")
    call RegisterBark(AI_Rogue_ProfileId, AI_BARK_ATTACKING, "HeroRogue_Attacking2", "Heh, you're already dead.")
    call RegisterBark(AI_Rogue_ProfileId, AI_BARK_ATTACKING, "HeroRogue_Attacking3", "For the Horde-and my pockets!")
    call RegisterBark(AI_Rogue_ProfileId, AI_BARK_KILLING, "HeroRogue_Killing1", "One less fool to worry about.")
    call RegisterBark(AI_Rogue_ProfileId, AI_BARK_KILLING, "HeroRogue_Killing2", "They weren't worth the effort.")
    call RegisterBark(AI_Rogue_ProfileId, AI_BARK_KILLING, "HeroRogue_Killing3", "Dead and gone.")
    call RegisterBark(AI_Rogue_ProfileId, AI_BARK_KICKED, "HeroRogue_Kicked1", "You don't need me? Fine!")
    call RegisterBark(AI_Rogue_ProfileId, AI_BARK_KICKED, "HeroRogue_Kicked2", "Was I too good for ya?")
    call RegisterBark(AI_Rogue_ProfileId, AI_BARK_KICKED, "HeroRogue_Kicked3", "Your loss, chief.")
    call RegisterBark(AI_Rogue_ProfileId, AI_BARK_COMPANION_DIES, "HeroRogue_UnitDies1", "Another one bites the dust.")
    call RegisterBark(AI_Rogue_ProfileId, AI_BARK_COMPANION_DIES, "HeroRogue_UnitDies2", "We'll mourn later-fight now!")
    call RegisterBark(AI_Rogue_ProfileId, AI_BARK_COMPANION_DIES, "HeroRogue_UnitDies3", "Didn't see that coming.")
    call RegisterBark(AI_Rogue_ProfileId, AI_BARK_ITEM_GIVEN, "HeroRogue_Item1", "Oh, shiny! I like it.")
    call RegisterBark(AI_Rogue_ProfileId, AI_BARK_ITEM_GIVEN, "HeroRogue_Item2", "What's this for?")
    call RegisterBark(AI_Rogue_ProfileId, AI_BARK_ITEM_GIVEN, "HeroRogue_Item3", "Guess I'll hold onto it.")
endfunction

private function RegisterHeroRogueChat takes nothing returns nothing
    call RegisterChat(AI_Rogue_ProfileId, "HeroRogue_ChatGeneral1", "People think I'm just a thief. They might be onto something...")
    call RegisterChat(AI_Rogue_ProfileId, "HeroRogue_ChatGeneral2", "I once stole a dragon's egg. It didn't end well, but worth it.")
    call RegisterChat(AI_Rogue_ProfileId, "HeroRogue_ChatGeneral4", "If the next thing is shiny, it's mine!")
    call RegisterChat(AI_Rogue_ProfileId, "HeroRogue_ChatGeneral5", "People call me shady. I prefer 'strategically dim.")
    call RegisterChat(AI_Rogue_ProfileId, "HeroRogue_ChatWarlock1", "Do those demons ever talk back to you warlock, or do they just grunt?")
    call RegisterChat(AI_Rogue_ProfileId, "HeroRogue_ChatWarlock2", "Careful with those curses, warlock. You might turn yourself into a rat. Oh, I forgot you already were one.")
    call RegisterChat(AI_Rogue_ProfileId, "HeroRogue_ChatWarlock3", "Ah, the warlock, master of shadows.")
    call RegisterChat(AI_Rogue_ProfileId, "HeroRogue_ChatWarlock4", "Can you summon a succubus to seduce me, warlock?")
    call RegisterChat(AI_Rogue_ProfileId, "HeroRogue_ChatWarlock5", "What's that smell? Is it you, warlock?")
    call RegisterChat(AI_Rogue_ProfileId, "HeroRogue_ChatWarrior1", "Charging into battle is brave, tauren, but sneaking past is smarter.")
    call RegisterChat(AI_Rogue_ProfileId, "HeroRogue_ChatWarrior2", "Big horns, bigger muscles. But can you warrior fit through that doorway?")
    call RegisterChat(AI_Rogue_ProfileId, "HeroRogue_ChatWarrior3", "Hey tauren, remember to not charge into me while in combat..")
    call RegisterChat(AI_Rogue_ProfileId, "HeroRogue_ChatWarrior4", "Hey big guy, I found a flower for you. Isn't that what you folks like?")
    call RegisterChat(AI_Rogue_ProfileId, "HeroRogue_ChatShaman1", "Your lightning strikes are impressive, shaman. I prefer the subtle approach.")
    call RegisterChat(AI_Rogue_ProfileId, "HeroRogue_ChatShaman2", "Spirits and totems... seems complicated. Me just stab and go.")
    call RegisterChat(AI_Rogue_ProfileId, "HeroRogue_ChatShaman3", "I would prefer windfury totem, if you have one. Me don't know about totems, but that one seems handy.")
    call RegisterChat(AI_Rogue_ProfileId, "HeroRogue_ChatShaman4", "When you shamans call electricity from the sky, I'm reminded why it's good to stay on your good side.")
    call RegisterChat(AI_Rogue_ProfileId, "HeroRogue_ChatEngineer1", "Another gadget, goblin? What happens when this one also blows up?")
    call RegisterChat(AI_Rogue_ProfileId, "HeroRogue_ChatEngineer2", "All those gizmos, and you still can't fix my cloak, engineer.")
    call RegisterChat(AI_Rogue_ProfileId, "HeroRogue_ChatEngineer3", "Your turrets are cute, goblin, but I prefer them not to announce my presence.")
    call RegisterChat(AI_Rogue_ProfileId, "HeroRogue_ChatEngineer4", "I hope the loud explosions your gadgets cause, won't be the death of me, goblin.")
    call RegisterChat(AI_Rogue_ProfileId, "HeroRogue_ChatPaladin1", "A holy paladin, eh? I'll bet you polish that armor more than you fight in it.")
    call RegisterChat(AI_Rogue_ProfileId, "HeroRogue_ChatPaladin2", "All that light, paladin. It's a wonder you haven't blinded yourself yet.")
    call RegisterChat(AI_Rogue_ProfileId, "HeroRogue_ChatPaladin3", "Remember the First War? Good times. Humans didn't even see us coming.")
    call RegisterChat(AI_Rogue_ProfileId, "HeroRogue_ChatPaladin5", "A truce with humans. Strange times, indeed. Let's see how long it lasts.")
endfunction

private function RegisterHeroRogueReplies takes nothing returns nothing
    call RegisterReply("HeroRogue_ChatGeneral1", AI_Warlock_ProfileId, "Warlock", "A thief? How original.")
    call RegisterReply("HeroRogue_ChatGeneral1", AI_Restoshaman_ProfileId, "Shaman", "Whose bag of coins are you holding this time?")
    call RegisterReply("HeroRogue_ChatGeneral1", AI_Warrior_ProfileId, "Warrior", "Thief, huh?")
    call RegisterReply("HeroRogue_ChatGeneral1", AI_Engineer_ProfileId, "Engineer", "Now if you'd only stop stealing my gadgets!")
    call RegisterReply("HeroRogue_ChatGeneral1", AI_Paladin_ProfileId, "Paladin", "What makes you any different compared to the thieves at Riverbane?")
    call RegisterReply("HeroRogue_ChatGeneral2", AI_Warlock_ProfileId, "Warlock", "Next time, try stealing something less likely to set you on fire.")
    call RegisterReply("HeroRogue_ChatGeneral2", AI_Restoshaman_ProfileId, "Shaman", "Stealing from dragons? You've got some balls.")
    call RegisterReply("HeroRogue_ChatGeneral2", AI_Warrior_ProfileId, "Warrior", "That does not seem very honorable thing to do...")
    call RegisterReply("HeroRogue_ChatGeneral2", AI_Engineer_ProfileId, "Engineer", "A dragon's egg? Yeah, that sounds like a good plan... right up until it starts hatching.")
    call RegisterReply("HeroRogue_ChatGeneral2", AI_Paladin_ProfileId, "Paladin", "Did the dragon teach you a lesson?")
    call RegisterReply("HeroRogue_ChatGeneral4", AI_Warlock_ProfileId, "Warlock", "Chase your shinies, little magpie. I'll be claiming the real treasures.")
    call RegisterReply("HeroRogue_ChatGeneral4", AI_Restoshaman_ProfileId, "Shaman", "You should think beyond mere trinkets.")
    call RegisterReply("HeroRogue_ChatGeneral4", AI_Warrior_ProfileId, "Warrior", "No! We will roll dice and the winner gets it.")
    call RegisterReply("HeroRogue_ChatGeneral4", AI_Engineer_ProfileId, "Engineer", "I'll take it apart and make it explode. Don't get too attached to anything, rogue!")
    call RegisterReply("HeroRogue_ChatGeneral4", AI_Paladin_ProfileId, "Paladin", "Now you are just being greedy...")
    call RegisterReply("HeroRogue_ChatGeneral5", AI_Warlock_ProfileId, "Warlock", "Strategically dim? Finally, something we agree on.")
    call RegisterReply("HeroRogue_ChatGeneral5", AI_Restoshaman_ProfileId, "Shaman", "I prefer the term: Strategically shady, stealthy trickster, master of distraction, who moonlights as Mr. Pickpocket Master 1000, with a knack for turning the tables when least expected.")
    call RegisterReply("HeroRogue_ChatGeneral5", AI_Warrior_ProfileId, "Warrior", "Sounds more like a coward to me.")
    call RegisterReply("HeroRogue_ChatGeneral5", AI_Engineer_ProfileId, "Engineer", "What does that even mean?")
    call RegisterReply("HeroRogue_ChatGeneral5", AI_Paladin_ProfileId, "Paladin", "I agree with those people...")
    call RegisterReply("HeroRogue_ChatWarlock1", AI_Warlock_ProfileId, "Warlock", "They grunt when amused. Much like I do listening to your attempts at humor.")
    call RegisterReply("HeroRogue_ChatWarlock2", AI_Warlock_ProfileId, "Warlock", "Clever, rogue. But I've yet to see a rat as resourceful as I.")
    call RegisterReply("HeroRogue_ChatWarlock3", AI_Warlock_ProfileId, "Warlock", "Ah, the rogue, master of kitchen knives.")
    call RegisterReply("HeroRogue_ChatWarlock4", AI_Warlock_ProfileId, "Warlock", "Even a demon has standards. Don't get your hopes up.")
    call RegisterReply("HeroRogue_ChatWarlock5", AI_Warlock_ProfileId, "Warlock", "That smell? It's fear. Yours, lingering in the air.")
    call RegisterReply("HeroRogue_ChatWarrior1", AI_Warrior_ProfileId, "Warrior", "Well, how does tauren sneak past enemies? Any ideas?")
    call RegisterReply("HeroRogue_ChatWarrior2", AI_Warrior_ProfileId, "Warrior", "If I have to, I'll make room.")
    call RegisterReply("HeroRogue_ChatWarrior3", AI_Warrior_ProfileId, "Warrior", "Keep your distance then, if you don't want to get smashed.")
    call RegisterReply("HeroRogue_ChatWarrior4", AI_Warrior_ProfileId, "Warrior", "Hah, nice one!")
    call RegisterReply("HeroRogue_ChatShaman1", AI_Restoshaman_ProfileId, "Shaman", "Subtlety has its place, but sometimes you must call upon the storm to cleanse the battlefield.")
    call RegisterReply("HeroRogue_ChatShaman2", AI_Restoshaman_ProfileId, "Shaman", "It is completely fine to be a little... simple minded.")
    call RegisterReply("HeroRogue_ChatShaman3", AI_Restoshaman_ProfileId, "Shaman", "Patience. You will have your windfury when the time is right.")
    call RegisterReply("HeroRogue_ChatShaman4", AI_Restoshaman_ProfileId, "Shaman", "I see that you are not as fool as I thought.")
    call RegisterReply("HeroRogue_ChatEngineer1", AI_Engineer_ProfileId, "Engineer", "Blow up? Hah! That's just part of the fun.")
    call RegisterReply("HeroRogue_ChatEngineer2", AI_Engineer_ProfileId, "Engineer", "Maybe if you stopped getting it stuck in things, I'd have time to fix it.")
    call RegisterReply("HeroRogue_ChatEngineer3", AI_Engineer_ProfileId, "Engineer", "Sorry! These are new prototypes and they are still under development...")
    call RegisterReply("HeroRogue_ChatEngineer4", AI_Engineer_ProfileId, "Engineer", "Can't you just be more stealthy then? And avoid being in my bombing sector.")
    call RegisterReply("HeroRogue_ChatPaladin1", AI_Paladin_ProfileId, "Paladin", "What's wrong with a little polish? It looks more newer.")
    call RegisterReply("HeroRogue_ChatPaladin2", AI_Paladin_ProfileId, "Paladin", "I strongly recommend not to directly look into the Light while I channel its power.")
    call RegisterReply("HeroRogue_ChatPaladin3", AI_Paladin_ProfileId, "Paladin", "You may have had a surprise then, but remember the Second War?")
    call RegisterReply("HeroRogue_ChatPaladin5", AI_Paladin_ProfileId, "Paladin", "I know where my loyalty lies, rogue. Let's see where yours leads.")
endfunction

private function RegisterHeroWarlockStandard takes nothing returns nothing
    call RegisterBark(AI_Warlock_ProfileId, AI_BARK_GREET, "HeroWarlock_Greet1", "Ah, the shaman graces me with their presence.")
    call RegisterBark(AI_Warlock_ProfileId, AI_BARK_GREET, "HeroWarlock_Greet2", "Let's see if your 'spirits' can keep up today.")
    call RegisterBark(AI_Warlock_ProfileId, AI_BARK_GREET, "HeroWarlock_Greet3", "What chaos shall we unleash?")
    call RegisterBark(AI_Warlock_ProfileId, AI_BARK_GREET, "HeroWarlock_Greet4", "The void stirs. What is your will?")
    call RegisterBark(AI_Warlock_ProfileId, AI_BARK_FAREWELL, "HeroWarlock_Farewell1", "Try not to get lost communing with rocks and wind.")
    call RegisterBark(AI_Warlock_ProfileId, AI_BARK_FAREWELL, "HeroWarlock_Farewell2", "Until we meet again.")
    call RegisterBark(AI_Warlock_ProfileId, AI_BARK_PASSIVE, "HeroWarlock_Passive1", "I will follow, but I will not bow.")
    call RegisterBark(AI_Warlock_ProfileId, AI_BARK_PASSIVE, "HeroWarlock_Passive2", "Do not mistake my silence for obedience.")
    call RegisterBark(AI_Warlock_ProfileId, AI_BARK_NORMAL, "HeroWarlock_Normal1", "Chaos awaits your word.")
    call RegisterBark(AI_Warlock_ProfileId, AI_BARK_NORMAL, "HeroWarlock_Normal2", "As you command, so it shall be.")
    call RegisterBark(AI_Warlock_ProfileId, AI_BARK_NORMAL, "HeroWarlock_Normal3", "I hunger for action.")
    call RegisterBark(AI_Warlock_ProfileId, AI_BARK_AGGRESSIVE, "HeroWarlock_Aggressive1", "Time to unleash the fury of the Twisting Nether!")
    call RegisterBark(AI_Warlock_ProfileId, AI_BARK_AGGRESSIVE, "HeroWarlock_Aggressive2", "The weak shall perish!")
    call RegisterBark(AI_Warlock_ProfileId, AI_BARK_AGGRESSIVE, "HeroWarlock_Aggressive3", "Let the world burn!")
    call RegisterBark(AI_Warlock_ProfileId, AI_BARK_HOLD, "HeroWarlock_HoldPositions1", "Are we meditating again? How quaint.")
    call RegisterBark(AI_Warlock_ProfileId, AI_BARK_HOLD, "HeroWarlock_HoldPositions2", "I'll stay, but do not test my patience.")
    call RegisterBark(AI_Warlock_ProfileId, AI_BARK_DROP_ITEMS, "HeroWarlock_DropItems1", "Here, shaman. Perhaps it will help you commune better with the dirt.")
    call RegisterBark(AI_Warlock_ProfileId, AI_BARK_DROP_ITEMS, "HeroWarlock_DropItems2", "Take them before I change my mind.")
    call RegisterBark(AI_Warlock_ProfileId, AI_BARK_DROP_ITEMS, "HeroWarlock_DropItems3", "They are yours, for now.")
    call RegisterBark(AI_Warlock_ProfileId, AI_BARK_IDLE, "HeroWarlock_Idle1", "Have you gone into a trance again, shaman?")
    call RegisterBark(AI_Warlock_ProfileId, AI_BARK_IDLE, "HeroWarlock_Idle2", "Shall we stand here until the end of days?")
    call RegisterBark(AI_Warlock_ProfileId, AI_BARK_MOVING, "HeroWarlock_Moving1", "Is this where the wind told you to go?")
    call RegisterBark(AI_Warlock_ProfileId, AI_BARK_MOVING, "HeroWarlock_Moving2", "This path reeks of death... I like it.")
    call RegisterBark(AI_Warlock_ProfileId, AI_BARK_MOVING, "HeroWarlock_Moving3", "Even the shadows grow weary of this pace.")
    call RegisterBark(AI_Warlock_ProfileId, AI_BARK_CASTING, "HeroWarlock_Casting1", "Watch and learn, shaman.")
    call RegisterBark(AI_Warlock_ProfileId, AI_BARK_CASTING, "HeroWarlock_Casting2", "This is how real power feels.")
    call RegisterBark(AI_Warlock_ProfileId, AI_BARK_CASTING, "HeroWarlock_Casting3", "Pain is the price of power!")
    call RegisterBark(AI_Warlock_ProfileId, AI_BARK_ATTACKING, "HeroWarlock_Attacking1", "Feel the fury of power unchained!")
    call RegisterBark(AI_Warlock_ProfileId, AI_BARK_ATTACKING, "HeroWarlock_Attacking2", "Your end was written in the shadows.")
    call RegisterBark(AI_Warlock_ProfileId, AI_BARK_ATTACKING, "HeroWarlock_Attacking3", "You cannot escape your fate!")
    call RegisterBark(AI_Warlock_ProfileId, AI_BARK_KILLING, "HeroWarlock_Killing1", "Their screams still linger.")
    call RegisterBark(AI_Warlock_ProfileId, AI_BARK_KILLING, "HeroWarlock_Killing2", "A fitting sacrifice.")
    call RegisterBark(AI_Warlock_ProfileId, AI_BARK_KILLING, "HeroWarlock_Killing3", "Weaklings fall before me.")
    call RegisterBark(AI_Warlock_ProfileId, AI_BARK_KICKED, "HeroWarlock_Kicked1", "When you beg for my aid, I will laugh.")
    call RegisterBark(AI_Warlock_ProfileId, AI_BARK_COMPANION_DIES, "HeroWarlock_OtherDies1", "They weren't strong enough...")
    call RegisterBark(AI_Warlock_ProfileId, AI_BARK_COMPANION_DIES, "HeroWarlock_OtherDies2", "They served their purpose. Barely.")
    call RegisterBark(AI_Warlock_ProfileId, AI_BARK_COMPANION_DIES, "HeroWarlock_OtherDies3", "Their weakness was their undoing.")
    call RegisterBark(AI_Warlock_ProfileId, AI_BARK_ITEM_GIVEN, "HeroWarlock_ItemGiven1", "A gift from the shaman? How thoughtful.")
    call RegisterBark(AI_Warlock_ProfileId, AI_BARK_ITEM_GIVEN, "HeroWarlock_ItemGiven2", "A trinket? Useful... perhaps.")
    call RegisterBark(AI_Warlock_ProfileId, AI_BARK_ITEM_GIVEN, "HeroWarlock_ItemGiven3", "Power, no matter how small, has its uses.")
    call RegisterBark(AI_Warlock_ProfileId, AI_BARK_ITEM_GIVEN, "HeroWarlock_ItemGiven4", "I accept this offering.")
endfunction

private function RegisterHeroWarlockChat takes nothing returns nothing
    call RegisterChat(AI_Warlock_ProfileId, "HeroWarlock_ChatGeneral1", "Why should I fight when I can just let the demons do the dirty work?")
    call RegisterChat(AI_Warlock_ProfileId, "HeroWarlock_ChatGeneral2", "You fight. I will observe. From a safe distance.")
    call RegisterChat(AI_Warlock_ProfileId, "HeroWarlock_ChatGeneral3", "Remember, power corrupts. Lucky for me, I was already corrupt.")
    call RegisterChat(AI_Warlock_ProfileId, "HeroWarlock_ChatGeneral4", "Do you think your job is hard? Try convincing a demon to work overtime.")
    call RegisterChat(AI_Warlock_ProfileId, "HeroWarlock_ChatGeneral5", "Death is only the beginning... but it's also a great way to end a fight.")
    call RegisterChat(AI_Warlock_ProfileId, "HeroWarlock_ChatGeneral6", "People call me cruel. I prefer the term creative problem solver.")
    call RegisterChat(AI_Warlock_ProfileId, "HeroWarlock_ChatGeneral7", "Don't blink, or you'll miss my masterpiece of destruction.")
    call RegisterChat(AI_Warlock_ProfileId, "HeroWarlock_ChatRogue1", "Fancy footwork, rogue. Is that a dance, or are you just avoiding work?")
    call RegisterChat(AI_Warlock_ProfileId, "HeroWarlock_ChatRogue2", "Always lurking in the shadows, rogue? It's almost like you don't want to be seen with us.")
    call RegisterChat(AI_Warlock_ProfileId, "HeroWarlock_ChatRogue3", "Do you ever stop smirking, rogue? It's like you're plotting something. Constantly.")
    call RegisterChat(AI_Warlock_ProfileId, "HeroWarlock_ChatRogue4", "What's there in the shadows, rogue?")
    call RegisterChat(AI_Warlock_ProfileId, "HeroWarlock_ChatWarrior1", "Do you always have to stomp so loudly, tauren? We get it, you're big.")
    call RegisterChat(AI_Warlock_ProfileId, "HeroWarlock_ChatWarrior2", "Careful, tauren. Don't let that temper flatten the whole team.")
    call RegisterChat(AI_Warlock_ProfileId, "HeroWarlock_ChatWarrior3", "Ever tried sneaking, tauren? Didn't think so.")
    call RegisterChat(AI_Warlock_ProfileId, "HeroWarlock_ChatWarrior4", "Hey warrior! Come over here. I can make you even stronger than ever before with my dark powers...")
    call RegisterChat(AI_Warlock_ProfileId, "HeroWarlock_ChatShaman1", "Nature this, spirits that. Just blast them already, shaman.")
    call RegisterChat(AI_Warlock_ProfileId, "HeroWarlock_ChatShaman2", "Shaman, your ancestors whisper. My demons scream. And guess what? Screams are louder.")
    call RegisterChat(AI_Warlock_ProfileId, "HeroWarlock_ChatShaman3", "What's that? A healing rain? Cute. Try rain of fire; it's more dramatic.")
    call RegisterChat(AI_Warlock_ProfileId, "HeroWarlock_ChatShaman4", "Even though we do not share our opinions, shaman. Can you still heal me? I would like to cast life tap more often.")
    call RegisterChat(AI_Warlock_ProfileId, "HeroWarlock_ChatEngineer1", "Careful with those gadgets, goblin. One misfire, and we're all toast.")
    call RegisterChat(AI_Warlock_ProfileId, "HeroWarlock_ChatEngineer2", "Hey little goblin, can your little robots fetch me some demon blood? No? Useless.")
    call RegisterChat(AI_Warlock_ProfileId, "HeroWarlock_ChatEngineer3", "Grenades, turrets, and robots... You engineers must be compensating for something.")
    call RegisterChat(AI_Warlock_ProfileId, "HeroWarlock_ChatEngineer4", "This turret goblin... can you build a version that can channel fel magic?")
    call RegisterChat(AI_Warlock_ProfileId, "HeroWarlock_ChatPaladin1", "Did someone lose their shiny tin can? Oh wait, it's just you, paladin.")
    call RegisterChat(AI_Warlock_ProfileId, "HeroWarlock_ChatPaladin2", "Careful, paladin, your righteousness might blind the rest of us.")
    call RegisterChat(AI_Warlock_ProfileId, "HeroWarlock_ChatPaladin3", "How does the Light taste when it gets smothered by darkness, paladin?")
    call RegisterChat(AI_Warlock_ProfileId, "HeroWarlock_ChatPaladin4", "How is your preaching, paladin? Maybe the enemies will fall asleep.")
    call RegisterChat(AI_Warlock_ProfileId, "HeroWarlock_ChatPaladin5", "Your 'justice' speeches could kill enemies with boredom.")
    call RegisterChat(AI_Warlock_ProfileId, "HeroWarlock_ChatPaladin6", "Oh no, an enemy! Quick, paladin, talk them to death.")
endfunction

private function RegisterHeroWarlockReplies takes nothing returns nothing
    call RegisterReply("HeroWarlock_ChatGeneral1", AI_Rogue_ProfileId, "Rogue", "Because trusting demons with your work sounds like a fast way to lose your head... or worse, your gold.")
    call RegisterReply("HeroWarlock_ChatGeneral1", AI_Restoshaman_ProfileId, "Shaman", "And when those demons turn on you? Will you still sit back and watch, or will you finally stand for yourself?")
    call RegisterReply("HeroWarlock_ChatGeneral1", AI_Warrior_ProfileId, "Warrior", "The difference between us, warlock, is that I fight with honor. You... delegate it to monsters.")
    call RegisterReply("HeroWarlock_ChatGeneral1", AI_Engineer_ProfileId, "Engineer", "You let your demons do the work and I let my robots do the same. Profit!")
    call RegisterReply("HeroWarlock_ChatGeneral1", AI_Paladin_ProfileId, "Paladin", "Fighting isn't about convenience; it's about courage. You wouldn't understand.")
    call RegisterReply("HeroWarlock_ChatGeneral2", AI_Rogue_ProfileId, "Rogue", "Observing, huh? Sounds like you're just waiting to loot the bodies.")
    call RegisterReply("HeroWarlock_ChatGeneral2", AI_Restoshaman_ProfileId, "Shaman", "Observe all you like, warlock. The spirits fight by my side, not in the shadows.")
    call RegisterReply("HeroWarlock_ChatGeneral2", AI_Warrior_ProfileId, "Warrior", "Stay back all you like, warlock. But when the dust settles, don't pretend you've earned the victory.")
    call RegisterReply("HeroWarlock_ChatGeneral2", AI_Engineer_ProfileId, "Engineer", "Observing? That's my favorite! Especially when it involves explosions and results.")
    call RegisterReply("HeroWarlock_ChatGeneral2", AI_Paladin_ProfileId, "Paladin", "Ah, the warlock way-watch others bleed while you bask in shadows.")
    call RegisterReply("HeroWarlock_ChatGeneral3", AI_Rogue_ProfileId, "Rogue", "Good for you. The rest of us are just trying to get rich without the side effects.")
    call RegisterReply("HeroWarlock_ChatGeneral3", AI_Restoshaman_ProfileId, "Shaman", "Corruption is a heavy chain, warlock.")
    call RegisterReply("HeroWarlock_ChatGeneral3", AI_Warrior_ProfileId, "Warrior", "Corruption is not strength, warlock. It's the coward's path to power.")
    call RegisterReply("HeroWarlock_ChatGeneral3", AI_Engineer_ProfileId, "Engineer", "That's cute. Let me show you what unstable gadgets can do to a lab coat.")
    call RegisterReply("HeroWarlock_ChatGeneral3", AI_Paladin_ProfileId, "Paladin", "Acknowledging your own corruption? A surprising moment of honesty.")
    call RegisterReply("HeroWarlock_ChatGeneral4", AI_Rogue_ProfileId, "Rogue", "Hard? Try stealing from someone who doesn't even know they've been robbed. That's skill.")
    call RegisterReply("HeroWarlock_ChatGeneral4", AI_Restoshaman_ProfileId, "Shaman", "Convincing the spirits requires respect, not coercion.")
    call RegisterReply("HeroWarlock_ChatGeneral4", AI_Warrior_ProfileId, "Warrior", "Hard? Maybe if you used your own strength instead of relying on borrowed chaos.")
    call RegisterReply("HeroWarlock_ChatGeneral4", AI_Engineer_ProfileId, "Engineer", "Try getting a malfunctioning turret to stop firing at your own team. Now that's hard!")
    call RegisterReply("HeroWarlock_ChatGeneral4", AI_Paladin_ProfileId, "Paladin", "Oh shut up already!")
    call RegisterReply("HeroWarlock_ChatGeneral5", AI_Rogue_ProfileId, "Rogue", "Hah, that's a one way to start a conversation.")
    call RegisterReply("HeroWarlock_ChatGeneral5", AI_Restoshaman_ProfileId, "Shaman", "Death is a transition, not a tool. You should be careful how you treat it.")
    call RegisterReply("HeroWarlock_ChatGeneral5", AI_Warrior_ProfileId, "Warrior", "Spoken like someone who's never faced it head-on.")
    call RegisterReply("HeroWarlock_ChatGeneral5", AI_Engineer_ProfileId, "Engineer", "Yes yes! Kaboom they go!")
    call RegisterReply("HeroWarlock_ChatGeneral5", AI_Paladin_ProfileId, "Paladin", "If you're so comfortable with death, perhaps you should meet it personally.")
    call RegisterReply("HeroWarlock_ChatGeneral6", AI_Rogue_ProfileId, "Rogue", "Creative problem solver? That's fancy talk for 'bad at keeping friends.")
    call RegisterReply("HeroWarlock_ChatGeneral6", AI_Restoshaman_ProfileId, "Shaman", "True solutions bring harmony, not destruction. Creativity without wisdom is chaos.")
    call RegisterReply("HeroWarlock_ChatGeneral6", AI_Warrior_ProfileId, "Warrior", "Creative? If destruction is your solution, warlock, you've got no imagination.")
    call RegisterReply("HeroWarlock_ChatGeneral6", AI_Engineer_ProfileId, "Engineer", "Cruel? Nah, you're just dramatic.")
    call RegisterReply("HeroWarlock_ChatGeneral6", AI_Paladin_ProfileId, "Paladin", "Call it what you will, but you are still evil.")
    call RegisterReply("HeroWarlock_ChatGeneral7", AI_Rogue_ProfileId, "Rogue", "Blink, and you might miss me emptying your pockets!")
    call RegisterReply("HeroWarlock_ChatGeneral7", AI_Restoshaman_ProfileId, "Shaman", "A masterpiece? Creation endures; destruction fades. Which one will history remember?")
    call RegisterReply("HeroWarlock_ChatGeneral7", AI_Warrior_ProfileId, "Warrior", "A true warrior doesn't aim to destroy. They aim to protect.")
    call RegisterReply("HeroWarlock_ChatGeneral7", AI_Engineer_ProfileId, "Engineer", "Oh no, I blinked! Did I miss it?")
    call RegisterReply("HeroWarlock_ChatGeneral7", AI_Paladin_ProfileId, "Paladin", "By the Light... What group of murderers have I joined...")
    call RegisterReply("HeroWarlock_ChatRogue1", AI_Rogue_ProfileId, "Rogue", "Call it what you like, but at least I'm not hiding behind a demon's tail.")
    call RegisterReply("HeroWarlock_ChatRogue2", AI_Rogue_ProfileId, "Rogue", "Can you blame me? It's not like you don't have the best reputation for team bonding either.")
    call RegisterReply("HeroWarlock_ChatRogue3", AI_Rogue_ProfileId, "Rogue", "Smirking? It's called confidence. You should try it sometime-without your little demon pet.")
    call RegisterReply("HeroWarlock_ChatRogue4", AI_Rogue_ProfileId, "Rogue", "Secrets... Come over here and I'll whisper it in your ear...")
    call RegisterReply("HeroWarlock_ChatWarrior1", AI_Warrior_ProfileId, "Warrior", "Better to stomp loudly with purpose than to tiptoe around with guilt, warlock.")
    call RegisterReply("HeroWarlock_ChatWarrior2", AI_Warrior_ProfileId, "Warrior", "My temper is steady, warlock. It's your schemes that make the ground unstable.")
    call RegisterReply("HeroWarlock_ChatWarrior3", AI_Warrior_ProfileId, "Warrior", "I leave sneaking to those who fear the fight. My strength is always in plain sight.")
    call RegisterReply("HeroWarlock_ChatWarrior4", AI_Warrior_ProfileId, "Warrior", "Strength earned through honor needs no shadowy bargains. Keep your fel magic, warlock.")
    call RegisterReply("HeroWarlock_ChatShaman1", AI_Restoshaman_ProfileId, "Shaman", "Patience, warlock. Nature's touch may be subtle, but it is relentless.")
    call RegisterReply("HeroWarlock_ChatShaman2", AI_Restoshaman_ProfileId, "Shaman", "Screams fade into echoes. Whispers carry through eternity.")
    call RegisterReply("HeroWarlock_ChatShaman3", AI_Restoshaman_ProfileId, "Shaman", "Healing rain nourishes life. Your fire leaves only ashes. Which one truly holds power?")
    call RegisterReply("HeroWarlock_ChatShaman4", AI_Restoshaman_ProfileId, "Shaman", "Healing is not about agreement, warlock. Even the most misguided deserve balance. Even you.")
    call RegisterReply("HeroWarlock_ChatEngineer1", AI_Engineer_ProfileId, "Engineer", "One misfire? That's just how I know it's working!")
    call RegisterReply("HeroWarlock_ChatEngineer2", AI_Engineer_ProfileId, "Engineer", "I never said they couldn't. I can reprogram them if you want... for a price!")
    call RegisterReply("HeroWarlock_ChatEngineer3", AI_Engineer_ProfileId, "Engineer", "Yeah, compensating for your complete lack of imagination.")
    call RegisterReply("HeroWarlock_ChatEngineer4", AI_Engineer_ProfileId, "Engineer", "Fel magic, huh? Sure, if you don't mind it exploding twice faster. Should be fun!")
    call RegisterReply("HeroWarlock_ChatPaladin1", AI_Paladin_ProfileId, "Paladin", "Better a shining armor than a shattered soul.")
    call RegisterReply("HeroWarlock_ChatPaladin2", AI_Paladin_ProfileId, "Paladin", "Only the wicked are blinded by the Light that guides me.")
    call RegisterReply("HeroWarlock_ChatPaladin3", AI_Paladin_ProfileId, "Paladin", "The Light isn't just tasted; it's lived. Something you'll never know.")
    call RegisterReply("HeroWarlock_ChatPaladin4", AI_Paladin_ProfileId, "Paladin", "Not everything can be exciting and destructive, Mr. Warlock!")
    call RegisterReply("HeroWarlock_ChatPaladin5", AI_Paladin_ProfileId, "Paladin", "Justice may not thrill you, but it humbles even the mightiest foes.")
    call RegisterReply("HeroWarlock_ChatPaladin6", AI_Paladin_ProfileId, "Paladin", "Better to talk before committing acts of violence and malevolency!")
endfunction

private function RegisterHeroUndeadWarlockStandard takes nothing returns nothing
    call RegisterBark(AI_Warlock_UndeadProfileId, AI_BARK_GREET, "HeroUndeadWarlock_Greet1", "The grave is quiet. Your summons are not.")
    call RegisterBark(AI_Warlock_UndeadProfileId, AI_BARK_GREET, "HeroUndeadWarlock_Greet2", "Speak quickly. The dead do not waste breath.")
    call RegisterBark(AI_Warlock_UndeadProfileId, AI_BARK_GREET, "HeroUndeadWarlock_Greet3", "I hear you, shaman. Even through the cold.")
    call RegisterBark(AI_Warlock_UndeadProfileId, AI_BARK_GREET, "HeroUndeadWarlock_Greet4", "Another path through shadow? Good.")
    call RegisterBark(AI_Warlock_UndeadProfileId, AI_BARK_FAREWELL, "HeroUndeadWarlock_Farewell1", "The silence will keep me company.")
    call RegisterBark(AI_Warlock_UndeadProfileId, AI_BARK_FAREWELL, "HeroUndeadWarlock_Farewell2", "Call again when the living need darker help.")
    call RegisterBark(AI_Warlock_UndeadProfileId, AI_BARK_PASSIVE, "HeroUndeadWarlock_Passive1", "I will follow at a measured pace.")
    call RegisterBark(AI_Warlock_UndeadProfileId, AI_BARK_PASSIVE, "HeroUndeadWarlock_Passive2", "My will is patient. Lead on.")
    call RegisterBark(AI_Warlock_UndeadProfileId, AI_BARK_NORMAL, "HeroUndeadWarlock_Normal1", "Point me toward the next doomed soul.")
    call RegisterBark(AI_Warlock_UndeadProfileId, AI_BARK_NORMAL, "HeroUndeadWarlock_Normal2", "I will keep the shadows close.")
    call RegisterBark(AI_Warlock_UndeadProfileId, AI_BARK_NORMAL, "HeroUndeadWarlock_Normal3", "The dead are ready.")
    call RegisterBark(AI_Warlock_UndeadProfileId, AI_BARK_AGGRESSIVE, "HeroUndeadWarlock_Aggressive1", "Let them join the countless dead.")
    call RegisterBark(AI_Warlock_UndeadProfileId, AI_BARK_AGGRESSIVE, "HeroUndeadWarlock_Aggressive2", "Their warmth will fade soon enough.")
    call RegisterBark(AI_Warlock_UndeadProfileId, AI_BARK_AGGRESSIVE, "HeroUndeadWarlock_Aggressive3", "No mercy. Only endings.")
    call RegisterBark(AI_Warlock_UndeadProfileId, AI_BARK_HOLD, "HeroUndeadWarlock_HoldPositions1", "I will stand here. Stillness suits me.")
    call RegisterBark(AI_Warlock_UndeadProfileId, AI_BARK_HOLD, "HeroUndeadWarlock_HoldPositions2", "This ground will be watched.")
    call RegisterBark(AI_Warlock_UndeadProfileId, AI_BARK_DROP_ITEMS, "HeroUndeadWarlock_DropItems1", "Take these. I have carried heavier burdens.")
    call RegisterBark(AI_Warlock_UndeadProfileId, AI_BARK_DROP_ITEMS, "HeroUndeadWarlock_DropItems2", "I have no attachment to such things.")
    call RegisterBark(AI_Warlock_UndeadProfileId, AI_BARK_DROP_ITEMS, "HeroUndeadWarlock_DropItems3", "Use them before they rot.")
    call RegisterBark(AI_Warlock_UndeadProfileId, AI_BARK_IDLE, "HeroUndeadWarlock_Idle1", "The living fidget. The dead endure.")
    call RegisterBark(AI_Warlock_UndeadProfileId, AI_BARK_IDLE, "HeroUndeadWarlock_Idle2", "Even silence has a voice, if you listen.")
    call RegisterBark(AI_Warlock_UndeadProfileId, AI_BARK_IDLE, "HeroUndeadWarlock_Idle3", "I remember breathing. I do not miss it.")
    call RegisterBark(AI_Warlock_UndeadProfileId, AI_BARK_MOVING, "HeroUndeadWarlock_Moving1", "Step lightly. The dead notice careless feet.")
    call RegisterBark(AI_Warlock_UndeadProfileId, AI_BARK_MOVING, "HeroUndeadWarlock_Moving2", "The road grows colder ahead.")
    call RegisterBark(AI_Warlock_UndeadProfileId, AI_BARK_MOVING, "HeroUndeadWarlock_Moving3", "I know this kind of silence.")
    call RegisterBark(AI_Warlock_UndeadProfileId, AI_BARK_CASTING, "HeroUndeadWarlock_Casting1", "Cold hands, darker power.")
    call RegisterBark(AI_Warlock_UndeadProfileId, AI_BARK_CASTING, "HeroUndeadWarlock_Casting2", "Rise, shadow. Take shape.")
    call RegisterBark(AI_Warlock_UndeadProfileId, AI_BARK_CASTING, "HeroUndeadWarlock_Casting3", "Their souls are already loosening.")
    call RegisterBark(AI_Warlock_UndeadProfileId, AI_BARK_ATTACKING, "HeroUndeadWarlock_Attacking1", "Your pulse betrays you.")
    call RegisterBark(AI_Warlock_UndeadProfileId, AI_BARK_ATTACKING, "HeroUndeadWarlock_Attacking2", "I will make this brief.")
    call RegisterBark(AI_Warlock_UndeadProfileId, AI_BARK_ATTACKING, "HeroUndeadWarlock_Attacking3", "The grave opens.")
    call RegisterBark(AI_Warlock_UndeadProfileId, AI_BARK_KILLING, "HeroUndeadWarlock_Killing1", "One more voice for the dark.")
    call RegisterBark(AI_Warlock_UndeadProfileId, AI_BARK_KILLING, "HeroUndeadWarlock_Killing2", "The silence claims another.")
    call RegisterBark(AI_Warlock_UndeadProfileId, AI_BARK_KILLING, "HeroUndeadWarlock_Killing3", "Death is patient, but I am not.")
    call RegisterBark(AI_Warlock_UndeadProfileId, AI_BARK_KICKED, "HeroUndeadWarlock_Kicked1", "So be it. I have been abandoned before.")
    call RegisterBark(AI_Warlock_UndeadProfileId, AI_BARK_KICKED, "HeroUndeadWarlock_Kicked2", "The dead walk alone often enough.")
    call RegisterBark(AI_Warlock_UndeadProfileId, AI_BARK_COMPANION_DIES, "HeroUndeadWarlock_OtherDies1", "Another flame extinguished.")
    call RegisterBark(AI_Warlock_UndeadProfileId, AI_BARK_COMPANION_DIES, "HeroUndeadWarlock_OtherDies2", "Their struggle is over.")
    call RegisterBark(AI_Warlock_UndeadProfileId, AI_BARK_COMPANION_DIES, "HeroUndeadWarlock_OtherDies3", "The living always fall eventually.")
    call RegisterBark(AI_Warlock_UndeadProfileId, AI_BARK_ITEM_GIVEN, "HeroUndeadWarlock_ItemGiven1", "A practical offering.")
    call RegisterBark(AI_Warlock_UndeadProfileId, AI_BARK_ITEM_GIVEN, "HeroUndeadWarlock_ItemGiven2", "This may yet serve the dead.")
    call RegisterBark(AI_Warlock_UndeadProfileId, AI_BARK_ITEM_GIVEN, "HeroUndeadWarlock_ItemGiven3", "I will keep it from useless hands.")
endfunction

private function RegisterHeroUndeadWarlockChat takes nothing returns nothing
    call RegisterChat(AI_Warlock_UndeadProfileId, "HeroUndeadWarlock_ChatGeneral1", "I used to fear the silence after death. Now I use it to think.")
    call RegisterChat(AI_Warlock_UndeadProfileId, "HeroUndeadWarlock_ChatGeneral2", "Rot teaches patience. Power teaches how little patience matters.")
    call RegisterChat(AI_Warlock_UndeadProfileId, "HeroUndeadWarlock_ChatGeneral3", "The living call it corruption. The dead call it an opportunity.")
    call RegisterChat(AI_Warlock_UndeadProfileId, "HeroUndeadWarlock_ChatGeneral4", "Every graveyard is a library, if you know how to listen.")
    call RegisterChat(AI_Warlock_UndeadProfileId, "HeroUndeadWarlock_ChatGeneral5", "I do not hate the living. I simply find them temporary.")
    call RegisterChat(AI_Warlock_UndeadProfileId, "HeroUndeadWarlock_ChatGeneral6", "Demons bargain loudly. The dead bargain honestly.")
    call RegisterChat(AI_Warlock_UndeadProfileId, "HeroUndeadWarlock_ChatGeneral7", "Some souls cling to the body. Mine learned to wander.")
    call RegisterChat(AI_Warlock_UndeadProfileId, "HeroUndeadWarlock_ChatRogue1", "Rogue, your shadow is loud. You should practice with actual darkness.")
    call RegisterChat(AI_Warlock_UndeadProfileId, "HeroUndeadWarlock_ChatRogue2", "I admire thieves. They understand that ownership is temporary.")
    call RegisterChat(AI_Warlock_UndeadProfileId, "HeroUndeadWarlock_ChatRogue3", "Careful where you step, rogue. Some buried things still bite.")
    call RegisterChat(AI_Warlock_UndeadProfileId, "HeroUndeadWarlock_ChatRogue4", "If you steal from a corpse, make sure it is finished objecting.")
    call RegisterChat(AI_Warlock_UndeadProfileId, "HeroUndeadWarlock_ChatWarrior1", "Warrior, strength fades. Hunger does not.")
    call RegisterChat(AI_Warlock_UndeadProfileId, "HeroUndeadWarlock_ChatWarrior2", "You charge as if death is an opponent you can knock down.")
    call RegisterChat(AI_Warlock_UndeadProfileId, "HeroUndeadWarlock_ChatWarrior3", "Your heart beats like a war drum. Mine used to.")
    call RegisterChat(AI_Warlock_UndeadProfileId, "HeroUndeadWarlock_ChatWarrior4", "Stand near me in battle. I prefer enemies distracted by living targets.")
    call RegisterChat(AI_Warlock_UndeadProfileId, "HeroUndeadWarlock_ChatShaman1", "Shaman, your spirits whisper. Mine complain.")
    call RegisterChat(AI_Warlock_UndeadProfileId, "HeroUndeadWarlock_ChatShaman2", "The elements remember life. Necromancy remembers what follows.")
    call RegisterChat(AI_Warlock_UndeadProfileId, "HeroUndeadWarlock_ChatShaman3", "Your healing feels strange on dead flesh, but I will not refuse it.")
    call RegisterChat(AI_Warlock_UndeadProfileId, "HeroUndeadWarlock_ChatShaman4", "Tell your ancestors I am not ready to answer them.")
    call RegisterChat(AI_Warlock_UndeadProfileId, "HeroUndeadWarlock_ChatEngineer1", "Engineer, can your machines run without a heart? We may have more in common than expected.")
    call RegisterChat(AI_Warlock_UndeadProfileId, "HeroUndeadWarlock_ChatEngineer2", "If it explodes, I can probably still use the remains.")
    call RegisterChat(AI_Warlock_UndeadProfileId, "HeroUndeadWarlock_ChatEngineer3", "Your devices clatter like bones in a sack.")
    call RegisterChat(AI_Warlock_UndeadProfileId, "HeroUndeadWarlock_ChatEngineer4", "Build me something that does not fear death. Then I will be impressed.")
    call RegisterChat(AI_Warlock_UndeadProfileId, "HeroUndeadWarlock_ChatPaladin1", "Paladin, do not glare. I am already dead.")
    call RegisterChat(AI_Warlock_UndeadProfileId, "HeroUndeadWarlock_ChatPaladin2", "Your Light burns. Mine is the cold after it fades.")
    call RegisterChat(AI_Warlock_UndeadProfileId, "HeroUndeadWarlock_ChatPaladin3", "If you try to redeem me, bring a shovel.")
    call RegisterChat(AI_Warlock_UndeadProfileId, "HeroUndeadWarlock_ChatPaladin4", "You speak of purity as if battle leaves anyone clean.")
    call RegisterChat(AI_Warlock_UndeadProfileId, "HeroUndeadWarlock_ChatPaladin5", "Keep your holy fire pointed away from me.")
endfunction

private function RegisterHeroUndeadWarlockReplies takes nothing returns nothing
    call RegisterReply("HeroRogue_ChatGeneral1", AI_Warlock_UndeadProfileId, "UndeadWarlock", "A thief steals from pockets. I prefer graves. We all have methods.")
    call RegisterReply("HeroRogue_ChatWarlock1", AI_Warlock_UndeadProfileId, "UndeadWarlock", "Demons talk. The useful ones know when to stop.")
    call RegisterReply("HeroRogue_ChatShaman3", AI_Warlock_UndeadProfileId, "UndeadWarlock", "Windfury is pleasant. A shame wind does little for dead lungs.")
    call RegisterReply("HeroShaman_ChatGeneral1", AI_Warlock_UndeadProfileId, "UndeadWarlock", "The wind stopped troubling me when I stopped breathing.")
    call RegisterReply("HeroShaman_ChatWarlock1", AI_Warlock_UndeadProfileId, "UndeadWarlock", "Impressive is a living word. Effective is better.")
    call RegisterReply("HeroShaman_ChatWarlock4", AI_Warlock_UndeadProfileId, "UndeadWarlock", "Respect is optional. Obedience is measurable.")
    call RegisterReply("HeroWarrior_ChatGeneral1", AI_Warlock_UndeadProfileId, "UndeadWarlock", "Ancestors are quieter when you know where they are buried.")
    call RegisterReply("HeroWarrior_ChatWarlock1", AI_Warlock_UndeadProfileId, "UndeadWarlock", "Dangerous power is still power.")
    call RegisterReply("HeroWarrior_ChatWarlock3", AI_Warlock_UndeadProfileId, "UndeadWarlock", "Everything betrays eventually. Demons are simply honest about it.")
    call RegisterReply("HeroEngineer_ChatGeneral1", AI_Warlock_UndeadProfileId, "UndeadWarlock", "A device held together by tape and willpower. Familiar, in a way.")
    call RegisterReply("HeroEngineer_ChatWarlock2", AI_Warlock_UndeadProfileId, "UndeadWarlock", "Demons backfire less often than goblin machinery.")
    call RegisterReply("HeroEngineer_ChatWarlock5", AI_Warlock_UndeadProfileId, "UndeadWarlock", "Use my power as a battery and I will use your skull as a lantern.")
    call RegisterReply("HeroPaladin_ChatGeneral1", AI_Warlock_UndeadProfileId, "UndeadWarlock", "Glory fades. Bones remain.")
    call RegisterReply("HeroPaladin_ChatWarlock1", AI_Warlock_UndeadProfileId, "UndeadWarlock", "Then keep your delicate nose away from my spellwork.")
    call RegisterReply("HeroPaladin_ChatWarlock3", AI_Warlock_UndeadProfileId, "UndeadWarlock", "Purify me and you may not enjoy what is left.")
endfunction

private function RegisterHeroShamanStandard takes nothing returns nothing
    call RegisterBark(AI_Restoshaman_ProfileId, AI_BARK_GREET, "HeroRestoshaman_Greet1", "The spirits walk with us.")
    call RegisterBark(AI_Restoshaman_ProfileId, AI_BARK_GREET, "HeroRestoshaman_Greet2", "May the winds guide us, my friend.")
    call RegisterBark(AI_Restoshaman_ProfileId, AI_BARK_GREET, "HeroRestoshaman_Greet3", "What aid do you require?")
    call RegisterBark(AI_Restoshaman_ProfileId, AI_BARK_FAREWELL, "HeroRestoshaman_Farewell1", "The spirits will watch over you.")
    call RegisterBark(AI_Restoshaman_ProfileId, AI_BARK_FAREWELL, "HeroRestoshaman_Farewell2", "I will await the call of the elements.")
    call RegisterBark(AI_Restoshaman_ProfileId, AI_BARK_PASSIVE, "HeroRestoshaman_Passive1", "I shall remain at your side.")
    call RegisterBark(AI_Restoshaman_ProfileId, AI_BARK_PASSIVE, "HeroRestoshaman_Passive2", "I will follow you.")
    call RegisterBark(AI_Restoshaman_ProfileId, AI_BARK_NORMAL, "HeroRestoshaman_Normal1", "I will assist you in this endeavor.")
    call RegisterBark(AI_Restoshaman_ProfileId, AI_BARK_NORMAL, "HeroRestoshaman_Normal2", "Your will aligns with the elements.")
    call RegisterBark(AI_Restoshaman_ProfileId, AI_BARK_NORMAL, "HeroRestoshaman_Normal3", "Let us bring balance to the chaos.")
    call RegisterBark(AI_Restoshaman_ProfileId, AI_BARK_AGGRESSIVE, "HeroRestoshaman_Aggressive1", "The storm will cleanse our enemies!")
    call RegisterBark(AI_Restoshaman_ProfileId, AI_BARK_AGGRESSIVE, "HeroRestoshaman_Aggressive2", "They will feel the wrath of the elements!")
    call RegisterBark(AI_Restoshaman_ProfileId, AI_BARK_HOLD, "HeroRestoshaman_HoldPositions1", "I will remain here, as steady as a mountain.")
    call RegisterBark(AI_Restoshaman_ProfileId, AI_BARK_HOLD, "HeroRestoshaman_HoldPositions2", "I will stand firm, as the earth beneath us.")
    call RegisterBark(AI_Restoshaman_ProfileId, AI_BARK_DROP_ITEMS, "HeroRestoshaman_DropItems1", "Take them, they may serve you well.")
    call RegisterBark(AI_Restoshaman_ProfileId, AI_BARK_DROP_ITEMS, "HeroRestoshaman_DropItems2", "Sure, I don't need any worldly possessions.")
    call RegisterBark(AI_Restoshaman_ProfileId, AI_BARK_IDLE, "HeroRestoshaman_Idle1", "Even the elements rest... occasionally.")
    call RegisterBark(AI_Restoshaman_ProfileId, AI_BARK_IDLE, "HeroRestoshaman_Idle2", "The calm before the storm has its purpose.")
    call RegisterBark(AI_Restoshaman_ProfileId, AI_BARK_MOVING, "HeroRestoshaman_Moving1", "The journey is as important as the destination.")
    call RegisterBark(AI_Restoshaman_ProfileId, AI_BARK_MOVING, "HeroRestoshaman_Moving2", "Keep moving; the spirits are restless.")
    call RegisterBark(AI_Restoshaman_ProfileId, AI_BARK_CASTING, "HeroRestoshaman_Casting1", "The earth lends its strength to us.")
    call RegisterBark(AI_Restoshaman_ProfileId, AI_BARK_CASTING, "HeroRestoshaman_Casting2", "I call upon the ancestral spirits!")
    call RegisterBark(AI_Restoshaman_ProfileId, AI_BARK_ATTACKING, "HeroRestoshaman_Attacking1", "The earth will not yield to you!")
    call RegisterBark(AI_Restoshaman_ProfileId, AI_BARK_ATTACKING, "HeroRestoshaman_Attacking2", "Your reign ends here!")
    call RegisterBark(AI_Restoshaman_ProfileId, AI_BARK_KILLING, "HeroRestoshaman_UnitDies1", "Their path has ended, as all must.")
    call RegisterBark(AI_Restoshaman_ProfileId, AI_BARK_KILLING, "HeroRestoshaman_UnitDies2", "They are one with the elements now.")
    call RegisterBark(AI_Restoshaman_ProfileId, AI_BARK_KICKED, "HeroRestoshaman_Kicked1", "If this is your will, so be it.")
    call RegisterBark(AI_Restoshaman_ProfileId, AI_BARK_KICKED, "HeroRestoshaman_Kicked2", "I will not question the path you walk.")
    call RegisterBark(AI_Restoshaman_ProfileId, AI_BARK_COMPANION_DIES, "HeroRestoshaman_CompanionDies1", "We must honor their sacrifice.")
    call RegisterBark(AI_Restoshaman_ProfileId, AI_BARK_ITEM_GIVEN, "HeroRestoshaman_GiveItem1", "This will serve us in restoring balance.")
    call RegisterBark(AI_Restoshaman_ProfileId, AI_BARK_ITEM_GIVEN, "HeroRestoshaman_GiveItem2", "I will use this wisely.")
endfunction

private function RegisterHeroShamanChat takes nothing returns nothing
    call RegisterChat(AI_Restoshaman_ProfileId, "HeroShaman_ChatGeneral1", "The wind carries the stories of the world, though I'm still trying to understand why it always blows in my face when I'm in a hurry.")
    call RegisterChat(AI_Restoshaman_ProfileId, "HeroShaman_ChatGeneral2", "The earth speaks to those who listen... but sometimes, it's just complaining about the weather.")
    call RegisterChat(AI_Restoshaman_ProfileId, "HeroShaman_ChatGeneral3", "Every tree, every stone, every gust of wind carries a story... most of them involve me tripping over something.")
    call RegisterChat(AI_Restoshaman_ProfileId, "HeroShaman_ChatGeneral4", "I sense a disturbance in the balance, as if the earth itself trembles under the weight of dark deeds.")
    call RegisterChat(AI_Restoshaman_ProfileId, "HeroShaman_ChatGeneral5", "There is a stirring in the world, a sense of impending doom....")
    call RegisterChat(AI_Restoshaman_ProfileId, "HeroShaman_ChatGeneral6", "Healing comes in many forms that some consider to be... unnatural...")
    call RegisterChat(AI_Restoshaman_ProfileId, "HeroShaman_ChatRogue1", "Rogue, your footsteps are silent, but your intentions speak loudly.")
    call RegisterChat(AI_Restoshaman_ProfileId, "HeroShaman_ChatRogue2", "Stay sharp now, rogue. The shadows you hide in may hide dangers as well.")
    call RegisterChat(AI_Restoshaman_ProfileId, "HeroShaman_ChatRogue3", "Your path is unseen, but your purpose is clear to me. Give me back my totem, rogue...")
    call RegisterChat(AI_Restoshaman_ProfileId, "HeroShaman_ChatRogue4", "So, rogue. How many innocents have you pickpocketed today?")
    call RegisterChat(AI_Restoshaman_ProfileId, "HeroShaman_ChatRogue5", "Do you ever tire of hiding, rogue? Or is it the thrill that keeps you moving?")
    call RegisterChat(AI_Restoshaman_ProfileId, "HeroShaman_ChatWarrior1", "Do not let your rage control you, warrior. Balance is key, even in battle.")
    call RegisterChat(AI_Restoshaman_ProfileId, "HeroShaman_ChatWarrior2", "Warrior, your strength is undeniable, but don't forget the value of patience.")
    call RegisterChat(AI_Restoshaman_ProfileId, "HeroShaman_ChatWarrior3", "Warrior, has anyone told you that not every problem needs smashing?")
    call RegisterChat(AI_Restoshaman_ProfileId, "HeroShaman_ChatWarrior4", "Hey warrior! I can give you personal windfury enhancement. Just keep it to yourself.")
    call RegisterChat(AI_Restoshaman_ProfileId, "HeroShaman_ChatWarlock1", "Your magic is most impressive, warlock. Now, if only it didn't smell so... sulfuric.")
    call RegisterChat(AI_Restoshaman_ProfileId, "HeroShaman_ChatWarlock2", "You have such potential, warlock. It's a shame you've chained it to chaos.")
    call RegisterChat(AI_Restoshaman_ProfileId, "HeroShaman_ChatWarlock3", "The elements once spoke to you, warlock. Do you even remember their voices?")
    call RegisterChat(AI_Restoshaman_ProfileId, "HeroShaman_ChatWarlock4", "Warlock, your demons obey you, but they do not respect you. Neither do the spirits.")
    call RegisterChat(AI_Restoshaman_ProfileId, "HeroShaman_ChatEngineer1", "Your machines are clever, engineer, but they lack the heart.")
    call RegisterChat(AI_Restoshaman_ProfileId, "HeroShaman_ChatEngineer2", "Every bolt and gear you craft, engineer, are eventually provided by the Mother Earth.")
    call RegisterChat(AI_Restoshaman_ProfileId, "HeroShaman_ChatEngineer3", "Goblin, I hope your contraptions don't explode... this time.")
    call RegisterChat(AI_Restoshaman_ProfileId, "HeroShaman_ChatEngineer4", "Can you please think silently for once, goblin. I having a headache of your mumblings...")
    call RegisterChat(AI_Restoshaman_ProfileId, "HeroShaman_ChatPaladin1", "The past has divided us, paladin, but the future still holds the promise of peace.")
    call RegisterChat(AI_Restoshaman_ProfileId, "HeroShaman_ChatPaladin2", "Your faith is strong, paladin. Together, perhaps we can build something even stronger.")
    call RegisterChat(AI_Restoshaman_ProfileId, "HeroShaman_ChatPaladin3", "The Light guides you, paladin. Does it speak to you the way the storm speaks to me?")
    call RegisterChat(AI_Restoshaman_ProfileId, "HeroShaman_ChatPaladin4", "Perhaps, paladin, we are not so different after all. Both of us serve something greater than ourselves.")
endfunction

private function RegisterHeroShamanReplies takes nothing returns nothing
    call RegisterReply("HeroShaman_ChatGeneral1", AI_Rogue_ProfileId, "Rogue", "Sounds like the wind's got a sense of humor, shaman.")
    call RegisterReply("HeroShaman_ChatGeneral1", AI_Warlock_ProfileId, "Warlock", "Perhaps the wind is trying to blow some sense into you, shaman. A pity it's not working.")
    call RegisterReply("HeroShaman_ChatGeneral1", AI_Warrior_ProfileId, "Warrior", "Wind's always in my face too. Maybe it just doesn't like big guys like us.")
    call RegisterReply("HeroShaman_ChatGeneral1", AI_Engineer_ProfileId, "Engineer", "I got a gadget for that-I built a catch-a-wind antenna last week! Still trying to figure out what am I going to do with it, though.")
    call RegisterReply("HeroShaman_ChatGeneral1", AI_Paladin_ProfileId, "Paladin", "Perhaps the wind is urging you to stand your ground instead of rushing forward.")
    call RegisterReply("HeroShaman_ChatGeneral2", AI_Rogue_ProfileId, "Rogue", "Let me guess, the earth also complains about your singing during one of your rituals?")
    call RegisterReply("HeroShaman_ChatGeneral2", AI_Warlock_ProfileId, "Warlock", "And that is precisely why I left the old ways!")
    call RegisterReply("HeroShaman_ChatGeneral2", AI_Warrior_ProfileId, "Warrior", "The earth told me to tell you to stop twaddling and get to healing.")
    call RegisterReply("HeroShaman_ChatGeneral2", AI_Engineer_ProfileId, "Engineer", "Earth complaining? Sounds like a job for my all-purpose-complaint-suppressor! Only exploded twice so far!")
    call RegisterReply("HeroShaman_ChatGeneral2", AI_Paladin_ProfileId, "Paladin", "Sometimes, I wonder if we are speaking with the same entity.")
    call RegisterReply("HeroShaman_ChatGeneral3", AI_Rogue_ProfileId, "Rogue", "Sounds like the elements' stories are full of slapstick humor. Maybe it's your destiny to keep them entertained.")
    call RegisterReply("HeroShaman_ChatGeneral3", AI_Warlock_ProfileId, "Warlock", "Sounds like the precious elements of yours hate you?")
    call RegisterReply("HeroShaman_ChatGeneral3", AI_Warrior_ProfileId, "Warrior", "Maybe it's their way of saying you talk too much.")
    call RegisterReply("HeroShaman_ChatGeneral3", AI_Engineer_ProfileId, "Engineer", "Blaa blaa, boring! My spinning gizmos carry explosions-much more exciting!")
    call RegisterReply("HeroShaman_ChatGeneral3", AI_Paladin_ProfileId, "Paladin", "If the earth trips you, shaman, perhaps it's testing your resolve. The Light does that. Too often...")
    call RegisterReply("HeroShaman_ChatGeneral4", AI_Rogue_ProfileId, "Rogue", "Dark deeds, trembling earth... I'll bet there's treasure nearby.")
    call RegisterReply("HeroShaman_ChatGeneral4", AI_Warlock_ProfileId, "Warlock", "Ah, so the spirits can tell my thoughts now?")
    call RegisterReply("HeroShaman_ChatGeneral4", AI_Warrior_ProfileId, "Warrior", "Wait, was that my fault? I did stomp pretty hard earlier...")
    call RegisterReply("HeroShaman_ChatGeneral4", AI_Engineer_ProfileId, "Engineer", "Oh, that's probably just my unstable seismic testing drill 6000. Ignore that!")
    call RegisterReply("HeroShaman_ChatGeneral4", AI_Paladin_ProfileId, "Paladin", "I sense that disturbance as well, but spoken by the Light itself.")
    call RegisterReply("HeroShaman_ChatGeneral5", AI_Rogue_ProfileId, "Rogue", "Stop being so pessimistic, shaman.")
    call RegisterReply("HeroShaman_ChatGeneral5", AI_Warlock_ProfileId, "Warlock", "That's just me stretching. Wait until I really get going.")
    call RegisterReply("HeroShaman_ChatGeneral5", AI_Warrior_ProfileId, "Warrior", "Does that mean it's time for smashing?")
    call RegisterReply("HeroShaman_ChatGeneral5", AI_Engineer_ProfileId, "Engineer", "Yep, that's a tick that is definitely coming from one of my bombs. Let me disable that one...")
    call RegisterReply("HeroShaman_ChatGeneral5", AI_Paladin_ProfileId, "Paladin", "Then let us prepare to meet it head-on, armed with faith and conviction.")
    call RegisterReply("HeroShaman_ChatGeneral6", AI_Rogue_ProfileId, "Rogue", "Now where have I heard that before?")
    call RegisterReply("HeroShaman_ChatGeneral6", AI_Warlock_ProfileId, "Warlock", "I prefer to remove the need for healing entirely... by eradicating the problem.")
    call RegisterReply("HeroShaman_ChatGeneral6", AI_Warrior_ProfileId, "Warrior", "Your healing feels fine to me, shaman. I'll take more of that 'unnatural' stuff, thanks!")
    call RegisterReply("HeroShaman_ChatGeneral6", AI_Engineer_ProfileId, "Engineer", "In my opinion, there's no such thing as unnatural, except my super self-repair-bot 1000!")
    call RegisterReply("HeroShaman_ChatGeneral6", AI_Paladin_ProfileId, "Paladin", "Only the Light heals purely and truly. Trust in it, and you'll see.")
    call RegisterReply("HeroShaman_ChatRogue1", AI_Rogue_ProfileId, "Rogue", "Thanks, shaman. I'll take that as a compliment. My intentions are... creatively flexible.")
    call RegisterReply("HeroShaman_ChatRogue2", AI_Rogue_ProfileId, "Rogue", "I'm always sharp! And what ever is hiding in the shadows should be afraid of me!")
    call RegisterReply("HeroShaman_ChatRogue3", AI_Rogue_ProfileId, "Rogue", "Oh, this? I was just... safeguarding it. You wouldn't want it to fall into the wrong hands, right?")
    call RegisterReply("HeroShaman_ChatRogue4", AI_Rogue_ProfileId, "Rogue", "Define 'innocent', shaman. It's all relative.")
    call RegisterReply("HeroShaman_ChatRogue5", AI_Rogue_ProfileId, "Rogue", "It's not hiding, shaman. It's called tactical positioning. And yes, the thrill is a nice bonus.")
    call RegisterReply("HeroShaman_ChatWarrior1", AI_Warrior_ProfileId, "Warrior", "But I need more rage to flatten my enemies!")
    call RegisterReply("HeroShaman_ChatWarrior2", AI_Warrior_ProfileId, "Warrior", "I have patience... for about three seconds. Then it's smashing time!")
    call RegisterReply("HeroShaman_ChatWarrior3", AI_Warrior_ProfileId, "Warrior", "Oh, I see. Some problems need stomping instead of smashing. Got it!")
    call RegisterReply("HeroShaman_ChatWarrior4", AI_Warrior_ProfileId, "Warrior", "You give me more of that windfury stuff, and I'll call you the best shaman ever.")
    call RegisterReply("HeroShaman_ChatWarlock1", AI_Warlock_ProfileId, "Warlock", "Careful shaman, flattery might get you cursed.")
    call RegisterReply("HeroShaman_ChatWarlock2", AI_Warlock_ProfileId, "Warlock", "Potential is nothing without ambition.")
    call RegisterReply("HeroShaman_ChatWarlock3", AI_Warlock_ProfileId, "Warlock", "The elements demand respect and patience. Fel magic? It demands nothing and delivers everything-if you're strong enough to embrace it.")
    call RegisterReply("HeroShaman_ChatWarlock4", AI_Warlock_ProfileId, "Warlock", "Oh, the spirits don't respect me? Good. Fear is so much more satisfying.")
    call RegisterReply("HeroShaman_ChatEngineer1", AI_Engineer_ProfileId, "Engineer", "Why would a machine need a heart? Less things to break!")
    call RegisterReply("HeroShaman_ChatEngineer2", AI_Engineer_ProfileId, "Engineer", "She's got great raw materials, but her delivery time stinks!")
    call RegisterReply("HeroShaman_ChatEngineer3", AI_Engineer_ProfileId, "Engineer", "I swear I promise, no explosion this time! Well, probably. Maybe. Uh, stand back.")
    call RegisterReply("HeroShaman_ChatEngineer4", AI_Engineer_ProfileId, "Engineer", "But how else would you know what's exploding next?")
    call RegisterReply("HeroShaman_ChatPaladin1", AI_Paladin_ProfileId, "Paladin", "The future is forged in trust, shaman. Let the Light guide our path to unity.")
    call RegisterReply("HeroShaman_ChatPaladin2", AI_Paladin_ProfileId, "Paladin", "Your strength lies in the storm, mine in the Light. Together, we can be an unstoppable force for good.")
    call RegisterReply("HeroShaman_ChatPaladin3", AI_Paladin_ProfileId, "Paladin", "The Light speaks to me gently with a voice of compassion and righteous.")
    call RegisterReply("HeroShaman_ChatPaladin4", AI_Paladin_ProfileId, "Paladin", "Something greater indeed, shaman. Perhaps it's the same force guiding us from different paths.")
endfunction

private function RegisterHeroWarriorStandard takes nothing returns nothing
    call RegisterBark(AI_Warrior_ProfileId, AI_BARK_GREET, "HeroWarrior_Greet1", "Strength and honor to you, traveler.")
    call RegisterBark(AI_Warrior_ProfileId, AI_BARK_GREET, "HeroWarrior_Greet2", "What do you require of my strength?")
    call RegisterBark(AI_Warrior_ProfileId, AI_BARK_FAREWELL, "HeroWarrior_Farewell1", "May your path be steady and strong.")
    call RegisterBark(AI_Warrior_ProfileId, AI_BARK_FAREWELL, "HeroWarrior_Farewell2", "Farewell, until we meet again.")
    call RegisterBark(AI_Warrior_ProfileId, AI_BARK_PASSIVE, "HeroWarrior_Passive1", "Where you lead, I will tread with purpose.")
    call RegisterBark(AI_Warrior_ProfileId, AI_BARK_PASSIVE, "HeroWarrior_Passive2", "My strength stands ready.")
    call RegisterBark(AI_Warrior_ProfileId, AI_BARK_NORMAL, "HeroWarrior_Normal1", "Lead on; my fists are yours to command.")
    call RegisterBark(AI_Warrior_ProfileId, AI_BARK_NORMAL, "HeroWarrior_Normal2", "This warrior is ready for action.")
    call RegisterBark(AI_Warrior_ProfileId, AI_BARK_AGGRESSIVE, "HeroWarrior_Aggressive1", "For the ancestors, we fight!")
    call RegisterBark(AI_Warrior_ProfileId, AI_BARK_AGGRESSIVE, "HeroWarrior_Aggressive2", "Honor demands action!")
    call RegisterBark(AI_Warrior_ProfileId, AI_BARK_HOLD, "HeroWarrior_HoldPositions1", "I will hold this ground, unshaken.")
    call RegisterBark(AI_Warrior_ProfileId, AI_BARK_HOLD, "HeroWarrior_HoldPositions2", "The mountains do not bow, and neither will I.")
    call RegisterBark(AI_Warrior_ProfileId, AI_BARK_DROP_ITEMS, "HeroWarrior_DropItems1", "Here you go.")
    call RegisterBark(AI_Warrior_ProfileId, AI_BARK_DROP_ITEMS, "HeroWarrior_DropItems2", "Take them.")
    call RegisterBark(AI_Warrior_ProfileId, AI_BARK_IDLE, "HeroWarrior_Idle1", "Even a warrior needs moments of stillness.")
    call RegisterBark(AI_Warrior_ProfileId, AI_BARK_IDLE, "HeroWarrior_Idle2", "Patience is the most valuable asset.")
    call RegisterBark(AI_Warrior_ProfileId, AI_BARK_MOVING, "HeroWarrior_Moving1", "Have you seen any strong shield that I could use?")
    call RegisterBark(AI_Warrior_ProfileId, AI_BARK_MOVING, "HeroWarrior_Moving2", "I am eager for battle... Let's find some worthy opponents!")
    call RegisterBark(AI_Warrior_ProfileId, AI_BARK_CASTING, "HeroWarrior_Casting1", "A warrior's body is their weapon.")
    call RegisterBark(AI_Warrior_ProfileId, AI_BARK_CASTING, "HeroWarrior_Casting2", "Strength flows from the wrists!")
    call RegisterBark(AI_Warrior_ProfileId, AI_BARK_ATTACKING, "HeroWarrior_Attack1", "The earth shakes with my fury!")
    call RegisterBark(AI_Warrior_ProfileId, AI_BARK_ATTACKING, "HeroWarrior_Attack2", "You dare challenge the might of a tauren?")
    call RegisterBark(AI_Warrior_ProfileId, AI_BARK_KILLING, "HeroWarrior_UnitDies1", "Another foe falls.")
    call RegisterBark(AI_Warrior_ProfileId, AI_BARK_KILLING, "HeroWarrior_UnitDies2", "His journey ends here.")
    call RegisterBark(AI_Warrior_ProfileId, AI_BARK_KILLING, "HeroWarrior_UnitDies3", "Let this defeat serve as a warning to others.")
    call RegisterBark(AI_Warrior_ProfileId, AI_BARK_KICKED, "HeroWarrior_Kicked1", "Hmph. A warrior walks alone, if they must.")
    call RegisterBark(AI_Warrior_ProfileId, AI_BARK_KICKED, "HeroWarrior_Kicked2", "You reject my strength? So be it.")
    call RegisterBark(AI_Warrior_ProfileId, AI_BARK_COMPANION_DIES, "HeroWarrior_CompanionDies1", "A warrior's end, as it should be.")
    call RegisterBark(AI_Warrior_ProfileId, AI_BARK_COMPANION_DIES, "HeroWarrior_CompanionDies2", "He fought with honor; we must carry on.")
    call RegisterBark(AI_Warrior_ProfileId, AI_BARK_ITEM_GIVEN, "HeroWarrior_GiveItem1", "This will aid me in the battles ahead.")
    call RegisterBark(AI_Warrior_ProfileId, AI_BARK_ITEM_GIVEN, "HeroWarrior_GiveItem2", "This will serve me well.")
    call RegisterBark(AI_Warrior_ProfileId, AI_BARK_ITEM_GIVEN, "HeroWarrior_GiveItem3", "Does it have any good stats?")
endfunction

private function RegisterHeroWarriorChat takes nothing returns nothing
    call RegisterChat(AI_Warrior_ProfileId, "HeroWarrior_ChatGeneral1", "My ancestors watch over me, and in their honor, I fight to protect my people.")
    call RegisterChat(AI_Warrior_ProfileId, "HeroWarrior_ChatGeneral2", "Every scar tells a story. Every battle, a lesson. And every victory, a new strength gained.")
    call RegisterChat(AI_Warrior_ProfileId, "HeroWarrior_ChatGeneral3", "I've seen warriors fall, but their strength lives on in the tales we tell of their courage.")
    call RegisterChat(AI_Warrior_ProfileId, "HeroWarrior_ChatGeneral4", "Strength is not found in the blade alone, but in the will to fight until the end.")
    call RegisterChat(AI_Warrior_ProfileId, "HeroWarrior_ChatGeneral5", "The battlefield does not care for your history. It only cares for the strength of your arms.")
    call RegisterChat(AI_Warrior_ProfileId, "HeroWarrior_ChatGeneral6", "Hmph. It seems that my armor is yet again, slightly broken...")
    call RegisterChat(AI_Warrior_ProfileId, "HeroWarrior_ChatRogue1", "You move like a shadow, rogue, but do you have the strength to stand in the light of battle?")
    call RegisterChat(AI_Warrior_ProfileId, "HeroWarrior_ChatRogue2", "A rogue, always lurking in the shadows. Tell me, how many pockets did you empty today? Hopefully not mine!")
    call RegisterChat(AI_Warrior_ProfileId, "HeroWarrior_ChatRogue3", "Do you call that tiny butter knife a weapon, rogue?")
    call RegisterChat(AI_Warrior_ProfileId, "HeroWarrior_ChatRogue4", "It is unethical win a battle against your opponent using poisons, but I agree with you rogue, that they are effective!")
    call RegisterChat(AI_Warrior_ProfileId, "HeroWarrior_ChatWarlock1", "The dark powers you wield are dangerous, warlock.")
    call RegisterChat(AI_Warrior_ProfileId, "HeroWarrior_ChatWarlock2", "Your power may be great, warlock, but I've seen some warriors stand strong against much worse.")
    call RegisterChat(AI_Warrior_ProfileId, "HeroWarrior_ChatWarlock3", "Are you certain, warlock, that the demons you command won't betray and murder us?")
    call RegisterChat(AI_Warrior_ProfileId, "HeroWarrior_ChatWarlock4", "Did you say something warlock? I can't make a sense out of your gibberish.")
    call RegisterChat(AI_Warrior_ProfileId, "HeroWarrior_ChatShaman1", "Ah, shaman. Are you ready to heal once more?")
    call RegisterChat(AI_Warrior_ProfileId, "HeroWarrior_ChatShaman2", "Hey shaman! Just tell me when you need to stop and regain your mana.")
    call RegisterChat(AI_Warrior_ProfileId, "HeroWarrior_ChatShaman3", "Do not worry shaman. My blade ensures that we win the battle. Well, if your healing stays constant!")
    call RegisterChat(AI_Warrior_ProfileId, "HeroWarrior_ChatShaman4", "Try to keep up with the pace shaman. If I die, we all die. Probably...")
    call RegisterChat(AI_Warrior_ProfileId, "HeroWarrior_ChatEngineer1", "Your gadgets are clever, engineer, but when the battle begins, I'll rely on strength, not bolts and gears.")
    call RegisterChat(AI_Warrior_ProfileId, "HeroWarrior_ChatEngineer2", "You build things to explode, engineer? I'll stick to smashing things the old-fashioned way.")
    call RegisterChat(AI_Warrior_ProfileId, "HeroWarrior_ChatEngineer3", "I suppose those robots and turrets are useful, but nothing beats the pure force of a tauren's charge.")
    call RegisterChat(AI_Warrior_ProfileId, "HeroWarrior_ChatEngineer4", "You've got your machines, goblin, but nothing can replace the raw power of a warrior.")
    call RegisterChat(AI_Warrior_ProfileId, "HeroWarrior_ChatPaladin1", "The light guides you, paladin, but it's the steel of your sword that wins the fight.")
    call RegisterChat(AI_Warrior_ProfileId, "HeroWarrior_ChatPaladin2", "Do you ever get tired of balancing healing and fighting, paladin?")
    call RegisterChat(AI_Warrior_ProfileId, "HeroWarrior_ChatPaladin3", "I don't mind if you heal me too, paladin.")
    call RegisterChat(AI_Warrior_ProfileId, "HeroWarrior_ChatPaladin4", "What tricks your Light can provides to us, paladin?")
endfunction

private function RegisterHeroWarriorReplies takes nothing returns nothing
    call RegisterReply("HeroWarrior_ChatGeneral1", AI_Rogue_ProfileId, "Rogue", "I don't need any ancestors watching me. Too many witnesses.")
    call RegisterReply("HeroWarrior_ChatGeneral1", AI_Warlock_ProfileId, "Warlock", "Your ancestors must be proud... or rolling their eyes.")
    call RegisterReply("HeroWarrior_ChatGeneral1", AI_Restoshaman_ProfileId, "Shaman", "Fight with their wisdom, warrior.")
    call RegisterReply("HeroWarrior_ChatGeneral1", AI_Engineer_ProfileId, "Engineer", "Ancestors watching, huh? I hope they've got safety goggles-it's about to get messy!")
    call RegisterReply("HeroWarrior_ChatGeneral1", AI_Paladin_ProfileId, "Paladin", "To protect your people is a noble cause, tauren. The Light smiles upon such act.")
    call RegisterReply("HeroWarrior_ChatGeneral2", AI_Rogue_ProfileId, "Rogue", "You wear scars like medals. I wear none, 'cause I'm smart.")
    call RegisterReply("HeroWarrior_ChatGeneral2", AI_Warlock_ProfileId, "Warlock", "And through victory you gain power.")
    call RegisterReply("HeroWarrior_ChatGeneral2", AI_Restoshaman_ProfileId, "Shaman", "The spirits respect your resilience. May the elements grant you great clarity in battles.")
    call RegisterReply("HeroWarrior_ChatGeneral2", AI_Engineer_ProfileId, "Engineer", "I've learned lessons too! Like never mix unstable fuel with... wait, what were we talking about?")
    call RegisterReply("HeroWarrior_ChatGeneral2", AI_Paladin_ProfileId, "Paladin", "Every scar is a reminder of lessons learned.")
    call RegisterReply("HeroWarrior_ChatGeneral3", AI_Rogue_ProfileId, "Rogue", "Falling warriors make great distractions. Thanks for that.")
    call RegisterReply("HeroWarrior_ChatGeneral3", AI_Warlock_ProfileId, "Warlock", "Tales of courage? They died, because they were too weak.")
    call RegisterReply("HeroWarrior_ChatGeneral3", AI_Restoshaman_ProfileId, "Shaman", "Those who fall are not forgotten. Their strength flows through us all.")
    call RegisterReply("HeroWarrior_ChatGeneral3", AI_Engineer_ProfileId, "Engineer", "I respect fallen warriors... but if they had one of my energy shields, maybe they'd still be around!")
    call RegisterReply("HeroWarrior_ChatGeneral3", AI_Paladin_ProfileId, "Paladin", "Your respect for the fallen is a testament to your strength, warrior.")
    call RegisterReply("HeroWarrior_ChatGeneral4", AI_Rogue_ProfileId, "Rogue", "I'd rather end it before the fight even starts.")
    call RegisterReply("HeroWarrior_ChatGeneral4", AI_Warlock_ProfileId, "Warlock", "Your willpower is commendable, if entirely irrelevant.")
    call RegisterReply("HeroWarrior_ChatGeneral4", AI_Restoshaman_ProfileId, "Shaman", "Wise words, warrior. Your will reflects the strength of the earth beneath your feet.")
    call RegisterReply("HeroWarrior_ChatGeneral4", AI_Engineer_ProfileId, "Engineer", "Strength isn't everything! Just wait till you see my new flamethrower... uh, prototype.")
    call RegisterReply("HeroWarrior_ChatGeneral4", AI_Paladin_ProfileId, "Paladin", "The will to fight on is your greatest weapon, tauren. Never let it dull.")
    call RegisterReply("HeroWarrior_ChatGeneral5", AI_Rogue_ProfileId, "Rogue", "Nah, the battlefield only remembers the survivors.")
    call RegisterReply("HeroWarrior_ChatGeneral5", AI_Warlock_ProfileId, "Warlock", "The battlefield cares for one thing: who's left standing...")
    call RegisterReply("HeroWarrior_ChatGeneral5", AI_Restoshaman_ProfileId, "Shaman", "Just remember who you are, even in the midst of battle.")
    call RegisterReply("HeroWarrior_ChatGeneral5", AI_Engineer_ProfileId, "Engineer", "History's boring. Let's talk about rockets instead!")
    call RegisterReply("HeroWarrior_ChatGeneral5", AI_Paladin_ProfileId, "Paladin", "In battle, it's not who you were, but who you are in the moment that matters most.")
    call RegisterReply("HeroWarrior_ChatGeneral6", AI_Rogue_ProfileId, "Rogue", "Armor slows you down. That's why I don't wear any.")
    call RegisterReply("HeroWarrior_ChatGeneral6", AI_Warlock_ProfileId, "Warlock", "Get rid of it and let me cast a demonic armor upon you.")
    call RegisterReply("HeroWarrior_ChatGeneral6", AI_Restoshaman_ProfileId, "Shaman", "Despite your broken armor, I can still heal you, though it would be easier with intact armor.")
    call RegisterReply("HeroWarrior_ChatGeneral6", AI_Engineer_ProfileId, "Engineer", "Broken armor? Hey, I've got some duct tape...")
    call RegisterReply("HeroWarrior_ChatGeneral6", AI_Paladin_ProfileId, "Paladin", "I know a good smith in the Riverbane that can fix any armor.")
    call RegisterReply("HeroWarrior_ChatRogue1", AI_Rogue_ProfileId, "Rogue", "No thanks, shadows work just fine.")
    call RegisterReply("HeroWarrior_ChatRogue2", AI_Rogue_ProfileId, "Rogue", "Relax, big guy. Your pockets aren't worth my time.")
    call RegisterReply("HeroWarrior_ChatRogue3", AI_Rogue_ProfileId, "Rogue", "Call it tiny again, and I'll show you where it fits.")
    call RegisterReply("HeroWarrior_ChatRogue4", AI_Rogue_ProfileId, "Rogue", "Ethics? Big talk from a guy swinging a massive axe.")
    call RegisterReply("HeroWarrior_ChatWarlock1", AI_Warlock_ProfileId, "Warlock", "Yes, dangerous... and so entertaining.")
    call RegisterReply("HeroWarrior_ChatWarlock2", AI_Warlock_ProfileId, "Warlock", "By saying 'some warriors' I assume you are not one of them?")
    call RegisterReply("HeroWarrior_ChatWarlock3", AI_Warlock_ProfileId, "Warlock", "Don't worry, warrior. They know who holds the leash.")
    call RegisterReply("HeroWarrior_ChatWarlock4", AI_Warlock_ProfileId, "Warlock", "Oh, I'm sorry. Did I use too many syllables for you?")
    call RegisterReply("HeroWarrior_ChatShaman1", AI_Restoshaman_ProfileId, "Shaman", "I am always ready.")
    call RegisterReply("HeroWarrior_ChatShaman2", AI_Restoshaman_ProfileId, "Shaman", "Certainly! Just don't charge somewhere while I'm replenishing my mana.")
    call RegisterReply("HeroWarrior_ChatShaman3", AI_Restoshaman_ProfileId, "Shaman", "I never said I was worried.")
    call RegisterReply("HeroWarrior_ChatShaman4", AI_Restoshaman_ProfileId, "Shaman", "Yes, but do we have to move so recklessly all the time?")
    call RegisterReply("HeroWarrior_ChatEngineer1", AI_Engineer_ProfileId, "Engineer", "Strength's fine, big guy, but bolts and gears don't get tired!")
    call RegisterReply("HeroWarrior_ChatEngineer2", AI_Engineer_ProfileId, "Engineer", "Explosions are just smashing things... at a distance!")
    call RegisterReply("HeroWarrior_ChatEngineer3", AI_Engineer_ProfileId, "Engineer", "I bet I can build a mechanical thing equipped with rocket boots that can charge as fast as a lightning strike!")
    call RegisterReply("HeroWarrior_ChatEngineer4", AI_Engineer_ProfileId, "Engineer", "Your strength is impressive, but my machines will outlast us both. If they don't explode...")
    call RegisterReply("HeroWarrior_ChatPaladin1", AI_Paladin_ProfileId, "Paladin", "Your strength and the Light together are what make us victorious, warrior.")
    call RegisterReply("HeroWarrior_ChatPaladin2", AI_Paladin_ProfileId, "Paladin", "It's a challenge, but one I accept willingly.")
    call RegisterReply("HeroWarrior_ChatPaladin3", AI_Paladin_ProfileId, "Paladin", "I'll heal you tauren, but try not to make it too often.")
    call RegisterReply("HeroWarrior_ChatPaladin4", AI_Paladin_ProfileId, "Paladin", "The Light offers everything we need to prevail.")
endfunction

private function RegisterHeroEngineerStandard takes nothing returns nothing
    call RegisterEngineerBark(AI_BARK_GREET, "HeroEngineer_Greet1", "What's crackin'? Hopefully not my gadgets!")
    call RegisterEngineerBark(AI_BARK_GREET, "HeroEngineer_Greet2", "Big ideas, small package. Let's do this!")
    call RegisterEngineerBark(AI_BARK_GREET, "HeroEngineer_Greet3", "Need something blown up or built?")
    call RegisterEngineerBark(AI_BARK_FAREWELL, "HeroEngineer_Farewell1", "Don't blow yourself up while I'm gone!")
    call RegisterEngineerBark(AI_BARK_FAREWELL, "HeroEngineer_Farewell2", "Catch ya later! Unless you step on a mine!")
    call RegisterEngineerBark(AI_BARK_FAREWELL, "HeroEngineer_Farewell3", "Back to the workshop! Smell ya later!")
    call RegisterEngineerBark(AI_BARK_PASSIVE, "HeroEngineer_Passive1", "Following the big boss! Gotcha!")
    call RegisterEngineerBark(AI_BARK_PASSIVE, "HeroEngineer_Passive2", "Fine, but don't expect me to stay quiet!")
    call RegisterEngineerBark(AI_BARK_PASSIVE, "HeroEngineer_Passive3", "I'm not built for passivity, but okay!")
    call RegisterEngineerBark(AI_BARK_NORMAL, "HeroEngineer_Normal1", "Ready to tinker and trigger!")
    call RegisterEngineerBark(AI_BARK_NORMAL, "HeroEngineer_Normal2", "Let's get creative... and destructive!")
    call RegisterEngineerBark(AI_BARK_NORMAL, "HeroEngineer_Normal3", "Gears turning, tools ready. What's next?")
    call RegisterEngineerBark(AI_BARK_AGGRESSIVE, "HeroEngineer_Aggressive1", "Time for a mechanical meltdown!")
    call RegisterEngineerBark(AI_BARK_AGGRESSIVE, "HeroEngineer_Aggressive2", "Let's turn this place into a scrapyard!")
    call RegisterEngineerBark(AI_BARK_HOLD, "HeroEngineer_HoldPositions1", "Holding steady! But not for long!")
    call RegisterEngineerBark(AI_BARK_HOLD, "HeroEngineer_HoldPositions2", "Okay, but don't expect me to sit still for too long.")
    call RegisterEngineerBark(AI_BARK_DROP_ITEMS, "HeroEngineer_DropItems1", "Here ya go! Don't break it... unless you want to!")
    call RegisterEngineerBark(AI_BARK_DROP_ITEMS, "HeroEngineer_DropItems2", "Take it before I start tinkering with it!")
    call RegisterEngineerBark(AI_BARK_IDLE, "HeroEngineer_Idle1", "I could be inventing something right now...")
    call RegisterEngineerBark(AI_BARK_IDLE, "HeroEngineer_Idle2", "You hear ticking? Eh, probably nothing.")
    call RegisterEngineerBark(AI_BARK_MOVING, "HeroEngineer_Moving1", "Where are we heading boss?")
    call RegisterEngineerBark(AI_BARK_MOVING, "HeroEngineer_Moving2", "Why haven't I invented rocket boots yet? Could come handy walking these distances...")
    call RegisterEngineerBark(AI_BARK_MOVING, "HeroEngineer_Moving3", "Can we stop by that rock? I think I saw sparkle of rare ore.")
    call RegisterEngineerBark(AI_BARK_CASTING, "HeroEngineer_Casting1", "Deploying my masterpiece!")
    call RegisterEngineerBark(AI_BARK_CASTING, "HeroEngineer_Casting2", "Behold! Goblin engineering at its finest!")
    call RegisterEngineerBark(AI_BARK_CASTING, "HeroEngineer_Casting3", "Watch this! I think it'll work!")
    call RegisterEngineerBark(AI_BARK_ATTACKING, "HeroEngineer_Attacking1", "Say hello to my little turret!")
    call RegisterEngineerBark(AI_BARK_ATTACKING, "HeroEngineer_Attacking2", "Boom! Gotcha!")
    call RegisterEngineerBark(AI_BARK_ATTACKING, "HeroEngineer_Attacking3", "Kaboom! Just how I like it!")
    call RegisterEngineerBark(AI_BARK_KILLING, "HeroEngineer_UnitDies1", "And THAT'S how you engineer a victory!")
    call RegisterEngineerBark(AI_BARK_KILLING, "HeroEngineer_UnitDies2", "Kaboom! Problem solved!")
    call RegisterEngineerBark(AI_BARK_KILLING, "HeroEngineer_UnitDies3", "Boom goes the bad guy!")
    call RegisterEngineerBark(AI_BARK_KICKED, "HeroEngineer_Kicked1", "Guess I'll go blow something up elsewhere!")
    call RegisterEngineerBark(AI_BARK_KICKED, "HeroEngineer_Kicked2", "Fine, but you'll miss my brilliance!")
    call RegisterEngineerBark(AI_BARK_COMPANION_DIES, "HeroEngineer_CompanionDies1", "Tough break! Should've had better armor!")
    call RegisterEngineerBark(AI_BARK_COMPANION_DIES, "HeroEngineer_CompanionDies2", "Aw, now I've got more work to do!")
    call RegisterEngineerBark(AI_BARK_ITEM_GIVEN, "HeroEngineer_GiveItem1", "This has potential! Or it'll blow up. Either way!")
    call RegisterEngineerBark(AI_BARK_ITEM_GIVEN, "HeroEngineer_GiveItem2", "Nice! I'll make it better... or louder!")
    call RegisterEngineerBark(AI_BARK_ITEM_GIVEN, "HeroEngineer_GiveItem3", "You're trusting me with this? Bold move!")
endfunction

private function RegisterHeroEngineerChat takes nothing returns nothing
    call RegisterEngineerChat("HeroEngineer_ChatGeneral1", "Sometimes I wonder if we're all just gears in a big cosmic machine. Then I go back to building turrets.")
    call RegisterEngineerChat("HeroEngineer_ChatGeneral2", "Nothing is impossible with enough ingenuity... or enough duct tape.")
    call RegisterEngineerChat("HeroEngineer_ChatGeneral3", "I have to check the connections after the magic smoke... what is that part that glows red?!")
    call RegisterEngineerChat("HeroEngineer_ChatGeneral4", "You call it junk; I call it 'potential.")
    call RegisterEngineerChat("HeroEngineer_ChatGeneral5", "You say 'reckless'; I say 'innovative under pressure.")
    call RegisterEngineerChat("HeroEngineer_ChatGeneral6", "I could build that better. Whatever that is.")
    call RegisterEngineerChat("HeroEngineer_ChatGeneral7", "Interesting... they actually built it like utter garbage. What is this, stone age?")
    call RegisterEngineerChat("HeroEngineer_ChatRogue1", "Hey, rogue, ever thought about using your sneaky skills for something useful? Like stealing me some spare parts?")
    call RegisterEngineerChat("HeroEngineer_ChatRogue2", "You know, rogue, if you ever need a quick getaway, I can rig up a rocket-powered escape device. Just... maybe wear a helmet.")
    call RegisterEngineerChat("HeroEngineer_ChatRogue3", "What's the point of being sneaky if you can't blow something up after you get there, rogue?")
    call RegisterEngineerChat("HeroEngineer_ChatRogue4", "You're good at slipping in and out of places, rogue... ever thought about becoming a delivery service?")
    call RegisterEngineerChat("HeroEngineer_ChatRogue5", "Hey, rogue! Ever consider sneaking some spare parts for me? Strictly professional, of course.")
    call RegisterEngineerChat("HeroEngineer_ChatWarrior1", "Warrior, do you ever wish you had something long-range, or are you happy charging into close combat every time?")
    call RegisterEngineerChat("HeroEngineer_ChatWarrior2", "Hey tauren, when you break things, does it ever occur to you how much work it takes to put them back together?")
    call RegisterEngineerChat("HeroEngineer_ChatWarrior3", "Hey Mr. Big guy, ever think about swapping that big axe for a rocket-powered hammer? Just say the word!")
    call RegisterEngineerChat("HeroEngineer_ChatWarrior4", "That armor's impressive, warrior, but what if we added spikes? Electrified ones. For... reasons.")
    call RegisterEngineerChat("HeroEngineer_ChatWarrior5", "You're big enough to carry one of my turrets, right? Mobile firepower-it's the future! They will call you as the taurenator.")
    call RegisterEngineerChat("HeroEngineer_ChatShaman1", "Shaman, your totems are impressive. Ever thought of adding wheels for mobility?")
    call RegisterEngineerChat("HeroEngineer_ChatShaman2", "Yo shaman, how do you get nature to listen to you? I can barely get my gadgets to follow basic instructions.")
    call RegisterEngineerChat("HeroEngineer_ChatShaman3", "Shaman, if you ever need elemental backup, I've got a flame turret that's practically a fire spirit.")
    call RegisterEngineerChat("HeroEngineer_ChatShaman4", "Your totems are nice and all... but have you ever considered an automatic healing dispenser? Just saying.")
    call RegisterEngineerChat("HeroEngineer_ChatWarlock1", "You've got your hellfire, I've got my flamethrower. Let's call it even, warlock.")
    call RegisterEngineerChat("HeroEngineer_ChatWarlock2", "Warlock, does summoning demons ever backfire, or do they always follow your orders? Asking for research.")
    call RegisterEngineerChat("HeroEngineer_ChatWarlock3", "Ever thought about fusing dark magic with engineering? Could be groundbreaking-or explosive. Either way, exciting!")
    call RegisterEngineerChat("HeroEngineer_ChatWarlock4", "All those flashy spells... you warlock sure you don't just need a flashlight?")
    call RegisterEngineerChat("HeroEngineer_ChatWarlock5", "Hey warlock! Ever think about using your powers to charge a battery or two? Asking for a goblin friend.")
    call RegisterEngineerChat("HeroEngineer_ChatPaladin1", "Hey, paladin, ever think of smiting evil with a rocket launcher? Works wonders, trust me.")
    call RegisterEngineerChat("HeroEngineer_ChatPaladin2", "Paladin, you've got light; I've got luminescent capacitors. Let's see which shines brighter!")
    call RegisterEngineerChat("HeroEngineer_ChatPaladin3", "Holy warrior, meet wise grease monkey. Strange combo, huh?")
    call RegisterEngineerChat("HeroEngineer_ChatPaladin4", "Hey, paladin, ever bless a wrench? Wonder what would happen...")
endfunction

private function RegisterHeroEngineerReplies takes nothing returns nothing
    call RegisterReply("HeroEngineer_ChatGeneral1", AI_Rogue_ProfileId, "Rogue", "You are thinking too much there, engineer.")
    call RegisterReply("HeroEngineer_ChatGeneral1", AI_Warlock_ProfileId, "Warlock", "If only you understood the power of the void, engineer. Your gadgets would pale in comparison.")
    call RegisterReply("HeroEngineer_ChatGeneral1", AI_Restoshaman_ProfileId, "Shaman", "I've seen the flow of the elements and I know where the true power lies...")
    call RegisterReply("HeroEngineer_ChatGeneral1", AI_Warrior_ProfileId, "Warrior", "Sounds like you've been sniffing too much engine oil...")
    call RegisterReply("HeroEngineer_ChatGeneral1", AI_Paladin_ProfileId, "Paladin", "Sounds like you're confusing divine order with... whatever you're thinking.")
    call RegisterReply("HeroEngineer_ChatGeneral2", AI_Rogue_ProfileId, "Rogue", "Ingenuity and duct tape? You goblins really do have a weird sense of priorities.")
    call RegisterReply("HeroEngineer_ChatGeneral2", AI_Warlock_ProfileId, "Warlock", "No amount of tape can fix the hole in your logic. But I'm sure your machines will survive somehow.")
    call RegisterReply("HeroEngineer_ChatGeneral2", AI_Restoshaman_ProfileId, "Shaman", "Duct tape is but a temporary solution.")
    call RegisterReply("HeroEngineer_ChatGeneral2", AI_Warrior_ProfileId, "Warrior", "Duct tape? What is that?")
    call RegisterReply("HeroEngineer_ChatGeneral2", AI_Paladin_ProfileId, "Paladin", "If your ingenuity fails, I'll be here with a hammer and a prayer.")
    call RegisterReply("HeroEngineer_ChatGeneral3", AI_Rogue_ProfileId, "Rogue", "Sounds like you've got a another deathtrap for us?!")
    call RegisterReply("HeroEngineer_ChatGeneral3", AI_Warlock_ProfileId, "Warlock", "Oh no, not again this mess!")
    call RegisterReply("HeroEngineer_ChatGeneral3", AI_Restoshaman_ProfileId, "Shaman", "What an ominious smell... are you sure it's not dangerous?")
    call RegisterReply("HeroEngineer_ChatGeneral3", AI_Warrior_ProfileId, "Warrior", "It sounds you are too late to check the connections.")
    call RegisterReply("HeroEngineer_ChatGeneral3", AI_Paladin_ProfileId, "Paladin", "You might want to get that contraption blessed before it explodes.")
    call RegisterReply("HeroEngineer_ChatGeneral4", AI_Rogue_ProfileId, "Rogue", "I see a pile of things to sell for good amount of gold.")
    call RegisterReply("HeroEngineer_ChatGeneral4", AI_Warlock_ProfileId, "Warlock", "You call that rusty bolt as 'potential'?")
    call RegisterReply("HeroEngineer_ChatGeneral4", AI_Restoshaman_ProfileId, "Shaman", "Potential is everywhere, goblin. Even in you.")
    call RegisterReply("HeroEngineer_ChatGeneral4", AI_Warrior_ProfileId, "Warrior", "Junk is junk, goblin. Stop trying to dress it up.")
    call RegisterReply("HeroEngineer_ChatGeneral4", AI_Paladin_ProfileId, "Paladin", "Some junk is meant to stay junk, my friend.")
    call RegisterReply("HeroEngineer_ChatGeneral5", AI_Rogue_ProfileId, "Rogue", "Reckless or not, at least your explosions keep the heat off me.")
    call RegisterReply("HeroEngineer_ChatGeneral5", AI_Warlock_ProfileId, "Warlock", "Your idea of innovation is cute, goblin.")
    call RegisterReply("HeroEngineer_ChatGeneral5", AI_Restoshaman_ProfileId, "Shaman", "Reckless leads to panic, panic leads to explosions, explosions... lead to a lot of paperwork and safety inspections.")
    call RegisterReply("HeroEngineer_ChatGeneral5", AI_Warrior_ProfileId, "Warrior", "Innovative? Sounds like you're just making excuses for more bad ideas.")
    call RegisterReply("HeroEngineer_ChatGeneral5", AI_Paladin_ProfileId, "Paladin", "Under pressure, I turn to the Light. What do you turn to? Duct tape?")
    call RegisterReply("HeroEngineer_ChatGeneral6", AI_Rogue_ProfileId, "Rogue", "But your version would last, what, one minute?")
    call RegisterReply("HeroEngineer_ChatGeneral6", AI_Warlock_ProfileId, "Warlock", "I'm sure your version would be... better.")
    call RegisterReply("HeroEngineer_ChatGeneral6", AI_Restoshaman_ProfileId, "Shaman", "But will it withstand the test of time?")
    call RegisterReply("HeroEngineer_ChatGeneral6", AI_Warrior_ProfileId, "Warrior", "Go ahead then, goblin. Build it better.")
    call RegisterReply("HeroEngineer_ChatGeneral6", AI_Paladin_ProfileId, "Paladin", "If you can build it better, then do it already.")
    call RegisterReply("HeroEngineer_ChatGeneral7", AI_Rogue_ProfileId, "Rogue", "Stone age or not, it's still standing.")
    call RegisterReply("HeroEngineer_ChatGeneral7", AI_Warlock_ProfileId, "Warlock", "I can't figure out what you're talking about? That old watch tower over there or...?")
    call RegisterReply("HeroEngineer_ChatGeneral7", AI_Restoshaman_ProfileId, "Shaman", "I hope you are not speaking about my hut...")
    call RegisterReply("HeroEngineer_ChatGeneral7", AI_Warrior_ProfileId, "Warrior", "Stone age or not, it's still tougher than any turret you've made.")
    call RegisterReply("HeroEngineer_ChatGeneral7", AI_Paladin_ProfileId, "Paladin", "Stone age or not, at least it was built with purpose, my friend.")
    call RegisterReply("HeroEngineer_ChatRogue1", AI_Rogue_ProfileId, "Rogue", "Stealing parts sounds fun, but what's in it for me?")
    call RegisterReply("HeroEngineer_ChatRogue2", AI_Rogue_ProfileId, "Rogue", "I'm in... but only if that helmet's stylish.")
    call RegisterReply("HeroEngineer_ChatRogue3", AI_Rogue_ProfileId, "Rogue", "You can blow things up after I've slit their throats.")
    call RegisterReply("HeroEngineer_ChatRogue4", AI_Rogue_ProfileId, "Rogue", "A delivery service? Sure, if the pay's good enough.")
    call RegisterReply("HeroEngineer_ChatRogue5", AI_Rogue_ProfileId, "Rogue", "Spare parts again? You really can't get enough, can you?")
    call RegisterReply("HeroEngineer_ChatWarrior1", AI_Warrior_ProfileId, "Warrior", "Long-range is for cowards. I prefer to look my enemies in the eye.")
    call RegisterReply("HeroEngineer_ChatWarrior2", AI_Warrior_ProfileId, "Warrior", "I break, you fix. It's the circle of life, goblin.")
    call RegisterReply("HeroEngineer_ChatWarrior3", AI_Warrior_ProfileId, "Warrior", "I'll stick to my axe, goblin.")
    call RegisterReply("HeroEngineer_ChatWarrior4", AI_Warrior_ProfileId, "Warrior", "Electrified? Sounds like overkill, even for me, but the idea of spikes is intriguing.")
    call RegisterReply("HeroEngineer_ChatWarrior5", AI_Warrior_ProfileId, "Warrior", "Now listen to me very carefully... I'm a taurenator!")
    call RegisterReply("HeroEngineer_ChatShaman1", AI_Restoshaman_ProfileId, "Shaman", "Wheels for mobility? You underestimate the power of the elements, goblin.")
    call RegisterReply("HeroEngineer_ChatShaman2", AI_Restoshaman_ProfileId, "Shaman", "I don't need to get nature to listen, goblin. Nature is always there, waiting to be called upon.")
    call RegisterReply("HeroEngineer_ChatShaman3", AI_Restoshaman_ProfileId, "Shaman", "Well that is sacrilegious.")
    call RegisterReply("HeroEngineer_ChatShaman4", AI_Restoshaman_ProfileId, "Shaman", "And how would a machine heal one's wounds?")
    call RegisterReply("HeroEngineer_ChatWarlock1", AI_Warlock_ProfileId, "Warlock", "But can your flamethrower burn souls?")
    call RegisterReply("HeroEngineer_ChatWarlock2", AI_Warlock_ProfileId, "Warlock", "Sometimes there might be a more sinister demon that won't do as I command, but that's rare.")
    call RegisterReply("HeroEngineer_ChatWarlock3", AI_Warlock_ProfileId, "Warlock", "That's a curious idea, goblin. You think your machines can handle the power?")
    call RegisterReply("HeroEngineer_ChatWarlock4", AI_Warlock_ProfileId, "Warlock", "You are amusing, goblin. I'll give you that.")
    call RegisterReply("HeroEngineer_ChatWarlock5", AI_Warlock_ProfileId, "Warlock", "What's a battery? One of your foolish projects?")
    call RegisterReply("HeroEngineer_ChatPaladin1", AI_Paladin_ProfileId, "Paladin", "While tempting, I think I'll stick with my blessed sword for now.")
    call RegisterReply("HeroEngineer_ChatPaladin2", AI_Paladin_ProfileId, "Paladin", "Let's not compare the Light to gadgets, goblin. It's no contest.")
    call RegisterReply("HeroEngineer_ChatPaladin3", AI_Paladin_ProfileId, "Paladin", "Grease monkey? Don't sell yourself short, goblin. The Light sees your worth.")
    call RegisterReply("HeroEngineer_ChatPaladin4", AI_Paladin_ProfileId, "Paladin", "A blessed wrench? If it helps defeat the evil, why not?")
endfunction

private function RegisterHeroPaladinStandard takes nothing returns nothing
    call RegisterBark(AI_Paladin_ProfileId, AI_BARK_GREET, "HeroPaladin_Greet1", "The Light guides us both, even if our paths differ.")
    call RegisterBark(AI_Paladin_ProfileId, AI_BARK_GREET, "HeroPaladin_Greet2", "A Shaman, hmm? I suppose we can work together.")
    call RegisterBark(AI_Paladin_ProfileId, AI_BARK_GREET, "HeroPaladin_Greet3", "Your presence is surprising, but welcome.")
    call RegisterBark(AI_Paladin_ProfileId, AI_BARK_FAREWELL, "HeroPaladin_Farewell1", "May the Light keep you safe on your journey.")
    call RegisterBark(AI_Paladin_ProfileId, AI_BARK_FAREWELL, "HeroPaladin_Farewell2", "Go with honor, Shaman.")
    call RegisterBark(AI_Paladin_ProfileId, AI_BARK_FAREWELL, "HeroPaladin_Farewell3", "We'll meet again, if fate wills it.")
    call RegisterBark(AI_Paladin_ProfileId, AI_BARK_PASSIVE, "HeroPaladin_Passive1", "I'll watch your back, but don't betray my trust.")
    call RegisterBark(AI_Paladin_ProfileId, AI_BARK_PASSIVE, "HeroPaladin_Passive2", "Where you lead, the Light will follow.")
    call RegisterBark(AI_Paladin_ProfileId, AI_BARK_PASSIVE, "HeroPaladin_Passive3", "Fine, I'll keep an eye on you... and your allies.")
    call RegisterBark(AI_Paladin_ProfileId, AI_BARK_NORMAL, "HeroPaladin_Normal1", "I am ready to serve, for the Light and justice.")
    call RegisterBark(AI_Paladin_ProfileId, AI_BARK_NORMAL, "HeroPaladin_Normal2", "Together, we'll purge the darkness.")
    call RegisterBark(AI_Paladin_ProfileId, AI_BARK_NORMAL, "HeroPaladin_Normal3", "A righteous path is never walked alone.")
    call RegisterBark(AI_Paladin_ProfileId, AI_BARK_AGGRESSIVE, "HeroPaladin_Aggressive1", "Let the Light judge the wicked!")
    call RegisterBark(AI_Paladin_ProfileId, AI_BARK_AGGRESSIVE, "HeroPaladin_Aggressive2", "By the Light, they will fall!")
    call RegisterBark(AI_Paladin_ProfileId, AI_BARK_AGGRESSIVE, "HeroPaladin_Aggressive3", "I'll show them the might of righteousness!")
    call RegisterBark(AI_Paladin_ProfileId, AI_BARK_HOLD, "HeroPaladin_HoldPositions1", "This ground shall not fall to evil!")
    call RegisterBark(AI_Paladin_ProfileId, AI_BARK_HOLD, "HeroPaladin_HoldPositions2", "I'll hold the line, no matter the cost.")
    call RegisterBark(AI_Paladin_ProfileId, AI_BARK_DROP_ITEMS, "HeroPaladin_DropItems1", "Take them; they serve the cause better in your hands.")
    call RegisterBark(AI_Paladin_ProfileId, AI_BARK_DROP_ITEMS, "HeroPaladin_DropItems2", "Here, may it aid you in the fight.")
    call RegisterBark(AI_Paladin_ProfileId, AI_BARK_DROP_ITEMS, "HeroPaladin_DropItems3", "Use them wisely, Shaman.")
    call RegisterBark(AI_Paladin_ProfileId, AI_BARK_IDLE, "HeroPaladin_Idle1", "Even paladins need a moment of prayer.")
    call RegisterBark(AI_Paladin_ProfileId, AI_BARK_IDLE, "HeroPaladin_Idle2", "Evil doesn't rest, but I suppose we must.")
    call RegisterBark(AI_Paladin_ProfileId, AI_BARK_MOVING, "HeroPaladin_Moving1", "The road is long, but the Light is with us.")
    call RegisterBark(AI_Paladin_ProfileId, AI_BARK_MOVING, "HeroPaladin_Moving2", "Forward, always forward.")
    call RegisterBark(AI_Paladin_ProfileId, AI_BARK_MOVING, "HeroPaladin_Moving3", "Walking with a Shaman. My mentors would be perplexed.")
    call RegisterBark(AI_Paladin_ProfileId, AI_BARK_CASTING, "HeroPaladin_Casting1", "By the Light, be cleansed!")
    call RegisterBark(AI_Paladin_ProfileId, AI_BARK_CASTING, "HeroPaladin_Casting2", "The Light purges all who stand against it!")
    call RegisterBark(AI_Paladin_ProfileId, AI_BARK_ATTACKING, "HeroPaladin_Attack1", "For the Light and for justice!")
    call RegisterBark(AI_Paladin_ProfileId, AI_BARK_ATTACKING, "HeroPaladin_Attack2", "Feel the wrath of the righteous!")
    call RegisterBark(AI_Paladin_ProfileId, AI_BARK_ATTACKING, "HeroPaladin_Attack3", "The Light's fury strikes you down!")
    call RegisterBark(AI_Paladin_ProfileId, AI_BARK_KILLING, "HeroPaladin_UnitKilled1", "Another soul judged by the Light.")
    call RegisterBark(AI_Paladin_ProfileId, AI_BARK_KILLING, "HeroPaladin_UnitKilled2", "Justice has been served.")
    call RegisterBark(AI_Paladin_ProfileId, AI_BARK_KILLING, "HeroPaladin_UnitKilled3", "The Light is victorious once again.")
    call RegisterBark(AI_Paladin_ProfileId, AI_BARK_KICKED, "HeroPaladin_Kicked1", "Perhaps we were too different after all.")
    call RegisterBark(AI_Paladin_ProfileId, AI_BARK_KICKED, "HeroPaladin_Kicked2", "You walk your path, and I'll walk mine.")
    call RegisterBark(AI_Paladin_ProfileId, AI_BARK_COMPANION_DIES, "HeroPaladin_CompanionDies1", "A tragic loss...")
    call RegisterBark(AI_Paladin_ProfileId, AI_BARK_COMPANION_DIES, "HeroPaladin_CompanionDies2", "Evil has claimed another. We must press on.")
    call RegisterBark(AI_Paladin_ProfileId, AI_BARK_ITEM_GIVEN, "HeroPaladin_GiveItem1", "This will strengthen my resolve.")
    call RegisterBark(AI_Paladin_ProfileId, AI_BARK_ITEM_GIVEN, "HeroPaladin_GiveItem2", "Thank you. I'll use it wisely.")
    call RegisterBark(AI_Paladin_ProfileId, AI_BARK_ITEM_GIVEN, "HeroPaladin_GiveItem3", "The Light provides... with your help.")
endfunction

private function RegisterHeroPaladinChat takes nothing returns nothing
    call RegisterChat(AI_Paladin_ProfileId, "HeroPaladin_ChatGeneral1", "The scars of the past wars run deep. Do we have the strength to heal them?")
    call RegisterChat(AI_Paladin_ProfileId, "HeroPaladin_ChatGeneral2", "It's strange how different we all are, yet how much we all fight for the same things.")
    call RegisterChat(AI_Paladin_ProfileId, "HeroPaladin_ChatGeneral3", "Hope is a fragile thing, but it's what keeps us standing when everything else falls.")
    call RegisterChat(AI_Paladin_ProfileId, "HeroPaladin_ChatGeneral4", "I wonder if the cycle of conflict will ever break, or if we're destined to repeat it forever.")
    call RegisterChat(AI_Paladin_ProfileId, "HeroPaladin_ChatGeneral5", "Strength without purpose is dangerous, but strength guided by principle can change the world.")
    call RegisterChat(AI_Paladin_ProfileId, "HeroPaladin_ChatGeneral6", "The Light gives me strength, but a good meal wouldn't hurt either.")
    call RegisterChat(AI_Paladin_ProfileId, "HeroPaladin_ChatGeneral7", "I've fought you orcs and dragons, but stepping on a sharp rock still brings me to my knees.")
    call RegisterChat(AI_Paladin_ProfileId, "HeroPaladin_ChatRogue1", "Rogue, I pray your blades are used for justice and not treachery... though I have my doubts.")
    call RegisterChat(AI_Paladin_ProfileId, "HeroPaladin_ChatRogue2", "Tell me, rogue, does your honor lie in the gold you steal or the lives you take?")
    call RegisterChat(AI_Paladin_ProfileId, "HeroPaladin_ChatRogue3", "Stealth may hide you from sight, rogue, but it cannot hide you from justice.")
    call RegisterChat(AI_Paladin_ProfileId, "HeroPaladin_ChatRogue4", "Your skills are impressive, rogue. I only hope they're used for more than personal gain.")
    call RegisterChat(AI_Paladin_ProfileId, "HeroPaladin_ChatRogue5", "You may walk alone rogue, but you fight with us and that counts for something.")
    call RegisterChat(AI_Paladin_ProfileId, "HeroPaladin_ChatWarrior1", "Tauren, your strength is unmatched, and your people's honor is clear. I respect that.")
    call RegisterChat(AI_Paladin_ProfileId, "HeroPaladin_ChatWarrior2", "You carry yourself with great dignity, warrior. A rare quality these days.")
    call RegisterChat(AI_Paladin_ProfileId, "HeroPaladin_ChatWarrior3", "Although we are different, tauren, your heart beats with a rhythm of honor I recognize.")
    call RegisterChat(AI_Paladin_ProfileId, "HeroPaladin_ChatWarrior4", "Stay focused, warrior. I can feel the threat approaching.")
    call RegisterChat(AI_Paladin_ProfileId, "HeroPaladin_ChatWarrior5", "Tauren, you fight with a ferocity and purpose. Remember to stay on the path of honor.")
    call RegisterChat(AI_Paladin_ProfileId, "HeroPaladin_ChatShaman1", "Shaman, your connection to the elements is... admirable, though your methods differ greatly from mine.")
    call RegisterChat(AI_Paladin_ProfileId, "HeroPaladin_ChatShaman2", "You guide your people with wisdom, shaman. Perhaps there is hope for peace after all.")
    call RegisterChat(AI_Paladin_ProfileId, "HeroPaladin_ChatShaman3", "Your totems speak to the earth itself. It's... humbling to witness.")
    call RegisterChat(AI_Paladin_ProfileId, "HeroPaladin_ChatShaman4", "Though you are orc, shaman, I sense no bloodlust in you. That is a comfort.")
    call RegisterChat(AI_Paladin_ProfileId, "HeroPaladin_ChatShaman5", "We may call upon different powers, shaman, but our goal is the same-to heal, and to protect.")
    call RegisterChat(AI_Paladin_ProfileId, "HeroPaladin_ChatEngineer1", "Engineer, your contraptions... they explode as often as they work. Is that intentional?")
    call RegisterChat(AI_Paladin_ProfileId, "HeroPaladin_ChatEngineer2", "You're quite... inventive, goblin, though I struggle to see the virtue in so much complexity.")
    call RegisterChat(AI_Paladin_ProfileId, "HeroPaladin_ChatEngineer3", "Goblin, your creations seem as likely to destroy us as our enemies. How is that reassuring?")
    call RegisterChat(AI_Paladin_ProfileId, "HeroPaladin_ChatEngineer4", "A turret for every problem and a gadget for every solution. Do you ever rely on anything else, goblin?")
    call RegisterChat(AI_Paladin_ProfileId, "HeroPaladin_ChatEngineer5", "What is that... thing, goblin? I hope it does not send us to the moon when it explodes...")
    call RegisterChat(AI_Paladin_ProfileId, "HeroPaladin_ChatWarlock1", "Warlock, your foul magic reeks of the destruction your kind wrought upon my people.")
    call RegisterChat(AI_Paladin_ProfileId, "HeroPaladin_ChatWarlock2", "Dark pacts with demons and fel fire... why are you with us?")
    call RegisterChat(AI_Paladin_ProfileId, "HeroPaladin_ChatWarlock3", "Warlock, the very air around you feels tainted. If you just let me, I could try to purify you...")
    call RegisterChat(AI_Paladin_ProfileId, "HeroPaladin_ChatWarlock4", "Whatever power you seek, warlock, it will not fill the void inside you.")
    call RegisterChat(AI_Paladin_ProfileId, "HeroPaladin_ChatWarlock5", "Your fel magic brought so much chaos to this world, warlock. Why do you have the urge to cause even more havoc?")
endfunction

private function RegisterHeroPaladinReplies takes nothing returns nothing
    call RegisterReply("HeroPaladin_ChatGeneral1", AI_Rogue_ProfileId, "Rogue", "You humans gave us plenty. Should I thank you for the souvenirs?")
    call RegisterReply("HeroPaladin_ChatGeneral1", AI_Warlock_ProfileId, "Warlock", "Your strength failed in the past, paladin. What makes you think it'll work now?")
    call RegisterReply("HeroPaladin_ChatGeneral1", AI_Restoshaman_ProfileId, "Shaman", "The scars of war may heal, but their lessons must remain.")
    call RegisterReply("HeroPaladin_ChatGeneral1", AI_Warrior_ProfileId, "Warrior", "Scars are like trophies. Why would we want to get rid of them?")
    call RegisterReply("HeroPaladin_ChatGeneral1", AI_Engineer_ProfileId, "Engineer", "Eh, I just patch 'em with duct tape and move on!")
    call RegisterReply("HeroPaladin_ChatGeneral2", AI_Rogue_ProfileId, "Rogue", "Strange? No, what's strange is you thinking we have anything in common.")
    call RegisterReply("HeroPaladin_ChatGeneral2", AI_Warlock_ProfileId, "Warlock", "Fight for the same things? Don't flatter yourself, paladin.")
    call RegisterReply("HeroPaladin_ChatGeneral2", AI_Restoshaman_ProfileId, "Shaman", "Strange, yes. But perhaps our similarities can forge a path forward.")
    call RegisterReply("HeroPaladin_ChatGeneral2", AI_Warrior_ProfileId, "Warrior", "We all want the same things-big meals and bigger fights. Right?")
    call RegisterReply("HeroPaladin_ChatGeneral2", AI_Engineer_ProfileId, "Engineer", "Fight for the same things? Speak for yourself, I'm in it for the gold.")
    call RegisterReply("HeroPaladin_ChatGeneral3", AI_Rogue_ProfileId, "Rogue", "Keep your hope, paladin. I'll take survival over sentiment.")
    call RegisterReply("HeroPaladin_ChatGeneral3", AI_Warlock_ProfileId, "Warlock", "Fragile is the right word, paladin. It shatters so beautifully under the rain of fire.")
    call RegisterReply("HeroPaladin_ChatGeneral3", AI_Restoshaman_ProfileId, "Shaman", "Hope is fragile, but even the smallest ember can ignite a great flame.")
    call RegisterReply("HeroPaladin_ChatGeneral3", AI_Warrior_ProfileId, "Warrior", "I don't get this 'hope' thing, but I do get smashing stuff. Works for me.")
    call RegisterReply("HeroPaladin_ChatGeneral3", AI_Engineer_ProfileId, "Engineer", "Hope's nice, but have you seen what I can build with enough spare parts?")
    call RegisterReply("HeroPaladin_ChatGeneral4", AI_Rogue_ProfileId, "Rogue", "Conflict's just another word for life, paladin. Embrace it.")
    call RegisterReply("HeroPaladin_ChatGeneral4", AI_Warlock_ProfileId, "Warlock", "Chaos and destruction. It is in all of our veins. One just has to learn how to embrace them.")
    call RegisterReply("HeroPaladin_ChatGeneral4", AI_Restoshaman_ProfileId, "Shaman", "Conflict tend to repeat because we cling to old hatreds.")
    call RegisterReply("HeroPaladin_ChatGeneral4", AI_Warrior_ProfileId, "Warrior", "Nah, we just like to smash things. Keeps life simple.")
    call RegisterReply("HeroPaladin_ChatGeneral4", AI_Engineer_ProfileId, "Engineer", "Sounds like a problem that could use a self-destruct button.")
    call RegisterReply("HeroPaladin_ChatGeneral5", AI_Rogue_ProfileId, "Rogue", "Purpose slows you down. Strength works best when it's unleashed.")
    call RegisterReply("HeroPaladin_ChatGeneral5", AI_Warlock_ProfileId, "Warlock", "My strength is guided by chaos, and it's far more effective than your pathetic 'principles'.")
    call RegisterReply("HeroPaladin_ChatGeneral5", AI_Restoshaman_ProfileId, "Shaman", "Without purpose, strength is as aimless as a storm with no wind.")
    call RegisterReply("HeroPaladin_ChatGeneral5", AI_Warrior_ProfileId, "Warrior", "Purpose, principles... sounds like excuses not to fight.")
    call RegisterReply("HeroPaladin_ChatGeneral5", AI_Engineer_ProfileId, "Engineer", "Principle's great and all, but have you tried guided missile system A2000?")
    call RegisterReply("HeroPaladin_ChatGeneral6", AI_Rogue_ProfileId, "Rogue", "A good meal? Sounds like you're more orc than you think, paladin.")
    call RegisterReply("HeroPaladin_ChatGeneral6", AI_Warlock_ProfileId, "Warlock", "That's the most human thing I've heard in a long time.")
    call RegisterReply("HeroPaladin_ChatGeneral6", AI_Restoshaman_ProfileId, "Shaman", "Let us share a meal when the time is right.")
    call RegisterReply("HeroPaladin_ChatGeneral6", AI_Warrior_ProfileId, "Warrior", "Strength and a meal? Now you're talking my language!")
    call RegisterReply("HeroPaladin_ChatGeneral7", AI_Rogue_ProfileId, "Rogue", "So rocks are your true enemy, paladin? I'll keep that in mind.")
    call RegisterReply("HeroPaladin_ChatGeneral7", AI_Warlock_ProfileId, "Warlock", "The mighty paladin brought down by a pebble? I couldn't write a better joke.")
    call RegisterReply("HeroPaladin_ChatGeneral7", AI_Restoshaman_ProfileId, "Shaman", "Even the mightiest warriors can fall to the smallest of obstacles.")
    call RegisterReply("HeroPaladin_ChatGeneral7", AI_Warrior_ProfileId, "Warrior", "If a rock stops you, maybe you need stronger boots.")
    call RegisterReply("HeroPaladin_ChatRogue1", AI_Rogue_ProfileId, "Rogue", "Pray all you want, paladin.")
    call RegisterReply("HeroPaladin_ChatRogue2", AI_Rogue_ProfileId, "Rogue", "The lives I take are usually human. Coincidence? Maybe not.")
    call RegisterReply("HeroPaladin_ChatRogue3", AI_Rogue_ProfileId, "Rogue", "What is this 'justice' you are talking about all the time?")
    call RegisterReply("HeroPaladin_ChatRogue4", AI_Rogue_ProfileId, "Rogue", "Personal gain, paladin? Your kind wrote a book on that.")
    call RegisterReply("HeroPaladin_ChatRogue5", AI_Rogue_ProfileId, "Rogue", "Your kind's never earned my trust, paladin. But I'll fight with you-for now.")
    call RegisterReply("HeroPaladin_ChatWarrior1", AI_Warrior_ProfileId, "Warrior", "Thank you Mr. Paladin!")
    call RegisterReply("HeroPaladin_ChatWarrior2", AI_Warrior_ProfileId, "Warrior", "A rare quality? Sounds fancy. Do I win something for that?")
    call RegisterReply("HeroPaladin_ChatWarrior3", AI_Warrior_ProfileId, "Warrior", "My heart beats for fighting. Honor's just a bonus.")
    call RegisterReply("HeroPaladin_ChatWarrior4", AI_Warrior_ProfileId, "Warrior", "Threat approaching? Good, I was getting bored.")
    call RegisterReply("HeroPaladin_ChatWarrior5", AI_Warrior_ProfileId, "Warrior", "A tauren is always honorable.")
    call RegisterReply("HeroPaladin_ChatShaman1", AI_Restoshaman_ProfileId, "Shaman", "Our methods differ, paladin, but the elements do not judge, only guide.")
    call RegisterReply("HeroPaladin_ChatShaman2", AI_Restoshaman_ProfileId, "Shaman", "Perhaps together, we may find the path to peace one day.")
    call RegisterReply("HeroPaladin_ChatShaman3", AI_Restoshaman_ProfileId, "Shaman", "The totems are but tools. They channel the strength of the elemental earth.")
    call RegisterReply("HeroPaladin_ChatShaman4", AI_Restoshaman_ProfileId, "Shaman", "You sense correctly, paladin. Bloodlust is a shadow I no longer follow.")
    call RegisterReply("HeroPaladin_ChatShaman5", AI_Restoshaman_ProfileId, "Shaman", "Healing and protection are noble goals, no matter the power that fuels them.")
    call RegisterReply("HeroPaladin_ChatEngineer1", AI_Engineer_ProfileId, "Engineer", "Yep, totally intentional! It's called 'dynamic problem-solving'!")
    call RegisterReply("HeroPaladin_ChatEngineer2", AI_Engineer_ProfileId, "Engineer", "Complexity is where the fun is, paladin. Don't be boring!")
    call RegisterReply("HeroPaladin_ChatEngineer3", AI_Engineer_ProfileId, "Engineer", "Destroy us? Nah, I've calculated that we got at least a 60% success rate this time!")
    call RegisterReply("HeroPaladin_ChatEngineer4", AI_Engineer_ProfileId, "Engineer", "Hey, gadgets never let me down! Well... not often, anyway.")
    call RegisterReply("HeroPaladin_ChatEngineer5", AI_Engineer_ProfileId, "Engineer", "Relax, paladin. I've done the math... mostly.")
    call RegisterReply("HeroPaladin_ChatWarlock1", AI_Warlock_ProfileId, "Warlock", "My magic reeks of destruction? Good. That means it's working.")
    call RegisterReply("HeroPaladin_ChatWarlock2", AI_Warlock_ProfileId, "Warlock", "I'm here because I enjoy the irony of standing beside you.")
    call RegisterReply("HeroPaladin_ChatWarlock3", AI_Warlock_ProfileId, "Warlock", "Go ahead, paladin. Try to purify me. I haven't had a shower in months.")
    call RegisterReply("HeroPaladin_ChatWarlock4", AI_Warlock_ProfileId, "Warlock", "Not if I will achieve unlimited power!")
    call RegisterReply("HeroPaladin_ChatWarlock5", AI_Warlock_ProfileId, "Warlock", "Chaos is creation, paladin. This universe was forged by flames!")
endfunction

private function Init takes nothing returns nothing
    call RegisterHeroRogueStandard()
    call RegisterHeroRogueChat()
    call RegisterHeroRogueReplies()
    call RegisterHeroWarlockStandard()
    call RegisterHeroWarlockChat()
    call RegisterHeroWarlockReplies()
    call RegisterHeroUndeadWarlockStandard()
    call RegisterHeroUndeadWarlockChat()
    call RegisterHeroUndeadWarlockReplies()
    call RegisterHeroShamanStandard()
    call RegisterHeroShamanChat()
    call RegisterHeroShamanReplies()
    call RegisterHeroWarriorStandard()
    call RegisterHeroWarriorChat()
    call RegisterHeroWarriorReplies()
    call RegisterHeroEngineerStandard()
    call RegisterHeroEngineerChat()
    call RegisterHeroEngineerReplies()
    call RegisterHeroPaladinStandard()
    call RegisterHeroPaladinChat()
    call RegisterHeroPaladinReplies()
endfunction

endlibrary
