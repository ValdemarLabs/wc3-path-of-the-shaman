    call RegisterBark(AI_Rogue_ProfileId, AI_BARK_NORMAL, VL_ROGUE_HEROROGUE_NORMAL1_KEY, VL_ROGUE_HEROROGUE_NORMAL1_TEXT)
    call RegisterBark(AI_Rogue_ProfileId, AI_BARK_NORMAL, VL_ROGUE_HEROROGUE_NORMAL2_KEY, VL_ROGUE_HEROROGUE_NORMAL2_TEXT)
    call RegisterBark(AI_Rogue_ProfileId, AI_BARK_AGGRESSIVE, VL_ROGUE_HEROROGUE_AGGRESSIVE1_KEY, VL_ROGUE_HEROROGUE_AGGRESSIVE1_TEXT)
