/**
    AI_Voicelines

    Author: Valdemar
    Version:

    Description:
    ODS-backed AI bark and companion chat text data. This library registers
    the long idle/moving conversation tables and updates standard bark/reply
    text for the first-wave AI profiles.

    Credits:
    - AI/Voicelines/AI_Voicelines.ods

    How to install:
    Import after `AI_CompanionReplies.j`.

    API:
    Automatic initializer only.

**/
library AIVoicelines initializer Init requires AI, AIWarrior, AIRogue, AIWarlock, AIRestoshaman, AIPaladin, AIEngineer, AICompanionReplies, VoicelinesRogue, VoicelinesWarlock, VoicelinesUndeadWarlock, VoicelinesRestoShaman, VoicelinesWarrior, VoicelinesEngineer, VoicelinesPaladin

private function RegisterBark takes integer profileId, integer barkType, string soundKey, string text returns nothing
    call AI_RegisterBarkLine(profileId, barkType, text, soundKey)
endfunction

private function RegisterEngineerBark takes integer barkType, string soundKey, string text returns nothing
    call RegisterBark(AI_Engineer_ProfileId, barkType, soundKey, text)
    call RegisterBark(AI_Engineer_ShredderProfileId, barkType, soundKey, text)
endfunction

private function RegisterChat takes integer profileId, string soundKey, string text returns nothing
    // Long companion conversations can be selected from either idle or moving chatter.
    call RegisterBark(profileId, AI_BARK_IDLE, soundKey, text)
    call RegisterBark(profileId, AI_BARK_MOVING, soundKey, text)
endfunction

private function RegisterEngineerChat takes string soundKey, string text returns nothing
    call RegisterChat(AI_Engineer_ProfileId, soundKey, text)
    call RegisterChat(AI_Engineer_ShredderProfileId, soundKey, text)
endfunction

private function RegisterReply takes string primarySoundKey, integer responderProfileId, string responderName, string text returns nothing
    call AI_RegisterBarkReply(primarySoundKey, responderProfileId, text, primarySoundKey + responderName)
endfunction

private function RegisterHeroRogueStandard takes nothing returns nothing
    call RegisterBark(AI_Rogue_ProfileId, AI_BARK_GREET, VL_ROGUE_HEROROGUE_GREET1_KEY, VL_ROGUE_HEROROGUE_GREET1_TEXT)
    call RegisterBark(AI_Rogue_ProfileId, AI_BARK_GREET, VL_ROGUE_HEROROGUE_GREET2_KEY, VL_ROGUE_HEROROGUE_GREET2_TEXT)
