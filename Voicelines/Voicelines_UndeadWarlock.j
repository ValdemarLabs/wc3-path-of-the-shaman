    // Companion chat lines.
    constant string VL_UNDEADWARLOCK_HEROUNDEADWARLOCK_CHATGENERAL1_KEY = "HeroUndeadWarlock_ChatGeneral1"
    constant string VL_UNDEADWARLOCK_HEROUNDEADWARLOCK_CHATGENERAL1_TEXT = "I used to fear the silence after death. Now I use it to think."
