/**
    VoicelinesUndeadWarlock

    Author: Valdemar
    Version:

    Description:
    Undead Warlock AI bark, companion chat, and companion reply voiceline
    keys/text used by AI profile libraries.

    Credits:
    - AI/AI_Voicelines.j

    How to install:
    Import after `Voicelines.j`. Consumers require this library directly.

    API:
    Global `VL_UNDEADWARLOCK_*` constants.

**/
library VoicelinesUndeadWarlock requires Voicelines

globals
    // Standard bark lines.
    constant string VL_UNDEADWARLOCK_HEROUNDEADWARLOCK_GREET1_KEY = "HeroUndeadWarlock_Greet1"
    constant string VL_UNDEADWARLOCK_HEROUNDEADWARLOCK_GREET1_TEXT = "The grave is quiet. Your summons are not."
    constant string VL_UNDEADWARLOCK_HEROUNDEADWARLOCK_GREET2_KEY = "HeroUndeadWarlock_Greet2"
    constant string VL_UNDEADWARLOCK_HEROUNDEADWARLOCK_GREET2_TEXT = "Speak quickly. The dead do not waste breath."
    constant string VL_UNDEADWARLOCK_HEROUNDEADWARLOCK_GREET3_KEY = "HeroUndeadWarlock_Greet3"
    constant string VL_UNDEADWARLOCK_HEROUNDEADWARLOCK_GREET3_TEXT = "I hear you, shaman. Even through the cold."
    constant string VL_UNDEADWARLOCK_HEROUNDEADWARLOCK_GREET4_KEY = "HeroUndeadWarlock_Greet4"
    constant string VL_UNDEADWARLOCK_HEROUNDEADWARLOCK_GREET4_TEXT = "Another path through shadow? Good."
