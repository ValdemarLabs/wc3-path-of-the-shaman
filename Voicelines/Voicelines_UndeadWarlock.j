    constant string VL_UNDEADWARLOCK_HEROUNDEADWARLOCK_KICKED1_TEXT = "So be it. I have been abandoned before."
    constant string VL_UNDEADWARLOCK_HEROUNDEADWARLOCK_KICKED2_KEY = "HeroUndeadWarlock_Kicked2"
    constant string VL_UNDEADWARLOCK_HEROUNDEADWARLOCK_KICKED2_TEXT = "The dead walk alone often enough."
    constant string VL_UNDEADWARLOCK_HEROUNDEADWARLOCK_OTHERDIES1_KEY = "HeroUndeadWarlock_OtherDies1"
    constant string VL_UNDEADWARLOCK_HEROUNDEADWARLOCK_OTHERDIES1_TEXT = "Another flame extinguished."
    constant string VL_UNDEADWARLOCK_HEROUNDEADWARLOCK_OTHERDIES2_KEY = "HeroUndeadWarlock_OtherDies2"
    constant string VL_UNDEADWARLOCK_HEROUNDEADWARLOCK_OTHERDIES2_TEXT = "Their struggle is over."
    constant string VL_UNDEADWARLOCK_HEROUNDEADWARLOCK_OTHERDIES3_KEY = "HeroUndeadWarlock_OtherDies3"
    constant string VL_UNDEADWARLOCK_HEROUNDEADWARLOCK_OTHERDIES3_TEXT = "The living always fall eventually."
    constant string VL_UNDEADWARLOCK_HEROUNDEADWARLOCK_ITEMGIVEN1_KEY = "HeroUndeadWarlock_ItemGiven1"
    constant string VL_UNDEADWARLOCK_HEROUNDEADWARLOCK_ITEMGIVEN1_TEXT = "A practical offering."
    constant string VL_UNDEADWARLOCK_HEROUNDEADWARLOCK_ITEMGIVEN2_KEY = "HeroUndeadWarlock_ItemGiven2"
