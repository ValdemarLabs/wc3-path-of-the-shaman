    constant string VL_UNDEADWARLOCK_HEROUNDEADWARLOCK_IDLE1_TEXT = "The living fidget. The dead endure."
    constant string VL_UNDEADWARLOCK_HEROUNDEADWARLOCK_IDLE2_KEY = "HeroUndeadWarlock_Idle2"
    constant string VL_UNDEADWARLOCK_HEROUNDEADWARLOCK_IDLE2_TEXT = "Even silence has a voice, if you listen."
