    constant string VL_UNDEADWARLOCK_HEROUNDEADWARLOCK_DROPITEMS1_TEXT = "Take these. I have carried heavier burdens."
    constant string VL_UNDEADWARLOCK_HEROUNDEADWARLOCK_DROPITEMS2_KEY = "HeroUndeadWarlock_DropItems2"
    constant string VL_UNDEADWARLOCK_HEROUNDEADWARLOCK_DROPITEMS2_TEXT = "I have no attachment to such things."
    constant string VL_UNDEADWARLOCK_HEROUNDEADWARLOCK_DROPITEMS3_KEY = "HeroUndeadWarlock_DropItems3"
    constant string VL_UNDEADWARLOCK_HEROUNDEADWARLOCK_DROPITEMS3_TEXT = "Use them before they rot."
