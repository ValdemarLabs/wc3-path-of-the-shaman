    constant string VL_UNDEADWARLOCK_HEROUNDEADWARLOCK_CHATENGINEER3_TEXT = "Your devices clatter like bones in a sack."
    constant string VL_UNDEADWARLOCK_HEROUNDEADWARLOCK_CHATENGINEER4_KEY = "HeroUndeadWarlock_ChatEngineer4"
    constant string VL_UNDEADWARLOCK_HEROUNDEADWARLOCK_CHATENGINEER4_TEXT = "Build me something that does not fear death. Then I will be impressed."
    constant string VL_UNDEADWARLOCK_HEROUNDEADWARLOCK_CHATPALADIN1_KEY = "HeroUndeadWarlock_ChatPaladin1"
    constant string VL_UNDEADWARLOCK_HEROUNDEADWARLOCK_CHATPALADIN1_TEXT = "Paladin, do not glare. I am already dead."
