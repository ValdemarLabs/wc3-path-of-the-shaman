    constant string VL_UNDEADWARLOCK_HEROUNDEADWARLOCK_IDLE3_TEXT = "I remember breathing. I do not miss it."
    constant string VL_UNDEADWARLOCK_HEROUNDEADWARLOCK_MOVING1_KEY = "HeroUndeadWarlock_Moving1"
    constant string VL_UNDEADWARLOCK_HEROUNDEADWARLOCK_MOVING1_TEXT = "Step lightly. The dead notice careless feet."
    constant string VL_UNDEADWARLOCK_HEROUNDEADWARLOCK_MOVING2_KEY = "HeroUndeadWarlock_Moving2"
