    constant string VL_UNDEADWARLOCK_HEROUNDEADWARLOCK_CASTING1_TEXT = "Cold hands, darker power."
    constant string VL_UNDEADWARLOCK_HEROUNDEADWARLOCK_CASTING2_KEY = "HeroUndeadWarlock_Casting2"
    constant string VL_UNDEADWARLOCK_HEROUNDEADWARLOCK_CASTING2_TEXT = "Rise, shadow. Take shape."
    constant string VL_UNDEADWARLOCK_HEROUNDEADWARLOCK_CASTING3_KEY = "HeroUndeadWarlock_Casting3"
    constant string VL_UNDEADWARLOCK_HEROUNDEADWARLOCK_CASTING3_TEXT = "Their souls are already loosening."
