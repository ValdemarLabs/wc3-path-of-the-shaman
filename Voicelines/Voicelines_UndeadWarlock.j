    constant string VL_UNDEADWARLOCK_HEROUNDEADWARLOCK_CHATPALADIN4_TEXT = "You speak of purity as if battle leaves anyone clean."
    constant string VL_UNDEADWARLOCK_HEROUNDEADWARLOCK_CHATPALADIN5_KEY = "HeroUndeadWarlock_ChatPaladin5"
    constant string VL_UNDEADWARLOCK_HEROUNDEADWARLOCK_CHATPALADIN5_TEXT = "Keep your holy fire pointed away from me."

