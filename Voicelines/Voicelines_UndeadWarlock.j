    constant string VL_UNDEADWARLOCK_HEROUNDEADWARLOCK_CHATGENERAL2_TEXT = "Rot teaches patience. Power teaches how little patience matters."
    constant string VL_UNDEADWARLOCK_HEROUNDEADWARLOCK_CHATGENERAL3_KEY = "HeroUndeadWarlock_ChatGeneral3"
    constant string VL_UNDEADWARLOCK_HEROUNDEADWARLOCK_CHATGENERAL3_TEXT = "The living call it corruption. The dead call it an opportunity."
    constant string VL_UNDEADWARLOCK_HEROUNDEADWARLOCK_CHATGENERAL4_KEY = "HeroUndeadWarlock_ChatGeneral4"
    constant string VL_UNDEADWARLOCK_HEROUNDEADWARLOCK_CHATGENERAL4_TEXT = "Every graveyard is a library, if you know how to listen."
    constant string VL_UNDEADWARLOCK_HEROUNDEADWARLOCK_CHATGENERAL5_KEY = "HeroUndeadWarlock_ChatGeneral5"
    constant string VL_UNDEADWARLOCK_HEROUNDEADWARLOCK_CHATGENERAL5_TEXT = "I do not hate the living. I simply find them temporary."
    constant string VL_UNDEADWARLOCK_HEROUNDEADWARLOCK_CHATGENERAL6_KEY = "HeroUndeadWarlock_ChatGeneral6"
    constant string VL_UNDEADWARLOCK_HEROUNDEADWARLOCK_CHATGENERAL6_TEXT = "Demons bargain loudly. The dead bargain honestly."
    constant string VL_UNDEADWARLOCK_HEROUNDEADWARLOCK_CHATGENERAL7_KEY = "HeroUndeadWarlock_ChatGeneral7"
    constant string VL_UNDEADWARLOCK_HEROUNDEADWARLOCK_CHATGENERAL7_TEXT = "Some souls cling to the body. Mine learned to wander."
    constant string VL_UNDEADWARLOCK_HEROUNDEADWARLOCK_CHATROGUE1_KEY = "HeroUndeadWarlock_ChatRogue1"
    constant string VL_UNDEADWARLOCK_HEROUNDEADWARLOCK_CHATROGUE1_TEXT = "Rogue, your shadow is loud. You should practice with actual darkness."
    constant string VL_UNDEADWARLOCK_HEROUNDEADWARLOCK_CHATROGUE2_KEY = "HeroUndeadWarlock_ChatRogue2"
    constant string VL_UNDEADWARLOCK_HEROUNDEADWARLOCK_CHATROGUE2_TEXT = "I admire thieves. They understand that ownership is temporary."
    constant string VL_UNDEADWARLOCK_HEROUNDEADWARLOCK_CHATROGUE3_KEY = "HeroUndeadWarlock_ChatRogue3"
    constant string VL_UNDEADWARLOCK_HEROUNDEADWARLOCK_CHATROGUE3_TEXT = "Careful where you step, rogue. Some buried things still bite."
    constant string VL_UNDEADWARLOCK_HEROUNDEADWARLOCK_CHATROGUE4_KEY = "HeroUndeadWarlock_ChatRogue4"
    constant string VL_UNDEADWARLOCK_HEROUNDEADWARLOCK_CHATROGUE4_TEXT = "If you steal from a corpse, make sure it is finished objecting."
    constant string VL_UNDEADWARLOCK_HEROUNDEADWARLOCK_CHATWARRIOR1_KEY = "HeroUndeadWarlock_ChatWarrior1"
    constant string VL_UNDEADWARLOCK_HEROUNDEADWARLOCK_CHATWARRIOR1_TEXT = "Warrior, strength fades. Hunger does not."
    constant string VL_UNDEADWARLOCK_HEROUNDEADWARLOCK_CHATWARRIOR2_KEY = "HeroUndeadWarlock_ChatWarrior2"
    constant string VL_UNDEADWARLOCK_HEROUNDEADWARLOCK_CHATWARRIOR2_TEXT = "You charge as if death is an opponent you can knock down."
    constant string VL_UNDEADWARLOCK_HEROUNDEADWARLOCK_CHATWARRIOR3_KEY = "HeroUndeadWarlock_ChatWarrior3"
    constant string VL_UNDEADWARLOCK_HEROUNDEADWARLOCK_CHATWARRIOR3_TEXT = "Your heart beats like a war drum. Mine used to."
    constant string VL_UNDEADWARLOCK_HEROUNDEADWARLOCK_CHATWARRIOR4_KEY = "HeroUndeadWarlock_ChatWarrior4"
    constant string VL_UNDEADWARLOCK_HEROUNDEADWARLOCK_CHATWARRIOR4_TEXT = "Stand near me in battle. I prefer enemies distracted by living targets."
