    constant string VL_UNDEADWARLOCK_HEROUNDEADWARLOCK_KILLING1_TEXT = "One more voice for the dark."
    constant string VL_UNDEADWARLOCK_HEROUNDEADWARLOCK_KILLING2_KEY = "HeroUndeadWarlock_Killing2"
