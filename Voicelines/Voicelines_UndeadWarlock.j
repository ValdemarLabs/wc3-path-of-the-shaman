    constant string VL_UNDEADWARLOCK_HEROUNDEADWARLOCK_CHATSHAMAN1_TEXT = "Shaman, your spirits whisper. Mine complain."
    constant string VL_UNDEADWARLOCK_HEROUNDEADWARLOCK_CHATSHAMAN2_KEY = "HeroUndeadWarlock_ChatShaman2"
    constant string VL_UNDEADWARLOCK_HEROUNDEADWARLOCK_CHATSHAMAN2_TEXT = "The elements remember life. Necromancy remembers what follows."
    constant string VL_UNDEADWARLOCK_HEROUNDEADWARLOCK_CHATSHAMAN3_KEY = "HeroUndeadWarlock_ChatShaman3"
    constant string VL_UNDEADWARLOCK_HEROUNDEADWARLOCK_CHATSHAMAN3_TEXT = "Your healing feels strange on dead flesh, but I will not refuse it."
    constant string VL_UNDEADWARLOCK_HEROUNDEADWARLOCK_CHATSHAMAN4_KEY = "HeroUndeadWarlock_ChatShaman4"
    constant string VL_UNDEADWARLOCK_HEROUNDEADWARLOCK_CHATSHAMAN4_TEXT = "Tell your ancestors I am not ready to answer them."
