    constant string VL_AVELINE_REPLY_HEROROGUE_CHATWARLOCK5_AVELINE_TEXT = "If something reeks, check the road for bodies first."
    constant string VL_AVELINE_REPLY_HEROROGUE_CHATSHAMAN1_AVELINE_KEY = "HeroRogue_ChatShaman1Aveline"
    constant string VL_AVELINE_REPLY_HEROROGUE_CHATSHAMAN1_AVELINE_PRIMARY = "HeroRogue_ChatShaman1"
