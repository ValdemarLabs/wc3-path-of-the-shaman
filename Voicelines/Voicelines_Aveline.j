    constant string VL_AVELINE_REPLY_HEROROGUE_CHATWARLOCK3_AVELINE_PRIMARY = "HeroRogue_ChatWarlock3"
    constant string VL_AVELINE_REPLY_HEROROGUE_CHATWARLOCK3_AVELINE_RESPONDER = "Aveline"
