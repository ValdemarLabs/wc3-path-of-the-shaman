    constant string VL_AVELINE_REPLY_HEROROGUE_CHATENGINEER1_AVELINE_TEXT = "If it blows up near villagers, it becomes my problem too."
    constant string VL_AVELINE_REPLY_HEROROGUE_CHATENGINEER2_AVELINE_KEY = "HeroRogue_ChatEngineer2Aveline"
    constant string VL_AVELINE_REPLY_HEROROGUE_CHATENGINEER2_AVELINE_PRIMARY = "HeroRogue_ChatEngineer2"
