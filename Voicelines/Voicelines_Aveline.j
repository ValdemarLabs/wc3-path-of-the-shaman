    constant string VL_AVELINE_REPLY_HEROROGUE_CHATWARLOCK1_AVELINE_KEY = "HeroRogue_ChatWarlock1Aveline"
    constant string VL_AVELINE_REPLY_HEROROGUE_CHATWARLOCK1_AVELINE_PRIMARY = "HeroRogue_ChatWarlock1"
    constant string VL_AVELINE_REPLY_HEROROGUE_CHATWARLOCK1_AVELINE_RESPONDER = "Aveline"
    constant string VL_AVELINE_REPLY_HEROROGUE_CHATWARLOCK1_AVELINE_TEXT = "If they talk back, listen for the moment they turn on us."
