    constant string VL_AVELINE_REPLY_HEROROGUE_CHATSHAMAN2_AVELINE_PRIMARY = "HeroRogue_ChatShaman2"
    constant string VL_AVELINE_REPLY_HEROROGUE_CHATSHAMAN2_AVELINE_RESPONDER = "Aveline"
    constant string VL_AVELINE_REPLY_HEROROGUE_CHATSHAMAN2_AVELINE_TEXT = "Totems or blades, use what keeps people alive."
