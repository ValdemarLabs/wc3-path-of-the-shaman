/**
    VoicelinesAveline

    Author: Valdemar
    Version:

    Description:
    Aveline AI bark, companion chat, and companion reply voiceline
    keys/text used by AI profile libraries.

    Credits:
    - AI/Specific/AI_Aveline.j

    How to install:
    Import after `Voicelines.j`. Consumers require this library directly.

    API:
    Global `VL_AVELINE_*` constants.

**/
library VoicelinesAveline requires Voicelines

globals
    // Standard bark lines.
    constant string VL_AVELINE_AVELINE_GREET1_KEY = "Aveline_Greet1"
    constant string VL_AVELINE_AVELINE_GREET1_TEXT = "Aveline of Riverbane. Keep your blade ready."
    constant string VL_AVELINE_AVELINE_GREET2_KEY = "Aveline_Greet2"
    constant string VL_AVELINE_AVELINE_GREET2_TEXT = "If you stand against raiders, you stand with me."
    constant string VL_AVELINE_AVELINE_GREET3_KEY = "Aveline_Greet3"
    constant string VL_AVELINE_AVELINE_GREET3_TEXT = "Riverbane needs steady hands. Are yours ready?"
    constant string VL_AVELINE_AVELINE_GREET4_KEY = "Aveline_Greet4"
    constant string VL_AVELINE_AVELINE_GREET4_TEXT = "I have watched this road long enough to know trouble by its tracks."
    constant string VL_AVELINE_AVELINE_FAREWELL1_KEY = "Aveline_Farewell1"
    constant string VL_AVELINE_AVELINE_FAREWELL1_TEXT = "Riverbane roads are never quiet for long."
    constant string VL_AVELINE_AVELINE_FAREWELL2_KEY = "Aveline_Farewell2"
    constant string VL_AVELINE_AVELINE_FAREWELL2_TEXT = "If Riverbane calls, I answer."
    constant string VL_AVELINE_AVELINE_FAREWELL3_KEY = "Aveline_Farewell3"
    constant string VL_AVELINE_AVELINE_FAREWELL3_TEXT = "Keep clear of the river roads after dusk."
    constant string VL_AVELINE_AVELINE_PASSIVE1_KEY = "Aveline_Passive1"
    constant string VL_AVELINE_AVELINE_PASSIVE1_TEXT = "I will watch the road and spare my strength."
    constant string VL_AVELINE_AVELINE_PASSIVE2_KEY = "Aveline_Passive2"
    constant string VL_AVELINE_AVELINE_PASSIVE2_TEXT = "I will stay close and save my strength."
    constant string VL_AVELINE_AVELINE_PASSIVE3_KEY = "Aveline_Passive3"
    constant string VL_AVELINE_AVELINE_PASSIVE3_TEXT = "No needless bloodshed."
    constant string VL_AVELINE_AVELINE_NORMAL1_KEY = "Aveline_Normal1"
    constant string VL_AVELINE_AVELINE_NORMAL1_TEXT = "Steady pace. Eyes open."
    constant string VL_AVELINE_AVELINE_NORMAL2_KEY = "Aveline_Normal2"
    constant string VL_AVELINE_AVELINE_NORMAL2_TEXT = "We move with purpose, not haste."
    constant string VL_AVELINE_AVELINE_NORMAL3_KEY = "Aveline_Normal3"
    constant string VL_AVELINE_AVELINE_NORMAL3_TEXT = "Keep your line tight and your eyes open."
    constant string VL_AVELINE_AVELINE_AGGRESSIVE1_KEY = "Aveline_Aggressive1"
    constant string VL_AVELINE_AVELINE_AGGRESSIVE1_TEXT = "No mercy for bandits and raiders!"
    constant string VL_AVELINE_AVELINE_AGGRESSIVE2_KEY = "Aveline_Aggressive2"
    constant string VL_AVELINE_AVELINE_AGGRESSIVE2_TEXT = "Drive them back before they reach the villages!"
    constant string VL_AVELINE_AVELINE_AGGRESSIVE3_KEY = "Aveline_Aggressive3"
    constant string VL_AVELINE_AVELINE_AGGRESSIVE3_TEXT = "Break their charge!"
    constant string VL_AVELINE_AVELINE_HOLDPOSITIONS1_KEY = "Aveline_HoldPositions1"
    constant string VL_AVELINE_AVELINE_HOLDPOSITIONS1_TEXT = "I will hold this line."
    constant string VL_AVELINE_AVELINE_HOLDPOSITIONS2_KEY = "Aveline_HoldPositions2"
    constant string VL_AVELINE_AVELINE_HOLDPOSITIONS2_TEXT = "No one gets past me."
    constant string VL_AVELINE_AVELINE_HOLDPOSITIONS3_KEY = "Aveline_HoldPositions3"
    constant string VL_AVELINE_AVELINE_HOLDPOSITIONS3_TEXT = "This ground is under Riverbane steel."
    constant string VL_AVELINE_AVELINE_DROPITEMS1_KEY = "Aveline_DropItems1"
    constant string VL_AVELINE_AVELINE_DROPITEMS1_TEXT = "Take what you need."
    constant string VL_AVELINE_AVELINE_DROPITEMS2_KEY = "Aveline_DropItems2"
    constant string VL_AVELINE_AVELINE_DROPITEMS2_TEXT = "Better in your pack than weighing down my sword arm."
    constant string VL_AVELINE_AVELINE_DROPITEMS3_KEY = "Aveline_DropItems3"
    constant string VL_AVELINE_AVELINE_DROPITEMS3_TEXT = "Here. Use it before the raiders do."
    constant string VL_AVELINE_AVELINE_IDLE1_KEY = "Aveline_Idle1"
    constant string VL_AVELINE_AVELINE_IDLE1_TEXT = "Riverbane still has people worth defending."
    constant string VL_AVELINE_AVELINE_IDLE2_KEY = "Aveline_Idle2"
    constant string VL_AVELINE_AVELINE_IDLE2_TEXT = "Bandits follow coin. Orc raiders follow smoke. Either way, people will suffer."
    constant string VL_AVELINE_AVELINE_IDLE3_KEY = "Aveline_Idle3"
    constant string VL_AVELINE_AVELINE_IDLE3_TEXT = "Every quiet road in Riverbane was bought by someone keeping watch."
    constant string VL_AVELINE_AVELINE_IDLE4_KEY = "Aveline_Idle4"
    constant string VL_AVELINE_AVELINE_IDLE4_TEXT = "The magical calm of the Twilight Grove never ceases to amaze me."
    constant string VL_AVELINE_AVELINE_MOVING1_KEY = "Aveline_Moving1"
    constant string VL_AVELINE_AVELINE_MOVING1_TEXT = "I am checking the road ahead."
    constant string VL_AVELINE_AVELINE_MOVING2_KEY = "Aveline_Moving2"
    constant string VL_AVELINE_AVELINE_MOVING2_TEXT = "Be on your guard."
    constant string VL_AVELINE_AVELINE_MOVING3_KEY = "Aveline_Moving3"
    constant string VL_AVELINE_AVELINE_MOVING3_TEXT = "Tracks are fresh. Stay ready."
    constant string VL_AVELINE_AVELINE_MOVING4_KEY = "Aveline_Moving4"
    constant string VL_AVELINE_AVELINE_MOVING4_TEXT = "I know this road. It knows me too well."
    constant string VL_AVELINE_AVELINE_CASTING1_KEY = "Aveline_Casting1"
    constant string VL_AVELINE_AVELINE_CASTING1_TEXT = "Now!"
    constant string VL_AVELINE_AVELINE_CASTING2_KEY = "Aveline_Casting2"
    constant string VL_AVELINE_AVELINE_CASTING2_TEXT = "Steel and courage!"
    constant string VL_AVELINE_AVELINE_CASTING3_KEY = "Aveline_Casting3"
    constant string VL_AVELINE_AVELINE_CASTING3_TEXT = "Stand firm!"
    constant string VL_AVELINE_AVELINE_ATTACK1_KEY = "Aveline_Attack1"
    constant string VL_AVELINE_AVELINE_ATTACK1_TEXT = "Face me coward!"
    constant string VL_AVELINE_AVELINE_ATTACK2_KEY = "Aveline_Attack2"
    constant string VL_AVELINE_AVELINE_ATTACK2_TEXT = "For Riverbane!"
    constant string VL_AVELINE_AVELINE_ATTACK3_KEY = "Aveline_Attack3"
    constant string VL_AVELINE_AVELINE_ATTACK3_TEXT = "I'll cut you down!"
    constant string VL_AVELINE_AVELINE_UNITDIES1_KEY = "Aveline_UnitDies1"
    constant string VL_AVELINE_AVELINE_UNITDIES1_TEXT = "One less threat to Riverbane."
    constant string VL_AVELINE_AVELINE_UNITDIES2_KEY = "Aveline_UnitDies2"
    constant string VL_AVELINE_AVELINE_UNITDIES2_TEXT = "That threat ends here."
    constant string VL_AVELINE_AVELINE_UNITDIES3_KEY = "Aveline_UnitDies3"
    constant string VL_AVELINE_AVELINE_UNITDIES3_TEXT = "And down you go!"
    constant string VL_AVELINE_AVELINE_KICKED1_KEY = "Aveline_Kicked1"
    constant string VL_AVELINE_AVELINE_KICKED1_TEXT = "Then I return to my own patrol."
    constant string VL_AVELINE_AVELINE_KICKED2_KEY = "Aveline_Kicked2"
    constant string VL_AVELINE_AVELINE_KICKED2_TEXT = "Then I go where Riverbane needs me."
    constant string VL_AVELINE_AVELINE_KICKED3_KEY = "Aveline_Kicked3"
    constant string VL_AVELINE_AVELINE_KICKED3_TEXT = "I must go then."
    constant string VL_AVELINE_AVELINE_COMPANIONDIES1_KEY = "Aveline_CompanionDies1"
    constant string VL_AVELINE_AVELINE_COMPANIONDIES1_TEXT = "Hold the line. We still have work to do."
    constant string VL_AVELINE_AVELINE_COMPANIONDIES2_KEY = "Aveline_CompanionDies2"
    constant string VL_AVELINE_AVELINE_COMPANIONDIES2_TEXT = "Fall back together or not at all!"
    constant string VL_AVELINE_AVELINE_COMPANIONDIES3_KEY = "Aveline_CompanionDies3"
    constant string VL_AVELINE_AVELINE_COMPANIONDIES3_TEXT = "They paid for our mistake. Make it count."
    constant string VL_AVELINE_AVELINE_GIVEITEM1_KEY = "Aveline_GiveItem1"
    constant string VL_AVELINE_AVELINE_GIVEITEM1_TEXT = "Useful. I will put it to work."
    constant string VL_AVELINE_AVELINE_GIVEITEM2_KEY = "Aveline_GiveItem2"
    constant string VL_AVELINE_AVELINE_GIVEITEM2_TEXT = "I will carry it until it saves a life."
    constant string VL_AVELINE_AVELINE_GIVEITEM3_KEY = "Aveline_GiveItem3"
    constant string VL_AVELINE_AVELINE_GIVEITEM3_TEXT = "What is that?"

    // Companion chat lines.
    constant string VL_AVELINE_AVELINE_CHATGENERAL1_KEY = "Aveline_ChatGeneral1"
    constant string VL_AVELINE_AVELINE_CHATGENERAL1_TEXT = "Riverbane taught me that a road is safe only because someone keeps watch."
    constant string VL_AVELINE_AVELINE_CHATGENERAL2_KEY = "Aveline_ChatGeneral2"
    constant string VL_AVELINE_AVELINE_CHATGENERAL2_TEXT = "Bandits want coin, raiders want fear, and villagers just want tomorrow."
    constant string VL_AVELINE_AVELINE_CHATGENERAL3_KEY = "Aveline_ChatGeneral3"
    constant string VL_AVELINE_AVELINE_CHATGENERAL3_TEXT = "I do not hate every orc I meet. I hate the ones who come with murderous intent..."
    constant string VL_AVELINE_AVELINE_CHATGENERAL4_KEY = "Aveline_ChatGeneral4"
    constant string VL_AVELINE_AVELINE_CHATGENERAL4_TEXT = "This place is quiet enough to hear trouble coming."
    constant string VL_AVELINE_AVELINE_CHATGENERAL5_KEY = "Aveline_ChatGeneral5"
    constant string VL_AVELINE_AVELINE_CHATGENERAL5_TEXT = "My people do not need a conqueror. They need another dawn."
    constant string VL_AVELINE_AVELINE_CHATGENERAL6_KEY = "Aveline_ChatGeneral6"
    constant string VL_AVELINE_AVELINE_CHATGENERAL6_TEXT = "Sooner or later, we shall have revenge."
    constant string VL_AVELINE_AVELINE_CHATENGINEER1_KEY = "Aveline_ChatEngineer1"
    constant string VL_AVELINE_AVELINE_CHATENGINEER1_TEXT = "Engineer, if you build anything for Riverbane, make sure it lasts longer than one fight."
    constant string VL_AVELINE_AVELINE_CHATENGINEER2_KEY = "Aveline_ChatEngineer2"
    constant string VL_AVELINE_AVELINE_CHATENGINEER2_TEXT = "A quiet warning bell would help more than another smoking contraption."
    constant string VL_AVELINE_AVELINE_CHATENGINEER3_KEY = "Aveline_ChatEngineer3"
    constant string VL_AVELINE_AVELINE_CHATENGINEER3_TEXT = "Build me something that warns Riverbane before the first spear is thrown."
    constant string VL_AVELINE_AVELINE_CHATPALADIN1_KEY = "Aveline_ChatPaladin1"
    constant string VL_AVELINE_AVELINE_CHATPALADIN1_TEXT = "Paladin, your Light is welcome on the roads."
    constant string VL_AVELINE_AVELINE_CHATPALADIN2_KEY = "Aveline_ChatPaladin2"
    constant string VL_AVELINE_AVELINE_CHATPALADIN2_TEXT = "When fear spreads through Riverbane, a bright banner can steady more than soldiers."
    constant string VL_AVELINE_AVELINE_CHATPALADIN3_KEY = "Aveline_ChatPaladin3"
    constant string VL_AVELINE_AVELINE_CHATPALADIN3_TEXT = "Pray if you must, paladin, but keep your sword ready when the smoke rises."
    constant string VL_AVELINE_AVELINE_CHATROGUE1_KEY = "Aveline_ChatRogue1"
    constant string VL_AVELINE_AVELINE_CHATROGUE1_TEXT = "Rogue, if your hands wander near Riverbane purses, I will notice."
    constant string VL_AVELINE_AVELINE_CHATROGUE2_KEY = "Aveline_ChatRogue2"
    constant string VL_AVELINE_AVELINE_CHATROGUE2_TEXT = "A scout who moves quietly is useful. But your're still a thief."
    constant string VL_AVELINE_AVELINE_CHATROGUE3_KEY = "Aveline_ChatRogue3"
    constant string VL_AVELINE_AVELINE_CHATROGUE3_TEXT = "If you know how bandits think, use it to stop them before they choose a victim."
    constant string VL_AVELINE_AVELINE_CHATSHAMAN1_KEY = "Aveline_ChatShaman1"
    constant string VL_AVELINE_AVELINE_CHATSHAMAN1_TEXT = "Shaman, if the spirits know why raiders keep crossing our river, I would love to hear it."
    constant string VL_AVELINE_AVELINE_CHATSHAMAN2_KEY = "Aveline_ChatShaman2"
    constant string VL_AVELINE_AVELINE_CHATSHAMAN2_TEXT = "Tell the wind to carry warning before it carries smoke."
    constant string VL_AVELINE_AVELINE_CHATSHAMAN3_KEY = "Aveline_ChatShaman3"
    constant string VL_AVELINE_AVELINE_CHATSHAMAN3_TEXT = "Your healing is welcome, but I would rather prevent the wounds in the first place."
    constant string VL_AVELINE_AVELINE_CHATWARLOCK1_KEY = "Aveline_ChatWarlock1"
    constant string VL_AVELINE_AVELINE_CHATWARLOCK1_TEXT = "Warlock, whatever power you carry, keep it pointed at our enemies."
    constant string VL_AVELINE_AVELINE_CHATWARLOCK2_KEY = "Aveline_ChatWarlock2"
    constant string VL_AVELINE_AVELINE_CHATWARLOCK2_TEXT = "I have seen enough villages burn. Do not make me wonder if you enjoy the sight."
    constant string VL_AVELINE_AVELINE_CHATWARLOCK3_KEY = "Aveline_ChatWarlock3"
    constant string VL_AVELINE_AVELINE_CHATWARLOCK3_TEXT = "If your demons turn hungry, I expect you to stand between them and my people."
    constant string VL_AVELINE_AVELINE_CHATUNDEADWARLOCK1_KEY = "Aveline_ChatUndeadWarlock1"
    constant string VL_AVELINE_AVELINE_CHATUNDEADWARLOCK1_TEXT = "Undead or not, you still choose where your shadow falls."
    constant string VL_AVELINE_AVELINE_CHATUNDEADWARLOCK2_KEY = "Aveline_ChatUndeadWarlock2"
    constant string VL_AVELINE_AVELINE_CHATUNDEADWARLOCK2_TEXT = "It is disturbing to have a walking corpse among us."
    constant string VL_AVELINE_AVELINE_CHATUNDEADWARLOCK3_KEY = "Aveline_ChatUndeadWarlock3"
    constant string VL_AVELINE_AVELINE_CHATUNDEADWARLOCK3_TEXT = "If death taught you patience, use it to guard those who still have time."
    constant string VL_AVELINE_AVELINE_CHATWARRIOR1_KEY = "Aveline_ChatWarrior1"
    constant string VL_AVELINE_AVELINE_CHATWARRIOR1_TEXT = "Warrior, strength is useful. Discipline keeps it from becoming another danger."
    constant string VL_AVELINE_AVELINE_CHATWARRIOR2_KEY = "Aveline_ChatWarrior2"
    constant string VL_AVELINE_AVELINE_CHATWARRIOR2_TEXT = "Hold the road with me and the raiders will think twice before crossing."
    constant string VL_AVELINE_AVELINE_CHATWARRIOR3_KEY = "Aveline_ChatWarrior3"
    constant string VL_AVELINE_AVELINE_CHATWARRIOR3_TEXT = "A strong charge breaks enemies and a steady shield saves families."

