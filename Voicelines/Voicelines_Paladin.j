    constant string VL_PALADIN_HEROPALADIN_CHATGENERAL3_TEXT = "Hope is a fragile thing, but it's what keeps us standing when everything else falls."
    constant string VL_PALADIN_HEROPALADIN_CHATGENERAL4_KEY = "HeroPaladin_ChatGeneral4"
