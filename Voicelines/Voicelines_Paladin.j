    constant string VL_PALADIN_HEROPALADIN_CHATROGUE5_KEY = "HeroPaladin_ChatRogue5"
    constant string VL_PALADIN_HEROPALADIN_CHATROGUE5_TEXT = "You may walk alone rogue, but you fight with us and that counts for something."
