    constant string VL_PALADIN_HEROPALADIN_CHATWARRIOR2_TEXT = "You carry yourself with great dignity, warrior. A rare quality these days."
    constant string VL_PALADIN_HEROPALADIN_CHATWARRIOR3_KEY = "HeroPaladin_ChatWarrior3"
