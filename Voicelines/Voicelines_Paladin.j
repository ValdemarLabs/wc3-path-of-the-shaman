    // Companion chat lines.
    constant string VL_PALADIN_HEROPALADIN_CHATGENERAL1_KEY = "HeroPaladin_ChatGeneral1"
    constant string VL_PALADIN_HEROPALADIN_CHATGENERAL1_TEXT = "The scars of the past wars run deep. Do we have the strength to heal them?"
