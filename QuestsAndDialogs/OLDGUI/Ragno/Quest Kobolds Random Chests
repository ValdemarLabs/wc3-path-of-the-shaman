                        Set VariableSet KoboldChest[1] = (Last created destructible)
                        Custom script:   call RemoveLocation(udg_VarPoint)
                        Set VariableSet Chance_ChestLocations = 0
                        Set VariableSet KoboldChests = (KoboldChests + 1)
